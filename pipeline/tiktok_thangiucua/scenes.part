// ================= cảnh: THẦN GIỮ CỦA =================
const S={};let ctaFlag=false,BLACK=0,TITLE=false,RED=0,RAIN=0,FLASH=0,NOW=0;
const JUMPS=[['hook2',0.04,0.45,1],['gm',0.62,0.4,1],['boy',0.45,0.42,1],['pry',0.6,0.38,1]];
const SOFT=[];
// khẩu hình: chỉ mở khi chính câu thoại của nhân vật đó đang phát (TLD.vox) -> hết câu là ngậm miệng
const TK=sp=>{for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a&&NOW<b)return Math.sin(NOW*14)>-0.2?'o':undefined}return undefined};
const flick=T=>0.85+0.15*Math.sin(T*11)*Math.sin(T*3.7);
const nightIn=(lamp=0.5)=>{night();lampL.intensity=lamp;moonSpot.intensity=4};

const KX=FX0+0.2,KZ=FZ0+0.3,GY=0.18;// hố trên nền nhà cũ
const HOLECAP=new THREE.Mesh(new THREE.CircleGeometry(0.66,24),M({color:0x3e3020,roughness:1}));HOLECAP.rotation.x=-Math.PI/2;HOLECAP.position.set(KX,GY+0.006,KZ);ext.add(HOLECAP);
const jarAt=(J,x,y,z,o={})=>{J.visible=true;J.position.set(x,y,z);J.userData.lid.visible=!o.open;J.userData.gold.visible=!!o.open;J.userData.gl.intensity=o.glow||0};
const nightE=()=>{extMode('night');eFill.intensity=0};
const lanhDig=(T,o={})=>Object.assign({hoe:-0.2+0.5*Math.sin(T*3),armA:[undefined,-2.5+0.9*Math.max(0,Math.sin(T*3))],eyes:1,T},o);
// ---- mở đầu ----
S.hook=(lt,D,T)=>{CUR='ext';extMode('night');const p=sm(lt/D);jarAt(JAR_E,KX,GY-0.22,KZ,{glow:0.6});foundL.intensity=0.8*flick(T);foundL.position.set(KX,0.4,KZ+0.3);
 cm([lerp(KX+3.2,KX+1.2,p),lerp(2.6,1.15,p),lerp(KZ+5.5,KZ+2.0,p)],[KX+0.1,0.25,KZ],lerp(46,38,p));return 'ext'};
S.hook2=(lt,D,T)=>{CUR='ext';extMode('night');jarAt(JAR_E,KX+0.5,GY-0.1,KZ+0.2,{glow:0.8});foundL.intensity=1.6*flick(T);foundL.position.set(KX+0.2,0.7,KZ+0.9);
 if(lt<D*0.6){const up=sm(seg(lt,0,0.35));put(C.gb,KX-0.1,KZ,{a:0.97,look:0.3},lerp(-1.3,-0.48,up));cm([KX+0.15,0.62,KZ+1.45],[KX-0.1,0.38,KZ],38);RED=0.1*(1-sm(lt/(D*0.6)));return 'ext'}
 const q=sm(seg(lt,D*0.6,D));cm([KX+0.5+0.15,0.7,KZ+0.2+lerp(1.0,0.75,q)],[KX+0.5,0.42,KZ+0.2],38);return 'ext'};
S.title=(lt,D,T)=>{CUR='ext';extMode('night');TITLE=true;jarAt(JAR_E,KX+0.5,GY-0.1,KZ+0.2,{glow:1.0});foundL.intensity=1.2;foundL.position.set(KX+0.5,0.9,KZ+1.0);cm([KX+0.6,lerp(1.1,0.95,sm(lt/D)),KZ+1.6],[KX+0.5,0.5,KZ+0.2],46);return 'ext'};
// ---- đào trúng hũ (ban ngày) ----
S.dig=(lt,D,T,ls)=>{CUR='ext';extMode('day');const p=sm(lt/D);const hit=lt>D*0.72;HOLECAP.visible=false;
 put(C.lanh,KX+0.75,KZ+0.55,hit?{hoe:0.5,armA:[undefined,-0.8],eyes:1.25,pupil:2.2,T}:lanhDig(T),GY);put(C.man,KX-1.4,KZ+1.3,{eyes:0.95,look:1,T},GY);
 if(hit){jarAt(JAR_E,KX,GY-0.32,KZ);cm([KX+0.5,1.3,KZ+1.8],[KX,0.1,KZ],40)}else cm([lerp(KX+3.5,KX+2.6,p),1.9,lerp(KZ+5.5,KZ+4.6,p)],[KX+0.2,0.9,KZ+0.4],44);return 'ext'};
S.dig2=(lt,D,T)=>{CUR='ext';extMode('day');HOLECAP.visible=false;const o=lt>D*0.35;jarAt(JAR_E,KX+0.85,GY,KZ+0.25,{open:o,glow:o?1.2:0});
 const q=sm(lt/D);cm([KX+0.85+0.2,lerp(1.1,0.95,q),KZ+0.25+lerp(0.85,0.55,q)],[KX+0.85,GY+0.42,KZ+0.25],38);return 'ext'};
S.man1=(lt,D,T)=>{CUR='ext';extMode('day');HOLECAP.visible=false;jarAt(JAR_E,KX+0.85,GY,KZ+0.25,{open:true});put(C.man,KX-1.0,KZ+1.1,{eyes:1.1,look:1,mouth:TK('MA'),T},GY);close(C.man,lerp(1.4,1.2,sm(lt/D)),36,-0.3);return 'ext'};
S.lanh1=(lt,D,T)=>{CUR='ext';extMode('day');HOLECAP.visible=false;jarAt(JAR_E,KX+0.85,GY,KZ+0.25,{open:true});put(C.lanh,KX+0.6,KZ+0.9,{jar:true,eyes:1.05,smileF:true,look:-1,mouth:TK('LA'),T},GY);close(C.lanh,lerp(1.5,1.25,sm(lt/D)),36,0.3);return 'ext'};
// ---- giấu hũ, bán bông tai ----
S.hide=(lt,D,T)=>{if(lt<D*0.5){CUR='inn';day();dayL.intensity=0.6;JAR_I.visible=true;JAR_I.position.set(lerp(-1.0,-1.6,sm(seg(lt,0,D*0.4))),0.02,-1.0);put(C.lanh,-0.6,-0.6,{sit:true,armA:[undefined,-1.0],look:-1,eyes:1,T},-0.45);cm([0.6,0.9,1.2],[-1.3,0.35,-1.0],42);return 'inn'}
 CUR='mkt';const p=sm(seg(lt,D*0.5,D));put(C.lanh,-7.3,-7.6,{look:1,eyes:0.85,T});put(C.k4,-6.4,-7.9,{look:-1});cm([lerp(-5.6,-6.2,p),1.6,-4.4],[-7.0,1.4,-8],42);return 'mkt'};
// ---- bé Na và "anh Hai" ----
const bedNight=(l=0.6)=>{night();lampL.intensity=l;moonSpot.intensity=4};
S.na1=(lt,D,T)=>{CUR='inn';bedNight(0.7);put(C.na,-0.95,-0.6,{sit:true,look:-1,eyes:1,mouth:Math.sin(T*9)>0.2&&Math.sin(T*0.9)>0?'o':undefined,T},-0.12);put(C.man,-0.05,0.15,{eyes:1.05,look:-1,T});cm([lerp(0.5,0.3,sm(lt/D)),1.15,3.0],[-0.45,0.72,-0.3],50);return 'inn'};
S.na2=(lt,D,T)=>{CUR='inn';bedNight(0.7);put(C.na,-0.95,-0.6,{sit:true,look:1,eyes:1,bell:lt>D*0.6,smileF:true,mouth:TK('NA'),T},-0.12);const c=C.na;cm([c.position.x+0.25,0.85,c.position.z+1.2],[c.position.x,0.62,c.position.z],36);return 'inn'};
S.bell=(lt,D,T)=>{CUR='inn';bedNight(0.6);if(lt<D*0.45){put(C.na,-0.95,-0.6,{sit:true,bell:true,bellShake:1.5,eyes:1,look:1,T},-0.12);const c=C.na;cm([c.position.x+0.3,0.55,c.position.z+0.85],[c.position.x+0.22,0.36,c.position.z],36);return 'inn'}
 put(C.man,0.5,0.1,{eyes:1.35,pupil:2,look:-1,T});close(C.man,lerp(1.3,1.0,sm(seg(lt,D*0.45,D))),36,-0.25);return 'inn'};
S.odd=(lt,D,T)=>{CUR='inn';bedNight(0.35);if(lt<D*0.45){cm([-0.5,0.35,0.5],[-1.6,0.2,-1.0],44);JAR_I.visible=true;JAR_I.userData.gl.intensity=1.4*flick(T);return 'inn'}
 day();dayL.intensity=0.5;HANDS.forEach(h=>h.visible=true);const q=sm(seg(lt,D*0.45,D));cm([1.5,lerp(2.75,2.6,q),lerp(-1.3,-1.6,q)],[1.45,2.23,-2.32],40);return 'inn'};
S.sick=(lt,D,T)=>{CUR='inn';bedNight(0.25);moonSpot.intensity=6;if(lt<D*0.5){put(C.na,-0.95,-0.6,{sit:true,sick:true,eyes:0.35,T},-0.12);fillL.color.set(0x8aa0c0);fillL.intensity=0.9;fillL.position.set(-0.4,1.0,0.3);const c=C.na;cm([c.position.x+0.25,0.85,c.position.z+1.2],[c.position.x,0.62,c.position.z],36);return 'inn'}
 put(C.na,-1.05,-0.75,{sick:true,dirt:true,eyes:1.2,look:-1,crawl:true,T},-0.45);fillL.color.set(0x8aa0c0);fillL.intensity=0.8;fillL.position.set(-0.6,0.8,0.2);const c=C.na;cm([c.position.x+0.5,0.6,c.position.z+1.1],[c.position.x,0.5,c.position.z],38);return 'inn'};
// ---- thầy Tư ----
const AMX=-4.2,AMZ=-3;
S.tu=(lt,D,T)=>{CUR='mtn';mtnMode('night');amL.intensity=2.2*flick(T);const p=sm(lt/D);const z=lerp(3,0.6,p);putM(C.man,pathX(z),z,{eyes:1.05,tears:true,walk:T*7,carry:true,carrySick:true,T});C.man.position.y+=0.1;cm([2.4,H(2,4)+1.7,5.4],[pathX(z)-0.6,H(0,z)+1.0,z-1],44);return 'mtn'};
const tuClose=(lt,D,T,o,dist,side)=>{CUR='mtn';mtnMode('night');amL.intensity=2.6*flick(T);const y=AM.position.y;put(C.tu,AMX-0.3,AMZ+0.4,Object.assign({mouth:TK('TU'),eyes:0.9,T},o),y+0.15);close(C.tu,dist,36,side);return 'mtn'};
S.tu1=(lt,D,T)=>tuClose(lt,D,T,{},lerp(1.6,1.3,sm(lt/D)),0.3);
S.tu2=(lt,D,T)=>tuClose(lt,D,T,{eyes:1.25,pupil:2},lerp(1.25,0.95,sm(lt/D)),-0.2);
S.tu3=(lt,D,T)=>{if(lt<D*0.55)return tuClose(lt,D,T,{armA:[undefined,-2.4]},1.4,0.35);return tuClose(lt,D,T,{eyes:1.2,look:1},lerp(1.2,1.0,sm(seg(lt,D*0.55,D))),-0.3)};
// ---- bông tai ----
S.miss=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.5;put(C.man,0.4,-0.6,{eyes:1.4,pupil:2,T});put(C.lanh,1.3,-1.3,{eyes:0.7,look:-1,T});if(lt<D*0.5)close(C.man,1.2,36,-0.3);else cm([0.9,1.5,1.6],[0.9,1.15,-1.0],42);return 'inn'};
S.earring=(lt,D,T)=>{CUR='inn';bedNight(0.9);if(lt<D*0.55){put(C.man,0.4,-0.6,{ears:true,earring:true,tears:true,eyes:0.8,T});close(C.man,1.15,36,-0.2);return 'inn'}
 JAR_I.visible=true;JAR_I.position.set(0.0,0.02,0.1);JAR_I.userData.lid.visible=false;JAR_I.userData.gold.visible=true;JAR_I.userData.gl.intensity=1.0;cm([0.15,0.85,0.75],[0.0,0.3,0.1],38);return 'inn'};
// ---- nửa đêm ra nền nhà cũ ----
S.night=(lt,D,T)=>{CUR='ext';nightE();HOLECAP.visible=false;const p=sm(lt/D);const x=lerp(KX+4.5,KX+1.0,p),z=lerp(KZ+3.5,KZ+0.9,p);put(C.lanh,x,z,{jar:true,eyes:1.1,phase:T*6,T});put(C.man,x+1.0,z+0.6,{eyes:1.1,walk:T*6,carry:true,carrySick:true,T});foundL.intensity=0.5;foundL.position.set(KX,0.5,KZ);
 cm([KX+5.2,1.7,KZ+7.2],[lerp(KX+3,KX+0.6,p),0.55,KZ+1.2],46);return 'ext'};
const atHole=(T,o={})=>{HOLECAP.visible=false;jarAt(JAR_E,KX+0.75,GY,KZ+0.15,{});put(C.lanh,KX+0.95,KZ+0.75,Object.assign({eyes:1.15,T},o.L||{}),GY);put(C.man,KX-0.85,KZ+0.95,Object.assign({eyes:1.15,T},o.M||{}),GY);put(C.na,KX-0.5,KZ+1.2,Object.assign({sick:true,eyes:0.8,T},o.N||{}),GY);foundL.intensity=(o.glow??0.6)*flick(T);foundL.position.set(KX,0.2,KZ)};
S.call=(lt,D,T)=>{CUR='ext';nightE();atHole(T,{L:{look:-1,eyes:1.3}});if(lt<D*0.5)cm([KX+2.4,1.9,KZ+3.0],[KX,0.6,KZ+0.6],44);else cm([KX+0.35,1.5,KZ+0.9],[KX,-0.7,KZ],40);return 'ext'};
S.gm=(lt,D,T)=>{CUR='ext';nightE();atHole(T,{glow:1.2});if(lt>D*0.62){const up=sm(seg(lt,D*0.62,D*0.72));put(C.gb,KX,KZ,{a:0.97,look:0.2,mouth:'o'},lerp(-1.2,-0.4,up));cm([KX+0.12,0.6,KZ+1.4],[KX,0.38,KZ],38);return 'ext'}cm([KX+0.3,lerp(1.6,1.35,sm(lt/D)),KZ+0.75],[KX,-0.9,KZ],lerp(42,36,sm(lt/D)));return 'ext'};
S.nayes=(lt,D,T)=>{CUR='ext';nightE();const cov=lt>D*0.5;atHole(T,{M:{cover:cov,eyes:1.3,pupil:2},N:{covered:cov,mouth:!cov&&lt>D*0.2?'o':undefined,eyes:1.1,look:1}});const c=C.na;cm([c.position.x+0.2,0.95,c.position.z+1.5],[c.position.x-0.15,0.75,c.position.z],38);return 'ext'};
S.bell2=(lt,D,T)=>{CUR='ext';nightE();const st=lt>D*0.4;atHole(T,{L:st?{hoe:0.5,armA:[undefined,-0.8],eyes:1.3}:lanhDig(T),N:{clutch:st,eyes:0.9}});HOLECAP.visible=true;HOLECAP.scale.setScalar(0.5);
 if(!st)cm([KX+2.6,1.8,KZ+3.0],[KX+0.4,0.7,KZ+0.6],44);else{const c=C.na;cm([c.position.x+0.1,0.75,c.position.z+1.1],[c.position.x,0.5,c.position.z],36)}return 'ext'};
S.boy=(lt,D,T)=>{CUR='ext';nightE();atHole(T,{glow:1.4});HOLECAP.visible=false;const up=sm(seg(lt,D*0.3,D*0.6));put(C.gb,KX,KZ,{a:0.97,reach:lt>D*0.6,look:0.4,tilt:lerp(0.3,0,up)},-0.6+0.3*up);
 const q=sm(lt/D);cm([KX+0.35,lerp(1.5,1.0,q),KZ+lerp(1.1,1.3,q)],[KX,lerp(-0.4,0.0,q),KZ],40);return 'ext'};
S.gb=(lt,D,T)=>{CUR='ext';nightE();atHole(T,{glow:1.5});put(C.gb,KX,KZ,{a:0.97,reach:true,look:0.5,mouth:TK('GB')},-0.3);cm([KX+0.25,0.75,KZ+1.15],[KX,0.25,KZ],36);return 'ext'};
S.pry=(lt,D,T)=>{CUR='ext';nightE();const drop=lt>D*0.45,grab=lt>D*0.6;const sink=grab?0.12*sm(seg(lt,D*0.6,D)):0;atHole(T,{glow:1.3,M:{sit:true,grab,eyes:grab?1.45:1.2,pupil:2,cover:!drop},N:{clutch:!drop,eyes:1.0}});C.man.position.set(KX-0.55,GY+0.98-0.3-sink,KZ+0.75);
 put(C.gb,KX,KZ,{a:0.95,reach:true,look:-0.6},-0.35);if(grab&&lt<D*0.75)RED=0.25*(1-seg(lt,D*0.6,D*0.75));cm([KX+1.5,1.45,KZ+2.6],[KX-0.25,0.35,KZ+0.4],42);return 'ext'};
S.pull=(lt,D,T)=>{CUR='ext';nightE();const p=sm(seg(lt,0,D*0.8));atHole(T,{glow:lerp(1.2,0.3,p),L:{armA:[-0.9,undefined],hoe:0.4,eyes:1.3},M:{sit:true,grab:p<0.9,eyes:1.3,tears:true}});C.man.position.set(KX-0.55,GY+0.98-0.42,KZ+0.75);C.lanh.position.set(KX-0.0,GY+0.98,KZ+1.25);
 HOLECAP.visible=true;HOLECAP.scale.setScalar(lerp(0.4,1,p));cm([KX+2.2,1.6,KZ+3.0],[KX-0.2,0.5,KZ+0.8],42);return 'ext'};
S.let=(lt,D,T)=>{CUR='ext';extMode('dusk');eHemi.intensity=0.8;HOLECAP.visible=true;HOLECAP.scale.setScalar(1);put(C.man,KX-0.55,KZ+0.75,{ankle:true,eyes:0.6,T},GY);const c=C.man;eFill.intensity=2.6;eFill.position.set(c.position.x+0.2,0.7,c.position.z+0.6);cm([c.position.x+0.1,lerp(0.85,0.7,sm(lt/D)),c.position.z+lerp(1.5,1.2,sm(lt/D))],[c.position.x-0.08,GY+0.3,c.position.z],40);return 'ext'};
// ---- kết: không jumpscare, chỉ không khí ----
S.end=(lt,D,T)=>{CUR='inn';day();put(C.na,-0.3,0.4,{smileF:true,eyes:1,look:1,walk:T*3,T});put(C.man,0.8,-0.5,{ankle:true,eyes:0.7,look:-1,T});cm([lerp(0.5,0.3,sm(lt/D)),1.35,3.2],[0.25,0.8,-0.1],46);return 'inn'};
S.end2=(lt,D,T)=>{CUR='ext';extMode('dusk');HOLECAP.visible=true;HOLECAP.scale.setScalar(1);const p=sm(lt/D);put(C.na,KX+0.55,KZ+0.55,{sit:true,back:true,T},GY-0.18);cm([lerp(KX+4,KX+2.6,p),lerp(2.2,1.6,p),lerp(KZ+5,KZ+3.6,p)],[KX+0.3,0.5,KZ+0.4],44);return 'ext'};
S.na3=(lt,D,T)=>{CUR='ext';extMode('dusk');eHemi.intensity=0.9;HOLECAP.visible=true;HOLECAP.scale.setScalar(1);put(C.na,KX+0.55,KZ+0.55,{sit:true,look:-1,eyes:0.9,mouth:TK('NA'),T},GY-0.18);const c=C.na;cm([c.position.x+0.35,lerp(0.8,0.72,sm(lt/D)),c.position.z+lerp(1.3,1.05,sm(lt/D))],[c.position.x,0.6,c.position.z],36);return 'ext'};
S.cta=(lt,D,T)=>{CUR='ext';extMode('night');ctaFlag=true;HOLECAP.visible=true;HOLECAP.scale.setScalar(1);foundL.intensity=0.6*flick(T);foundL.position.set(KX,0.3,KZ);cm([KX+lerp(1.6,1.2,sm(lt/D)),lerp(1.6,1.3,sm(lt/D)),KZ+lerp(2.4,2.0,sm(lt/D))],[KX,0.2,KZ],42);return 'ext'};
// ===== LỚP CHUYỂN ĐỘNG CHUNG (áp cho mọi cảnh) =====
const HSH=s=>{let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))%9973;return h/9973};
const SPK={lanh:'LA',man:'MA',tu:'TU',na:'NA',gb:'GB'};
const speaking=(kk)=>{const sp=SPK[kk];if(!sp)return false;for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a-0.05&&NOW<b+0.15)return true}return false};
const GHOST={ma:1,ml:1,bm:1,gb:1};
function startleAt(t){let best=-1;for(const [jk,jf] of JUMPS.concat(SOFT)){const q=TLD.scenes.find(x=>x[0]===jk);if(!q)continue;const d=t-(q[1]+(q[2]-q[1])*jf);if(d>=0&&d<0.7)best=d}return best}
function motionPre(kk,c,t){const o=Object.assign({},c.userData.o);const h=HSH(kk);
 if(!GHOST[kk]&&!o.back){const per=3.2+h*1.6,u=(t+h*7)%per;if(u<0.13&&(o.eyes===undefined||o.eyes>0.3))o.eyes=0.05}
 if(speaking(kk)&&!o.pot&&!o.phone&&!o.phoneLap&&!o.point&&!o.sit&&!o.back){const g=-0.18-0.22*Math.max(0,Math.sin(t*2.6+h*5));
  if(kk==='man'||kk==='na'){const a=(o.arm||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.arm=a}}else{const a=(o.armA||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.armA=a}}}
 if(!GHOST[kk]&&!speaking(kk)&&o.walk===undefined&&o.phase===undefined&&!o.jar&&!o.pot&&!o.clutch&&!o.bell&&!o.ears&&!o.cover&&!o.sit&&!o.back&&!o.hoe){const sw=0.05*Math.sin(t*1.1+h*7);if(kk==='man'||kk==='na'){const ar=(o.arm||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.12+sw;if(ar[1]===undefined)ar[1]=0.12+sw;o.arm=ar}else if(kk==='lanh'||kk==='tu'){const ar=(o.armA||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.1+sw;if(ar[1]===undefined)ar[1]=0.1+sw;o.armA=ar}}
 if(o.walk!==undefined&&(kk==='man'||kk==='na')&&!o.pot){const a=(o.arm||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.32*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.32*Math.sin(o.walk);o.arm=a}
 c.userData.o0=c.userData.o;c.userData.o=o}
function motionPost(kk,c,t){const h=HSH(kk);
 if(c.userData.o&&c.userData.o.crawl){c.rotateZ(1.3);}
 if(GHOST[kk]){c.position.y+=0.03*Math.sin(t*1.2+h*6);c.rotateZ(0.03*Math.sin(t*0.6+h*3));}
 else{const br=0.012*Math.sin(t*2.2+h*9);c.position.x+=0.012*Math.sin(t*0.7+h*5);c.scale.set(1,1+br,1);c.position.y+=0.98*br;c.rotateZ(0.012*Math.sin(t*0.9+h*4));
  if(speaking(kk))c.rotateZ(0.02*Math.sin(t*5.5+h));
  const d=startleAt(t);if(d>=0){const k=1-d/0.7;c.position.x+=0.035*Math.sin(d*55)*k;c.scale.y*=1-0.03*k}}
 c.userData.o=c.userData.o0}
// ================= vòng vẽ =================
function rain(a){g2.save();g2.strokeStyle=`rgba(180,200,230,${0.35*a})`;g2.lineWidth=1.6;for(let i=0;i<140;i++){const x=(R(i)*RW*1.2+NOW*60)%(RW*1.2)-RW*0.1,y=(R(i+300)*RH+NOW*1800*(0.8+R(i+7)*0.4))%RH;g2.beginPath();g2.moveTo(x,y);g2.lineTo(x-6,y+38);g2.stroke()}g2.restore()}
window.draw=function(t){NOW=t;const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;BLACK=0;TITLE=false;RED=0;RAIN=0;FLASH=0;blkA.scale.set(1.25,1,0.8);g2.clearRect(0,0,RW,RH);
 CC.inn.loi.castShadow=true;
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set(1.4+(R(i+5)-0.5)*7,0.3+((R(i+9)*2.5+t*0.05)%2.5),-2.4+p*4);m.material.opacity=0.3*Math.sin(p*Math.PI)});
 smoke.forEach((s,i)=>{const p=(t*0.15+i/12)%1;s.position.set(1.2+Math.sin(p*6+i)*0.06,2.3+p*0.9,-2.35);s.scale.setScalar(0.08+p*0.3);s.material.opacity=0.18*Math.sin(p*Math.PI)});
 riceWind(t);JAR_E.visible=false;JAR_I.visible=false;JAR_I.position.set(-1.6,0.02,-1.0);foundL.intensity=0;HANDS.forEach(h=>h.visible=false);HOLECAP.visible=true;HOLECAP.scale.setScalar(1);eSun.intensity=0;eMist.forEach((m,i)=>{const z=4+i*0.7;const x=((R(i)*20+t*0.12)%20)-10;m.position.set(x,0.6+R(i+2)*0.5,z)});
 mist.forEach((m,i)=>{const z=6-i*0.6;const x=((R(i)*14+t*0.15)%14)-7;m.position.set(x,H(x,z)+0.5+R(i+2)*0.6,z)});
 if(!S[k])console.log('missing',k);const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 let JF=-1;for(const [jk,jf,jz,hard] of JUMPS.concat(SOFT)){const sc2=TLD.scenes.find(q=>q[0]===jk);if(!sc2)continue;const tj=sc2[1]+(sc2[2]-sc2[1])*jf,dt=t-tj;if(dt<0||dt>1.4)continue;const z=dt<0.1?dt/0.1*jz:jz*Math.max(0,1-(dt-0.1)/1.3);const tv=new THREE.Vector3(...CT);cam.position.lerp(tv,z);if(hard&&dt<0.5){const a2=0.05*(1-dt/0.5);cam.position.x+=(R(t*977)-0.5)*a2*2;cam.position.y+=(R(t*631)-0.5)*a2*2}cam.lookAt(tv);if(hard)JF=dt}
 for(const kk in CC[mode]){const c=CC[mode][kk];if(!c.visible){c.scale.set(1,1,1);continue}motionPre(kk,c,t);c.userData.paint(t);c.scale.set(1,1,1);c.lookAt(cam.position.x,c.position.y,cam.position.z);motionPost(kk,c,t)}
 renderer.render(SCN[mode],cam);
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.55)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(RAIN)rain(RAIN);
 if(FLASH){g2.fillStyle=`rgba(220,230,255,${FLASH})`;g2.fillRect(0,0,RW,RH)}
 if(RED){g2.fillStyle=`rgba(140,0,0,${RED})`;g2.fillRect(0,0,RW,RH)}
 if(JF>=0&&JF<0.3){if(JF<0.06){g2.fillStyle='rgba(255,255,255,.55)';g2.fillRect(0,0,RW,RH)}else{g2.fillStyle=`rgba(160,0,0,${0.35*(1-JF/0.3)})`;g2.fillRect(0,0,RW,RH)}}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 grain(0.06);
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
