{"dur": 240.54, "scenes": [["hook", 0, 8.898, [0.3]], ["hook2", 8.898, 14.045, [0.2]], ["title", 14.045, 17.083, [0.2]], ["dig", 17.083, 25.971, [0.2]], ["dig2", 25.971, 34.993, [0.2]], ["man1", 34.993, 40.287, [0.2]], ["lanh1", 40.287, 45.138, [0.2]], ["hide", 45.138, 54.017, [0.2]], ["na1", 54.017, 60.563, [0.2]], ["na2", 60.563, 66.085, [0.2]], ["bell", 66.085, 73.315, [0.2]], ["odd", 73.315, 83.783, [0.2]], ["sick", 83.783, 90.925, [0.2]], ["tu", 90.925, 95.952, [0.2]], ["tu1", 95.952, 103.158, [0.2]], ["tu2", 103.158, 107.455, [0.2]], ["tu3", 107.455, 119.305, [0.2]], ["miss", 119.305, 123.434, [0.2]], ["earring", 123.434, 129.436, [0.2]], ["night", 129.436, 138.278, [0.2]], ["call", 138.278, 144.249, [0.2]], ["gm", 144.249, 152.227, [0.2]], ["nayes", 152.227, 157.285, [0.2]], ["bell2", 157.285, 166.472, [0.2]], ["boy", 166.472, 174.526, [0.2]], ["gb", 174.526, 182.524, [0.2]], ["pry", 182.524, 190.693, [0.2]], ["pull", 190.693, 199.936, [0.2]], ["let", 199.936, 206.304, [0.2]], ["end", 206.304, 214.467, [0.2]], ["end2", 214.467, 223.285, [0.2]], ["na3", 223.285, 230.065, [0.2]], ["cta", 230.065, 240.544, [0.2, 5.25]]], "subs": [[0.33, 1.64, "Ở miền Tây xưa,", "N"], [1.64, 4.32, "nhà giàu chôn của thường bắt một đứa", "N"], [4.32, 6.15, "nhỏ ngồi canh dưới hầm.", "N"], [6.15, 8.54, "Người ta gọi nó là thần giữ của.", "N"], [9.13, 11.25, "Ai đào trúng hũ của đó… thì đứa", "N"], [11.25, 13.34, "nhỏ sẽ đi theo người đó về nhà.", "N"], [14.28, 16.72, "Câu chuyện hôm nay… Thần giữ của.", "N"], [17.31, 19.54, "Vợ chồng Lành nghèo rớt mồng tơi.", "N"], [19.54, 21.54, "Bữa dỡ cái nền nhà cũ của ông", "N"], [21.54, 22.65, "cố để cất lại,", "N"], [22.65, 25.61, "lưỡi cuốc của Lành chạm trúng một cái hũ sành.", "N"], [26.2, 27.73, "Miệng hũ bịt sáp ong,", "N"], [27.73, 29.73, "dán một lá bùa đỏ đã bạc màu.", "N"], [29.73, 31.25, "Bên trong là vàng lá,", "N"], [31.25, 32.31, "đôi bông tai,", "N"], [32.31, 34.63, "và một cái lục lạc nhỏ của con nít.", "N"], [35.26, 37.62, "“Anh ơi… của người ta chôn thì để”", "MA"], [37.62, 39.83, "“người ta. Em thấy ghê quá anh.”", "MA"], [40.54, 41.88, "“Của trời cho mà em.”", "LA"], [41.88, 42.78, "“Có cái này,”", "LA"], [42.78, 44.71, "“con Na khỏi phải nghỉ học nữa.”", "LA"], [45.37, 47.87, "Lành giấu cái hũ dưới gầm giường.", "N"], [47.87, 49.06, "Sáng hôm sau,", "N"], [49.06, 51.43, "anh lén đem đôi bông tai ra chợ", "N"], [51.43, 53.31, "bán, mua tập vở cho con.", "N"], [54.25, 56.49, "Đêm đó, bé Na ngồi trên giường,", "N"], [56.49, 58.05, "nói chuyện một mình.", "N"], [58.05, 60.2, "Mận hỏi con nói chuyện với ai.", "N"], [60.85, 62.22, "“Với anh Hai đó má.”", "NA"], [62.22, 64.02, "“Ảnh ngồi dưới gầm giường.”", "NA"], [64.02, 65.66, "“Ảnh cho con cái này nè.”", "NA"], [66.32, 68.37, "Trong tay con bé là cái lục lạc", "N"], [68.37, 70.6, "trong hũ. Nhà Lành chỉ có mình con", "N"], [70.6, 72.45, "Na. Không có ai tên Hai hết.", "N"], [73.55, 75.82, "Từ đó, đêm nào cũng nghe lục lạc", "N"], [75.82, 77.73, "leng keng dưới gầm giường.", "N"], [77.73, 79.7, "Chén cơm cúng trên bàn thờ,", "N"], [79.7, 81.11, "sáng ra sạch trơn,", "N"], [81.11, 83.42, "dính đầy dấu tay con nít lấm bùn.", "N"], [84.01, 85.28, "Rồi bé Na đổ bệnh.", "N"], [85.28, 86.44, "Người lạnh ngắt,", "N"], [86.44, 87.38, "môi tím tái.", "N"], [87.38, 89.36, "Nửa đêm nó bò xuống gầm giường,", "N"], [89.36, 90.22, "bốc đất ăn.", "N"], [91.16, 93.14, "Mận bồng con chạy lên chân núi,", "N"], [93.14, 94.02, "tìm ông Tư,", "N"], [94.02, 95.59, "thầy pháp già nhất vùng.", "N"], [96.18, 98.4, "“Thằng nhỏ trong hũ là thần giữ của.”", "TU"], [98.4, 99.56, "“Nó bị chôn sống,”", "TU"], [99.56, 101.01, "“canh của cả trăm năm.”", "TU"], [101.01, 101.89, "“Của đi đâu,”", "TU"], [101.89, 102.75, "“nó theo đó.”", "TU"], [103.39, 105.05, "“Nó đưa đồ của nó cho ai… là”", "TU"], [105.05, 107.04, "“nó chọn người đó ngồi canh thế nó.”", "TU"], [107.73, 109.57, "“Đêm nay, trước khi gà gáy,”", "TU"], [109.57, 111.4, "“đem hũ về chôn lại chỗ cũ,”", "TU"], [111.4, 112.41, "“đủ từng món,”", "TU"], [112.41, 113.77, "“kể cả cái lục lạc.”", "TU"], [113.77, 114.9, "“Thiếu một món,”", "TU"], [114.9, 115.97, "“nó bắt người.”", "TU"], [115.97, 117.39, "“Còn nữa: nó kêu gì,”", "TU"], [117.39, 118.9, "“cũng đừng ai trả lời.”", "TU"], [119.53, 120.67, "Mận chết điếng.", "N"], [120.67, 121.69, "Đôi bông tai,", "N"], [121.69, 123.07, "Lành đã bán mất rồi.", "N"], [123.66, 125.06, "Không kịp chuộc lại,", "N"], [125.06, 127.25, "Mận tháo đôi bông tai cưới má ruột", "N"], [127.25, 128.73, "cho, bỏ vô hũ thế vào.", "N"], [129.67, 131.92, "Nửa đêm, Lành ôm hũ ra nền nhà", "N"], [131.92, 134.05, "cũ. Mận bồng bé Na theo sau.", "N"], [134.05, 135.73, "Cái hố cũ vẫn còn đó,", "N"], [135.73, 137.57, "tối đen như miệng giếng.", "N"], [138.51, 140.15, "Lành vừa đặt cái hũ xuống,", "N"], [140.15, 142.06, "thì dưới hố vọng lên tiếng gọi.", "N"], [142.06, 143.89, "Giọng giống hệt giọng của Mận.", "N"], [144.54, 149.79, "“Na ơi… lại đây má bồng con nè…”", "GM"], [152.46, 153.86, "Bé Na ngóc đầu dậy,", "N"], [153.86, 155.14, "mở miệng định dạ.", "N"], [155.14, 156.93, "Mận vội bịt miệng con lại.", "N"], [157.52, 159.93, "Lành lấp đất được một nửa thì khựng", "N"], [159.93, 162.29, "lại. Cái lục lạc vẫn còn nằm trong", "N"], [162.29, 163.19, "tay bé Na.", "N"], [163.19, 164.46, "Con bé nắm chặt,", "N"], [164.46, 165.76, "không chịu buông.", "N"], [166.7, 167.68, "Dưới đáy hố,", "N"], [167.68, 169.47, "có một thằng nhỏ trọc đầu,", "N"], [169.47, 170.56, "chừa cái chỏm,", "N"], [170.56, 171.54, "ngồi bó gối.", "N"], [171.54, 172.58, "Nó ngước lên,", "N"], [172.58, 174.17, "chìa tay về phía bé Na.", "N"], [174.78, 179.97, "“Đưa đây cho anh… rồi xuống đây ngồi với anh…”", "GB"], [182.75, 184.58, "Mận cạy từng ngón tay con.", "N"], [184.58, 186.35, "Cái lục lạc rớt xuống hố.", "N"], [186.35, 188.59, "Một bàn tay lạnh ngắt chụp lấy cổ", "N"], [188.59, 190.33, "chân Mận, kéo tuột xuống.", "N"], [190.92, 192.2, "Lành ghì vợ lại,", "N"], [192.2, 193.9, "tay kia hất đất lấp hố.", "N"], [193.9, 195.18, "Đất lấp tới đâu,", "N"], [195.18, 196.7, "bàn tay siết tới đó.", "N"], [196.7, 197.61, "Rồi xa xa,", "N"], [197.61, 199.23, "gà gáy tiếng đầu tiên.", "N"], [200.17, 201.43, "Bàn tay buông ra,", "N"], [201.43, 202.58, "chìm xuống đất.", "N"], [202.58, 204.65, "Cổ chân Mận còn in năm dấu ngón", "N"], [204.65, 205.59, "tay đen bầm.", "N"], [206.53, 207.83, "Bé Na khỏi bệnh.", "N"], [207.83, 210.28, "Dấu tay trên chân Mận thì không bao", "N"], [210.28, 212.8, "giờ phai. Và nhà Lành không cất trên", "N"], [212.8, 213.76, "nền cũ nữa.", "N"], [214.7, 216.12, "Nhưng có một chuyện,", "N"], [216.12, 217.72, "Mận chưa dám kể với ai.", "N"], [217.72, 219.83, "Chiều nào bé Na cũng ra ngồi bên", "N"], [219.83, 220.74, "nền nhà cũ,", "N"], [220.74, 222.42, "cúi xuống đất mà nói nhỏ.", "N"], [223.53, 226.01, "“Anh Hai ráng chờ nghen… chừng nào em”", "NA"], [226.01, 227.92, "“lớn… em xuống ngồi với anh.”", "NA"], [230.29, 232.45, "Nếu đào được hũ vàng có dán bùa…", "N"], [232.45, 234.4, "bạn có dám mang về nhà không?", "N"], [235.34, 236.47, "Để lại bình luận,", "N"], [236.47, 238.68, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 9.097833333333334, 14.245229166666666, 17.283270833333333, 26.1709375, 35.193333333333335, 40.48733333333333, 45.338229166666665, 54.21720833333333, 60.76258333333333, 66.28529166666667, 73.515, 83.98341666666667, 91.12504166666666, 96.15187499999999, 103.35791666666665, 107.65520833333332, 119.50458333333331, 123.63397916666665, 129.6364583333333, 138.47822916666664, 144.4488958333333, 152.4274583333333, 157.4850208333333, 166.67199999999997, 174.7258333333333, 182.72424999999996, 190.89306249999996, 200.13627083333327, 206.50447916666658, 214.66727083333325, 223.48456249999992, 230.26483333333326, 235.3114999999999], "durs": [8.297833333333333, 4.297395833333334, 2.5380416666666665, 8.387666666666666, 8.522395833333333, 4.794, 4.350895833333333, 8.028979166666666, 6.045375, 5.022708333333