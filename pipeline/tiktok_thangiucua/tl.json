{"dur": 232.87, "scenes": [["hook", 0, 7.68, [0.3]], ["hook2", 7.68, 12.199, [0.2]], ["title", 12.199, 13.546, [0.2]], ["dig", 13.546, 21.854, [0.2]], ["dig2", 21.854, 30.249, [0.2]], ["man1", 30.249, 35.543, [0.2]], ["lanh1", 35.543, 40.394, [0.2]], ["hide", 40.394, 48.72, [0.2]], ["na1", 48.72, 54.858, [0.2]], ["na2", 54.858, 60.381, [0.2]], ["bell", 60.381, 67.168, [0.2]], ["odd", 67.168, 76.909, [0.2]], ["sick", 76.909, 83.584, [0.2]], ["tu", 83.584, 88.278, [0.2]], ["tu1", 88.278, 98.004, [0.2]], ["tu2", 98.004, 103.209, [0.2]], ["tu3", 103.209, 117.952, [0.2]], ["miss", 117.952, 121.826, [0.2]], ["earring", 121.826, 127.459, [0.2]], ["night", 127.459, 135.706, [0.2]], ["call", 135.706, 140.821, [0.2]], ["gm", 140.821, 148.8, [0.2]], ["nayes", 148.8, 153.576, [0.2]], ["bell2", 153.576, 162.177, [0.2]], ["boy", 162.177, 169.662, [0.2]], ["gb", 169.662, 177.66, [0.2]], ["pry", 177.66, 185.295, [0.2]], ["pull", 185.295, 194.253, [0.2]], ["let", 194.253, 200.251, [0.2]], ["end", 200.251, 207.859, [0.2]], ["end2", 207.859, 216.145, [0.2]], ["na3", 216.145, 222.925, [0.2]], ["cta", 222.925, 232.87, [0.2, 4.95]]], "subs": [[0.33, 1.44, "Ở miền Tây xưa,", "N"], [1.44, 3.73, "nhà giàu chôn của thường bắt một đứa", "N"], [3.73, 5.29, "nhỏ ngồi canh dưới hầm.", "N"], [5.29, 7.32, "Người ta gọi nó là thần giữ của.", "N"], [7.91, 9.71, "Ai đào trúng hũ của đó… thì đứa", "N"], [9.71, 11.49, "nhỏ sẽ đi theo người đó về nhà.", "N"], [12.43, 13.19, "Thần giữ của.", "N"], [13.78, 15.85, "Vợ chồng Lành nghèo rớt mồng tơi.", "N"], [15.85, 17.7, "Bữa dỡ cái nền nhà cũ của ông", "N"], [17.7, 18.74, "cố để cất lại,", "N"], [18.74, 21.49, "lưỡi cuốc của Lành chạm trúng một cái hũ sành.", "N"], [22.08, 23.5, "Miệng hũ bịt sáp ong,", "N"], [23.5, 25.35, "dán một lá bùa đỏ đã bạc màu.", "N"], [25.35, 26.76, "Bên trong là vàng lá,", "N"], [26.76, 27.74, "đôi bông tai,", "N"], [27.74, 29.89, "và một cái lục lạc nhỏ của con nít.", "N"], [30.52, 32.88, "“Anh ơi… của người ta chôn thì để”", "MA"], [32.88, 35.09, "“người ta. Em thấy ghê quá anh.”", "MA"], [35.79, 37.13, "“Của trời cho mà em.”", "LA"], [37.13, 38.03, "“Có cái này,”", "LA"], [38.03, 39.96, "“con Na khỏi phải nghỉ học nữa.”", "LA"], [40.62, 42.95, "Lành giấu cái hũ dưới gầm giường.", "N"], [42.95, 44.06, "Sáng hôm sau,", "N"], [44.06, 46.26, "anh lén đem đôi bông tai ra chợ", "N"], [46.26, 48.01, "bán, mua tập vở cho con.", "N"], [48.95, 51.04, "Đêm đó, bé Na ngồi trên giường,", "N"], [51.04, 52.49, "nói chuyện một mình.", "N"], [52.49, 54.5, "Mận hỏi con nói chuyện với ai.", "N"], [55.15, 56.52, "“Với anh Hai đó má.”", "NA"], [56.52, 58.32, "“Ảnh ngồi dưới gầm giường.”", "NA"], [58.32, 59.96, "“Ảnh cho con cái này nè.”", "NA"], [60.61, 62.52, "Trong tay con bé là cái lục lạc", "N"], [62.52, 64.59, "trong hũ. Nhà Lành chỉ có mình con", "N"], [64.59, 66.31, "Na. Không có ai tên Hai hết.", "N"], [67.4, 69.51, "Từ đó, đêm nào cũng nghe lục lạc", "N"], [69.51, 71.28, "leng keng dưới gầm giường.", "N"], [71.28, 73.1, "Chén cơm cúng trên bàn thờ,", "N"], [73.1, 74.41, "sáng ra sạch trơn,", "N"], [74.41, 76.55, "dính đầy dấu tay con nít lấm bùn.", "N"], [77.14, 78.31, "Rồi bé Na đổ bệnh.", "N"], [78.31, 79.38, "Người lạnh ngắt,", "N"], [79.38, 80.25, "môi tím tái.", "N"], [80.25, 82.09, "Nửa đêm nó bò xuống gầm giường,", "N"], [82.09, 82.87, "bốc đất ăn.", "N"], [83.81, 85.65, "Mận bồng con chạy lên chân núi,", "N"], [85.65, 86.47, "tìm ông Tư,", "N"], [86.47, 87.92, "thầy pháp già nhất vùng.", "N"], [88.53, 91.58, "“Thằng nhỏ trong hũ là thần giữ của.”", "TU"], [91.58, 93.18, "“Nó bị chôn sống,”", "TU"], [93.18, 95.17, "“canh của cả trăm năm.”", "TU"], [95.17, 96.39, "“Của đi đâu,”", "TU"], [96.39, 97.58, "“nó theo đó.”", "TU"], [98.25, 100.31, "“Nó đưa đồ của nó cho ai… là”", "TU"], [100.31, 102.78, "“nó chọn người đó ngồi canh thế nó.”", "TU"], [103.46, 105.77, "“Đêm nay, trước khi gà gáy,”", "TU"], [105.77, 108.07, "“đem hũ về chôn lại chỗ cũ,”", "TU"], [108.07, 109.34, "“đủ từng món,”", "TU"], [109.34, 111.05, "“kể cả cái lục lạc.”", "TU"], [111.05, 112.46, "“Thiếu một món,”", "TU"], [112.46, 113.8, "“nó bắt người.”", "TU"], [113.8, 115.59, "“Còn nữa: nó kêu gì,”", "TU"], [115.59, 117.49, "“cũng đừng ai trả lời.”", "TU"], [118.18, 119.23, "Mận chết điếng.", "N"], [119.23, 120.18, "Đôi bông tai,", "N"], [120.18, 121.47, "Lành đã bán mất rồi.", "N"], [122.06, 123.35, "Không kịp chuộc lại,", "N"], [123.35, 125.38, "Mận tháo đôi bông tai cưới má ruột", "N"], [125.38, 126.75, "cho, bỏ vô hũ thế vào.", "N"], [127.69, 129.78, "Nửa đêm, Lành ôm hũ ra nền nhà", "N"], [129.78, 131.75, "cũ. Mận bồng bé Na theo sau.", "N"], [131.75, 133.3, "Cái hố cũ vẫn còn đó,", "N"], [133.3, 135.0, "tối đen như miệng giếng.", "N"], [135.94, 137.37, "Lành vừa đặt hũ xuống,", "N"], [137.37, 139.06, "dưới hố vọng lên tiếng gọi.", "N"], [139.06, 140.46, "Giọng y hệt giọng Mận.", "N"], [141.11, 146.36, "“Na ơi… lại đây má bồng con nè…”", "GM"], [149.03, 150.34, "Bé Na ngóc đầu dậy,", "N"], [150.34, 151.55, "mở miệng định dạ.", "N"], [151.55, 153.22, "Mận vội bịt miệng con lại.", "N"], [153.81, 156.05, "Lành lấp đất được một nửa thì khựng", "N"], [156.05, 158.24, "lại. Cái lục lạc vẫn còn nằm trong", "N"], [158.24, 159.08, "tay bé Na.", "N"], [159.08, 160.26, "Con bé nắm chặt,", "N"], [160.26, 161.47, "không chịu buông.", "N"], [162.41, 163.31, "Dưới đáy hố,", "N"], [163.31, 164.96, "có một thằng nhỏ trọc đầu,", "N"], [164.96, 165.98, "chừa cái chỏm,", "N"], [165.98, 166.88, "ngồi bó gối.", "N"], [166.88, 167.84, "Nó ngước lên,", "N"], [167.84, 169.3, "chìa tay về phía bé Na.", "N"], [169.91, 175.1, "“Đưa đây cho anh… rồi xuống đây ngồi với anh…”", "GB"], [177.89, 179.59, "Mận cạy từng ngón tay con.", "N"], [179.59, 181.24, "Cái lục lạc rớt xuống hố.", "N"], [181.24, 183.32, "Một bàn tay lạnh ngắt chụp lấy cổ", "N"], [183.32, 184.93, "chân Mận, kéo tuột xuống.", "N"], [185.52, 186.76, "Lành ghì vợ lại,", "N"], [186.76, 188.4, "tay kia hất đất lấp hố.", "N"], [188.4, 189.64, "Đất lấp tới đâu,", "N"], [189.64, 191.11, "bàn tay siết tới đó.", "N"], [191.11, 191.99, "Rồi xa xa,", "N"], [191.99, 193.54, "gà gáy tiếng đầu tiên.", "N"], [194.48, 195.66, "Bàn tay buông ra,", "N"], [195.66, 196.73, "chìm xuống đất.", "N"], [196.73, 198.66, "Cổ chân Mận còn in năm dấu ngón", "N"], [198.66, 199.54, "tay đen bầm.", "N"], [200.48, 201.67, "Bé Na khỏi bệnh.", "N"], [201.67, 203.94, "Dấu tay trên chân Mận thì không bao", "N"], [203.94, 206.27, "giờ phai. Và nhà Lành không cất trên", "N"], [206.27, 207.15, "nền cũ nữa.", "N"], [208.09, 209.42, "Nhưng có một chuyện,", "N"], [209.42, 210.9, "Mận chưa dám kể với ai.", "N"], [210.9, 212.87, "Chiều nào bé Na cũng ra ngồi bên", "N"], [212.87, 213.72, "nền nhà cũ,", "N"], [213.72, 215.28, "cúi xuống đất mà nói nhỏ.", "N"], [216.39, 218.87, "“Anh Hai ráng chờ nghen… chừng nào em”", "NA"], [218.87, 220.78, "“lớn… em xuống ngồi với anh.”", "NA"], [223.15, 225.15, "Nếu đào được hũ vàng có dán bùa…", "N"], [225.15, 226.96, "bạn có dám mang về nhà không?", "N"], [227.9, 228.95, "Để lại bình luận,", "N"], [228.95, 231.01, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 7.879604166666667, 12.399145833333334, 13.746, 22.053854166666667, 30.44922916666667, 35.743229166666666, 40.594125, 48.92004166666667, 55.05847916666667, 60.581187500000006, 67.36820833333334, 77.10895833333335, 83.78381250000001, 88.47831250000002, 98.20420833333336, 103.4090416666667, 118.15189583333336, 122.02602083333336, 127.65852083333336, 135.906125, 141.02145833333333, 149.00002083333334, 153.77602083333335, 162.37672916666668, 169.86183333333335, 177.86025, 185.49458333333334, 194.45266666666666, 200.45125, 208.05870833333333, 216.34470833333333, 223.12497916666666, 227.87008333333333], "durs": [7.079604166666667, 3.6695416666666665, 0.8468541666666667, 7.807854166666667, 7.895375, 4.794, 4.350895833333333, 7.4759166666666665, 5.6384375, 5.022708333333333, 5.787020833333333, 9.24075, 5.824854166666666, 4.1945, 9.225895833333333, 4.7