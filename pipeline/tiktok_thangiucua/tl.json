{"dur": 226.98, "scenes": [["hook", 0, 7.68, [0.3]], ["hook2", 7.68, 12.199, [0.2]], ["title", 12.199, 13.772, [0.2]], ["dig", 13.772, 22.08, [0.2]], ["dig2", 22.08, 30.475, [0.2]], ["man1", 30.475, 35.769, [0.2]], ["lanh1", 35.769, 40.62, [0.2]], ["hide", 40.62, 48.946, [0.2]], ["na1", 48.946, 55.084, [0.2]], ["na2", 55.084, 60.607, [0.2]], ["bell", 60.607, 67.394, [0.2]], ["odd", 67.394, 77.135, [0.2]], ["sick", 77.135, 83.81, [0.2]], ["tu", 83.81, 88.504, [0.2]], ["tu1", 88.504, 95.71, [0.2]], ["tu2", 95.71, 100.007, [0.2]], ["tu3", 100.007, 111.857, [0.2]], ["miss", 111.857, 115.731, [0.2]], ["earring", 115.731, 121.363, [0.2]], ["night", 121.363, 129.611, [0.2]], ["call", 129.611, 135.251, [0.2]], ["gm", 135.251, 143.229, [0.2]], ["nayes", 143.229, 148.005, [0.2]], ["bell2", 148.005, 156.606, [0.2]], ["boy", 156.606, 164.091, [0.2]], ["gb", 164.091, 172.09, [0.2]], ["pry", 172.09, 179.724, [0.2]], ["pull", 179.724, 188.358, [0.2]], ["let", 188.358, 194.357, [0.2]], ["end", 194.357, 201.964, [0.2]], ["end2", 201.964, 210.25, [0.2]], ["na3", 210.25, 217.03, [0.2]], ["cta", 217.03, 226.975, [0.2, 4.95]]], "subs": [[0.33, 1.44, "Ở miền Tây xưa,", "N"], [1.44, 3.73, "nhà giàu chôn của thường bắt một đứa", "N"], [3.73, 5.29, "nhỏ ngồi canh dưới hầm.", "N"], [5.29, 7.32, "Người ta gọi nó là thần giữ của.", "N"], [7.91, 9.71, "Ai đào trúng hũ của đó… thì đứa", "N"], [9.71, 11.49, "nhỏ sẽ đi theo người đó về nhà.", "N"], [12.43, 13.41, "Chuyện thần giữ của.", "N"], [14.0, 16.08, "Vợ chồng Lành nghèo rớt mồng tơi.", "N"], [16.08, 17.93, "Bữa dỡ cái nền nhà cũ của ông", "N"], [17.93, 18.97, "cố để cất lại,", "N"], [18.97, 21.72, "lưỡi cuốc của Lành chạm trúng một cái hũ sành.", "N"], [22.31, 23.72, "Miệng hũ bịt sáp ong,", "N"], [23.72, 25.57, "dán một lá bùa đỏ đã bạc màu.", "N"], [25.57, 26.99, "Bên trong là vàng lá,", "N"], [26.99, 27.97, "đôi bông tai,", "N"], [27.97, 30.12, "và một cái lục lạc nhỏ của con nít.", "N"], [30.75, 33.11, "“Anh ơi… của người ta chôn thì để”", "MA"], [33.11, 35.32, "“người ta. Em thấy ghê quá anh.”", "MA"], [36.02, 37.36, "“Của trời cho mà em.”", "LA"], [37.36, 38.26, "“Có cái này,”", "LA"], [38.26, 40.19, "“con Na khỏi phải nghỉ học nữa.”", "LA"], [40.85, 43.18, "Lành giấu cái hũ dưới gầm giường.", "N"], [43.18, 44.28, "Sáng hôm sau,", "N"], [44.28, 46.49, "anh lén đem đôi bông tai ra chợ", "N"], [46.49, 48.24, "bán, mua tập vở cho con.", "N"], [49.18, 51.27, "Đêm đó, bé Na ngồi trên giường,", "N"], [51.27, 52.72, "nói chuyện một mình.", "N"], [52.72, 54.72, "Mận hỏi con nói chuyện với ai.", "N"], [55.37, 56.74, "“Với anh Hai đó má.”", "NA"], [56.74, 58.54, "“Ảnh ngồi dưới gầm giường.”", "NA"], [58.54, 60.18, "“Ảnh cho con cái này nè.”", "NA"], [60.84, 62.75, "Trong tay con bé là cái lục lạc", "N"], [62.75, 64.81, "trong hũ. Nhà Lành chỉ có mình con", "N"], [64.81, 66.53, "Na. Không có ai tên Hai hết.", "N"], [67.62, 69.73, "Từ đó, đêm nào cũng nghe lục lạc", "N"], [69.73, 71.5, "leng keng dưới gầm giường.", "N"], [71.5, 73.33, "Chén cơm cúng trên bàn thờ,", "N"], [73.33, 74.64, "sáng ra sạch trơn,", "N"], [74.64, 76.77, "dính đầy dấu tay con nít lấm bùn.", "N"], [77.36, 78.54, "Rồi bé Na đổ bệnh.", "N"], [78.54, 79.61, "Người lạnh ngắt,", "N"], [79.61, 80.48, "môi tím tái.", "N"], [80.48, 82.31, "Nửa đêm nó bò xuống gầm giường,", "N"], [82.31, 83.1, "bốc đất ăn.", "N"], [84.04, 85.88, "Mận bồng con chạy lên chân núi,", "N"], [85.88, 86.69, "tìm ông Tư,", "N"], [86.69, 88.14, "thầy pháp già nhất vùng.", "N"], [88.73, 90.95, "“Thằng nhỏ trong hũ là thần giữ của.”", "TU"], [90.95, 92.11, "“Nó bị chôn sống,”", "TU"], [92.11, 93.56, "“canh của cả trăm năm.”", "TU"], [93.56, 94.44, "“Của đi đâu,”", "TU"], [94.44, 95.3, "“nó theo đó.”", "TU"], [95.94, 97.6, "“Nó đưa đồ của nó cho ai… là”", "TU"], [97.6, 99.59, "“nó chọn người đó ngồi canh thế nó.”", "TU"], [100.28, 102.12, "“Đêm nay, trước khi gà gáy,”", "TU"], [102.12, 103.95, "“đem hũ về chôn lại chỗ cũ,”", "TU"], [103.95, 104.96, "“đủ từng món,”", "TU"], [104.96, 106.32, "“kể cả cái lục lạc.”", "TU"], [106.32, 107.45, "“Thiếu một món,”", "TU"], [107.45, 108.52, "“nó bắt người.”", "TU"], [108.52, 109.94, "“Còn nữa: nó kêu gì,”", "TU"], [109.94, 111.45, "“cũng đừng ai trả lời.”", "TU"], [112.09, 113.14, "Mận chết điếng.", "N"], [113.14, 114.09, "Đôi bông tai,", "N"], [114.09, 115.37, "Lành đã bán mất rồi.", "N"], [115.96, 117.26, "Không kịp chuộc lại,", "N"], [117.26, 119.28, "Mận tháo đôi bông tai cưới má ruột", "N"], [119.28, 120.65, "cho, bỏ vô hũ thế vào.", "N"], [121.59, 123.68, "Nửa đêm, Lành ôm hũ ra nền nhà", "N"], [123.68, 125.65, "cũ. Mận bồng bé Na theo sau.", "N"], [125.65, 127.2, "Cái hố cũ vẫn còn đó,", "N"], [127.2, 128.9, "tối đen như miệng giếng.", "N"], [129.84, 131.38, "Lành vừa đặt cái hũ xuống,", "N"], [131.38, 133.18, "thì dưới hố vọng lên tiếng gọi.", "N"], [133.18, 134.89, "Giọng giống hệt giọng của Mận.", "N"], [135.54, 140.79, "“Na ơi… lại đây má bồng con nè…”", "GM"], [143.46, 144.77, "Bé Na ngóc đầu dậy,", "N"], [144.77, 145.98, "mở miệng định dạ.", "N"], [145.98, 147.65, "Mận vội bịt miệng con lại.", "N"], [148.24, 150.48, "Lành lấp đất được một nửa thì khựng", "N"], [150.48, 152.67, "lại. Cái lục lạc vẫn còn nằm trong", "N"], [152.67, 153.51, "tay bé Na.", "N"], [153.51, 154.69, "Con bé nắm chặt,", "N"], [154.69, 155.9, "không chịu buông.", "N"], [156.84, 157.74, "Dưới đáy hố,", "N"], [157.74, 159.39, "có một thằng nhỏ trọc đầu,", "N"], [159.39, 160.41, "chừa cái chỏm,", "N"], [160.41, 161.31, "ngồi bó gối.", "N"], [161.31, 162.27, "Nó ngước lên,", "N"], [162.27, 163.73, "chìa tay về phía bé Na.", "N"], [164.34, 169.53, "“Đưa đây cho anh… rồi xuống đây ngồi với anh…”", "GB"], [172.32, 174.02, "Mận cạy từng ngón tay con.", "N"], [174.02, 175.66, "Cái lục lạc rớt xuống hố.", "N"], [175.66, 177.75, "Một bàn tay lạnh ngắt chụp lấy cổ", "N"], [177.75, 179.36, "chân Mận, kéo tuột xuống.", "N"], [179.95, 181.14, "Lành ghì vợ lại,", "N"], [181.14, 182.72, "tay kia hất đất lấp hố.", "N"], [182.72, 183.9, "Đất lấp tới đâu,", "N"], [183.9, 185.31, "bàn tay siết tới đó.", "N"], [185.31, 186.16, "Rồi xa xa,", "N"], [186.16, 187.65, "gà gáy tiếng đầu tiên.", "N"], [188.59, 189.77, "Bàn tay buông ra,", "N"], [189.77, 190.84, "chìm xuống đất.", "N"], [190.84, 192.77, "Cổ chân Mận còn in năm dấu ngón", "N"], [192.77, 193.65, "tay đen bầm.", "N"], [194.59, 195.78, "Bé Na khỏi bệnh.", "N"], [195.78, 198.05, "Dấu tay trên chân Mận thì không bao", "N"], [198.05, 200.38, "giờ phai. Và nhà Lành không cất trên", "N"], [200.38, 201.25, "nền cũ nữa.", "N"], [202.19, 203.52, "Nhưng có một chuyện,", "N"], [203.52, 205.01, "Mận chưa dám kể với ai.", "N"], [205.01, 206.98, "Chiều nào bé Na cũng ra ngồi bên", "N"], [206.98, 207.83, "nền nhà cũ,", "N"], [207.83, 209.39, "cúi xuống đất mà nói nhỏ.", "N"], [210.5, 212.98, "“Anh Hai ráng chờ nghen… chừng nào em”", "NA"], [212.98, 214.89, "“lớn… em xuống ngồi với anh.”", "NA"], [217.26, 219.26, "Nếu đào được hũ vàng có dán bùa…", "N"], [219.26, 221.07, "bạn có dám mang về nhà không?", "N"], [222.01, 223.05, "Để lại bình luận,", "N"], [223.05, 225.12, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 7.879604166666667, 12.399145833333334, 13.9718125, 22.279666666666667, 30.675041666666665, 35.96904166666666, 40.819937499999995, 49.14585416666666, 55.28429166666666, 60.806999999999995, 67.59402083333333, 77.33477083333334, 84.009625, 88.704125, 95.91016666666667, 100.20745833333334, 112.05683333333333, 115.93095833333334, 121.56345833333333, 129.8110625, 135.45081249999998, 143.429375, 148.205375, 156.80608333333333, 164.2911875, 172.28960416666666, 179.9239375, 188.55810416666665, 194.55668749999998, 202.16414583333332, 210.45014583333332, 217.23041666666666, 221.97552083333332], "durs": [7.079604166666667, 3.6695416666666665, 1.0726666666666667, 7.807854166666667, 7.895375, 4.794, 4.350895833333333, 7.4759166666666665, 5.6384375, 5.022708333333333, 5.787020833333333, 9.24075, 5.824854166666666, 4.1945, 6.706041666666