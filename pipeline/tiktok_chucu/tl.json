{"dur": 256.37, "scenes": [["hook", 0, 9.598, [0.3]], ["hook2", 9.598, 16.675, [0.2]], ["title", 16.675, 19.487, [0.2]], ["buy", 19.487, 32.832, [0.2]], ["bay", 32.832, 37.23, [0.2]], ["bay1", 37.23, 50.286, [0.2]], ["water", 50.286, 58.737, [0.2]], ["check", 58.737, 65.615, [0.2]], ["offer", 65.615, 77.774, [0.2]], ["bowls", 77.774, 88.308, [0.2]], ["sleep", 88.308, 95.224, [0.2]], ["phuc", 95.224, 99.646, [0.2]], ["lien", 99.646, 104.87, [0.2]], ["bay2", 104.87, 117.665, [0.2]], ["bay3", 117.665, 132.17, [0.2]], ["find", 132.17, 139.064, [0.2]], ["tu1", 139.064, 143.951, [0.2]], ["tu2", 143.951, 149.879, [0.2]], ["night", 149.879, 159.75, [0.2]], ["gs", 159.75, 168.427, [0.2]], ["stop", 168.427, 176.753, [0.2]], ["turn", 176.753, 183.115, [0.2]], ["tu3", 183.115, 186.354, [0.2]], ["gs2", 186.354, 196.64, [0.2]], ["door", 196.64, 209.105, [0.2]], ["morning", 209.105, 216.599, [0.2]], ["end", 216.599, 222.476, [0.2]], ["end2", 222.476, 233.976, [0.2]], ["gs3", 233.976, 244.48, [0.2]], ["cta", 244.48, 256.373, [0.2, 6.63]]], "subs": [[0.33, 1.21, "Ở miền Tây,", "N"], [1.21, 2.21, "người ta dặn:", "N"], [2.21, 3.09, "mua nhà cũ,", "N"], [3.09, 5.24, "đêm đầu tiên phải cúng một mâm cơm", "N"], [5.24, 6.12, "cho chủ cũ.", "N"], [6.12, 8.28, "Vì có những người chủ… chết rồi mà", "N"], [8.28, 9.24, "chưa chịu đi.", "N"], [9.83, 11.09, "Và nếu nửa đêm,", "N"], [11.09, 13.42, "nghe dưới bếp có tiếng ai kêu ăn", "N"], [13.42, 15.97, "cơm… thì tuyệt đối đừng ngồi vô mâm.", "N"], [16.91, 18.78, "Câu chuyện hôm nay… Người chủ cũ.", "N"], [19.72, 22.11, "Vợ chồng Phúc với Liên dồn hết vốn,", "N"], [22.11, 24.32, "mua được căn nhà tường ven kinh,", "N"], [24.32, 25.75, "giá rẻ tới khó tin.", "N"], [25.75, 27.24, "Người bán là ông Tư,", "N"], [27.24, 28.68, "nhà ở chợ Châu Đốc.", "N"], [28.68, 30.65, "Ổng ký giấy xong là đi liền,", "N"], [30.65, 32.47, "không dám ngó lại căn nhà.", "N"], [33.06, 34.68, "Bà Bảy hàng xóm qua chơi,", "N"], [34.68, 35.98, "nhìn quanh căn bếp,", "N"], [35.98, 36.87, "rồi nói nhỏ.", "N"], [37.46, 39.35, "“Nhà này của bà Sáu.”", "BA"], [39.35, 41.24, "“Bả chết ở dưới bếp.”", "BA"], [41.24, 44.15, "“Hai đứa nhớ cúng cho đàng hoàng.”", "BA"], [44.15, 46.83, "“Mà tối có nghe bả kêu ăn cơm,”", "BA"], [46.83, 49.55, "“thì đừng ai ngồi vô mâm nghen.”", "BA"], [50.52, 51.54, "Đêm đầu tiên,", "N"], [51.54, 52.79, "đúng ba giờ sáng,", "N"], [52.79, 54.66, "dưới bếp có tiếng nước chảy.", "N"], [54.66, 56.42, "Rồi tiếng vo gạo sột soạt.", "N"], [56.42, 58.38, "Tiếng nồi niêu khua lẻng xẻng.", "N"], [58.97, 60.57, "Phúc cầm đèn xuống coi.", "N"], [60.57, 61.49, "Bếp tối om.", "N"], [61.49, 63.5, "Lu nước tràn lênh láng ra nền.", "N"], [63.5, 65.25, "Mà cái nắp lu vẫn đậy kín.", "N"], [65.84, 67.87, "Liên sợ, ngày nào cũng cúng.", "N"], [67.87, 70.14, "Nhưng mâm cúng bày ra bao nhiêu,", "N"], [70.14, 72.17, "sáng ra sạch trơn bấy nhiêu.", "N"], [72.17, 74.5, "Nồi cơm trong bếp cũng bị vét tới", "N"], [74.5, 77.41, "cháy đáy. Đồ cúng mua cỡ nào cũng không đủ.", "N"], [78.0, 79.04, "Rồi một sáng,", "N"], [79.04, 81.23, "Liên thấy trên bàn bếp có hai cái", "N"], [81.23, 82.96, "chén. Một chén cơm trắng,", "N"], [82.96, 84.23, "cắm đứng đôi đũa.", "N"], [84.23, 86.65, "Chén còn lại để trống… ngay chỗ chồng", "N"], [86.65, 87.6, "cô hay ngồi.", "N"], [88.54, 90.57, "Từ đó, đêm nào Phúc cũng mộng du.", "N"], [90.57, 91.74, "Anh đi xuống bếp,", "N"], [91.74, 92.65, "ngồi vô bàn,", "N"], [92.65, 93.88, "hai tay bưng chén,", "N"], [93.88, 94.86, "miệng lẩm bẩm.", "N"], [95.45, 98.7, "“Dạ… con về rồi má… con đói quá má ơi…”", "PH"], [99.88, 101.32, "Phúc mồ côi má từ nhỏ.", "N"], [101.32, 103.31, "Và anh chưa từng xưng con với ai", "N"], [103.31, 104.51, "bằng cái giọng đó.", "N"], [105.1, 107.55, "“Bà Sáu đâu có chết bệnh.”", "BA"], [107.55, 109.92, "“Hồi bả đau nằm một chỗ,”", "BA"], [109.92, 113.05, "“thằng Tư nhốt bả dưới bếp để bán”", "BA"], [113.05, 114.91, "“nhà. Bả chết đói,”", "BA"], [114.91, 117.25, "“tay còn ôm cái nồi cơm.”", "BA"], [117.92, 120.06, "“Bả đâu có ăn đồ cúng.”", "BA"], [120.06, 122.03, "“Bả nấu cơm chờ con.”", "BA"], [122.03, 123.92, "“Thằng Tư không về,”", "BA"], [123.92, 126.63, "“thì bả kiếm đứa khác thế vô.”", "BA"], [126.63, 129.66, "“Chồng con mà ăn hết chén cơm đó…”", "BA"], [129.66, 131.77, "“là ở lại với bả luôn.”", "BA"], [132.4, 134.39, "Liên lục lại tờ giấy mua bán,", "N"], [134.39, 135.74, "có địa chỉ ông Tư.", "N"], [135.74, 137.44, "Cô lên tận chợ Châu Đốc,", "N"], [137.44, 138.7, "quỳ xuống năn nỉ.", "N"], [139.29, 140.43, "“Tui không về đâu!”", "TU"], [140.43, 142.41, "“Đêm nào tui cũng nghe má tui kêu…”", "TU"], [142.41, 143.52, "“tui không dám về!”", "TU"], [144.18, 145.29, "Nhưng tới chiều,", "N"], [145.29, 146.82, "ông Tư vẫn đi theo Liên.", "N"], [146.82, 148.09, "Mặt ông trắng bệch,", "N"], [148.09, 149.17, "tay run lập cập.", "N"], [150.11, 152.38, "Nửa đêm, dưới bếp đèn dầu tự cháy.", "N"], [152.38, 153.83, "Phúc ngồi trong bàn,", "N"], [153.83, 155.75, "bưng chén cơm đưa lên miệng.", "N"], [155.75, 156.8, "Sau lưng anh,", "N"], [156.8, 159.39, "có một bà già ốm nhom đang đứng xới cơm.", "N"], [159.98, 165.73, "“Ăn đi con… ăn cho hết… rồi ở với má…”", "GS"], [168.66, 169.69, "Liên lao tới,", "N"], [169.69, 171.65, "giật cái chén khỏi tay chồng.", "N"], [171.65, 172.74, "Cơm đổ ra bàn.", "N"], [172.74, 174.06, "Đó không phải cơm.", "N"], [174.06, 175.04, "Là gạo sống,", "N"], [175.04, 176.04, "lẫn đầy giòi.", "N"], [176.98, 178.46, "Bà già từ từ quay lại.", "N"], [178.46, 179.66, "Hai mắt trắng dã,", "N"], [179.66, 180.86, "má hóp sát xương,", "N"], [180.86, 182.26, "miệng nhai nhóp nhép.", "N"], [183.37, 185.94, "“Má… con về rồi nè má… con xin lỗi má…”", "TU"], [186.6, 190.81, "“Tư hả con… Má chờ con lâu quá…”", "GS"], [190.81, 194.39, "“ngồi xuống ăn cơm với má…”", "GS"], [196.87, 198.28, "Cửa bếp đóng sầm.", "N"], [198.28, 200.46, "Liên kéo chồng chạy ra ngoài.", "N"], [200.46, 202.39, "Trong bếp, ông Tư la hét,", "N"], [202.39, 204.0, "đập cửa thình thịch.", "N"], [204.0, 206.24, "Tiếng la nhỏ dần… rồi tắt hẳn.", "N"], [206.24, 208.4, "Xa xa, gà gáy tiếng đầu tiên.", "N"], [209.34, 211.31, "Sáng ra, người ta phá cửa bếp.", "N"], [211.31, 213.0, "Ông Tư ngồi gục trên bàn,", "N"], [213.0, 214.63, "miệng nhét đầy gạo sống.", "N"], [214.63, 216.24, "Tay ôm chặt cái nồi cơm.", "N"], [216.83, 217.93, "Phúc khỏe lại.", "N"], [217.93, 219.43, "Từ đó, căn nhà im re.", "N"], [219.43, 221.77, "Mâm cúng để tới sáng vẫn còn nguyên.", "N"], [222.71, 224.53, "Cho tới đêm rằm tháng sau.", "N"], [224.53, 225.83, "Đúng ba giờ sáng,", "N"], [225.83, 228.01, "dưới bếp lại có tiếng nước chảy.", "N"], [228.01, 230.43, "Lần này… có hai giọng nói chuyện với", "N"], [230.43, 233.12, "nhau. Rồi giọng bà già cất lên, dịu dàng.", "N"], [234.21, 238.3, "“Liên ơi… xuống ăn cơm con… má dọn”", "GS"], [238.3, 240.96, "“sẵn ba cái chén rồi…”", "GS"], [244.71, 247.05, "Nếu mua nhà cũ mà nghe dưới bếp", "N"], [247.05, 250.2, "có người kêu ăn cơm… bạn có dám xuống không?", "N"], [251.14, 252.27, "Để lại bình luận,", "N"], [252.27, 254.51, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 9.798479166666667, 16.875375000000002, 19.686687500000005, 33.031958333333336, 37.42960416666667, 50.485937500000006, 58.936666666666675, 65.81470833333334, 77.97418750000001, 88.50820833333334, 95.42427083333334, 99.845625, 105.06995833333333, 117.86533333333333, 132.37020833333332, 139.26395833333333, 144.15104166666666, 150.07854166666664, 159.9497708333333, 168.62662499999996, 176.95302083333328, 183.31543749999994, 186.5537291666666, 196.83981249999994, 209.30543749999993, 216.79908333333327, 222.6764166666666, 234.17618749999994, 244.67968749999994, 251.10914583333326], "durs": [8.998479166666666, 6.226895833333334, 1.9613125, 12.845270833333334, 3.8976458333333333, 12.206333333333333, 7.950729166666667, 6.378041666666666, 11.659479166666667, 9.684020833333333, 6.4160625, 3.4213541666666667, 4.724333333333333, 12.295375, 14.004875, 6.393