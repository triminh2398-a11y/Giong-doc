3.9, 16.05, "Hai Lợi bán trái cây ở chợ Châu", "N"], [16.05, 17.72, "Đốc, nợ nần chồng chất.", "N"], [17.72, 18.91, "Vợ anh là Thắm,", "N"], [18.91, 20.31, "mê trồng cây kiểng.", "N"], [20.9, 22.86, "Đường cùng, Lợi lén lên núi Cấm,", "N"], [22.86, 23.82, "tìm thầy Bảy,", "N"], [23.82, 25.38, "người nuôi ngải có tiếng.", "N"], [25.97, 28.0, "Thầy đưa cho anh một chậu ngải.", "N"], [28.0, 29.85, "Lá dài, gân đỏ như mạch máu,", "N"], [29.85, 32.01, "củ dưới gốc phình lên như nắm tay.", "N"], [32.6, 34.85, "“Ngải này kêu khách cho mầy.”", "TB"], [34.85, 36.46, "“Nhưng nhớ ba điều.”", "TB"], [36.46, 39.26, "“Một... đêm rằm nào cũng phải nhỏ ba”", "TB"], [39.26, 41.61, "“giọt máu ngón giữa cho nó ăn.”", "TB"], [42.2, 45.21, "“Hai, hổng được để ai khác đụng vô”", "TB"], [45.21, 47.11, "“chậu, kể cả vợ con.”", "TB"], [47.11, 48.93, "“Ba... ngải mà đói,”", "TB"], [48.93, 51.78, "“nó giả tiếng người nhà kêu tên.”", "TB"], [51.78, 54.04, "“Ai dạ... nó ăn người đó!”", "TB"], [54.63, 57.53, "“Còn nữa... hổng được nói cho ai biết.”", "TB"], [57.53, 59.49, "“Nói ra là ngải mất linh.”", "TB"], [60.08, 61.58, "Từ bữa có chậu ngải,", "N"], [61.58, 64.16, "sạp trái cây của Lợi đông nghẹt khách.", "N"], [64.16, 65.93, "Nửa năm, anh trả sạch nợ.", "N"], [66.52, 67.44, "Đêm rằm nào,", "N"], [67.44, 69.02, "Lợi cũng đóng cửa buồng,", "N"], [69.02, 70.54, "nhỏ ba giọt máu vô gốc.", "N"], [70.54, 72.17, "Lá ngải rung lên khe khẽ,", "N"], [72.17, 73.17, "như đang nuốt.", "N"], [73.76, 75.86, "Thắm hỏi chậu gì mà lá đỏ đẹp", "N"], [75.86, 78.34, "vậy. Lợi chỉ nói là cây phong thủy,", "N"], [78.34, 79.36, "cấm đụng vô.", "N"], [79.95, 81.08, "“Anh Hai ơi,”", "TM"], [81.08, 83.36, "“cây đó đẻ thêm cây con kìa!”", "TM"], [83.36, 86.46, "“Để em tách ra trồng một chậu nhỏ nghen?”", "TM"], [87.05, 88.81, "“Đã nói đừng có đụng vô mà!”", "L"], [88.81, 89.8, "“Em nghe chưa?”", "L"], [90.39, 92.68, "Tháng đó, Lợi có mối hàng lớn trên", "N"], [92.68, 94.97, "Sài Gòn, người ta hẹn sáng sau đêm", "N"], [94.97, 96.17, "rằm mới ký giấy.", "N"], [96.76, 98.26, "Lợi nghĩ... trễ một đêm,", "N"], [98.26, 99.3, "chắc không sao.", "N"], [99.3, 100.04, "Anh ở lại.", "N"], [100.63, 102.29, "Đêm đó, Thắm ở nhà một mình.", "N"], [102.29, 103.14, "Gần nửa đêm,", "N"], [103.14, 105.31, "cô nghe tiếng chồng kêu từ trong buồng.", "N"], [106.25, 109.28, "“Thắm ơi... Thắm...”", "GL"], [109.28, 112.14, "“mở cửa cho anh...”", "GL"], [113.33, 114.8, "Thắm tưởng chồng về sớm,", "N"], [114.8, 115.81, "đi lối cửa sau.", "N"], [115.81, 117.27, "Cô bước tới cửa buồng...", "N"], [117.27, 118.3, "và dạ một tiếng.", "N"], [118.89, 121.54, "“Dạ... em ra liền nè anh Hai!”", "TM"], [122.73, 123.92, "Bên trong im bặt.", "N"], [123.92, 125.49, "Rồi có tiếng sột soạt...", "N"], [125.49, 127.53, "như rễ cây đang bò trên nền gạch.", "N"], [128.47, 129.76, "Sáng hôm sau Lợi về.", "N"], [129.76, 130.74, "Thắm nằm liệt,", "N"], [130.74, 131.72, "người gầy rộc,", "N"], [131.72, 132.6, "môi tím tái.", "N"], [132.6, 134.1, "Còn chậu ngải xanh mướt,", "N"], [134.1, 135.82, "đâm thêm một chồi đỏ như máu.", "N"], [136.41, 138.29, "Lợi gọi điện cho thầy Bảy.", "N"], [138.29, 140.51, "Đầu dây bên kia im lặng rất lâu.", "N"], [141.1, 143.07, "“Nó nếm máu vợ mầy rồi.”", "TB"], [143.07, 145.76, "“Muốn cứu, đêm nay ôm chậu trả về”", "TB"], [145.76, 147.29, "“chỗ cũ trên núi,”", "TB"], [147.29, 148.6, "“trước gà gáy.”", "TB"], [148.6, 150.35, "“Hổng được quay đầu,”", "TB"], [150.35, 152.14, "“hổng được dạ ai hết!”", "TB"], [152.73, 155.27, "“Và nhớ... nó lấy của nhà mầy bao”", "TB"], [155.27, 158.19, "“nhiêu máu, mầy phải trả lại bấy nhiêu.”", "TB"], [158.78, 160.94, "Đêm đó, Lợi ôm chậu ngải leo núi", "N"], [160.94, 162.29, "Cấm. Càng lên cao,", "N"], [162.29, 163.46, "chậu càng nặng,", "N"], [163.46, 165.06, "như ôm một đứa con nít.", "N"], [165.65, 167.72, "Mấy sợi rễ trồi lên khỏi đất,", "N"], [167.72, 169.36, "quấn quanh cổ tay anh,", "N"], [169.36, 170.28, "đâm vô da.", "N"], [170.28, 171.55, "Máu anh rỉ ra...", "N"], [171.55, 173.23, "và cái chậu ấm dần lên.", "N"], [174.17, 175.46, "Tới lưng chừng núi,", "N"], [175.46, 177.79, "sau lưng anh vang lên tiếng bước chân.", "N"], [177.79, 179.44, "Rồi tiếng vợ anh, nhỏ nhẹ.", "N"], [180.38, 182.67, "“Anh Hai ơi...”", "GTM"], [182.67, 185.85, "“em đi theo anh nè...”", "GTM"], [185.85, 190.78, "“anh quay lại nhìn em một cái đi...”", "GTM"], [191.97, 193.68, "Lợi cắn môi tới bật máu.", "N"], [193.68, 194.86, "Không quay đầu.", "N"], [194.86, 197.35, "Không dạ. Tiếng bước chân bám sát gót", "N"], [197.35, 198.92, "anh, tới tận đỉnh núi.", "N"], [199.86, 201.09, "Dưới tảng đá lớn,", "N"], [201.09, 203.11, "chỗ ngải được bứng lên năm xưa,", "N"], [203.11, 204.91, "Lợi cào đất bằng tay không,", "N"], [204.91, 206.0, "đặt chậu xuống.", "N"], [206.59, 208.62, "Nhưng rễ ngải không chịu buông.", "N"], [208.62, 210.43, "Nó siết chặt ngón tay giữa,", "N"], [210.43, 212.83, "ngón tay đã nuôi nó bao nhiêu đêm rằm.", "N"], [213.77, 215.21, "Phía đông đã ửng sáng.", "N"], [215.21, 216.33, "Lợi nghiến răng,", "N"], [216.33, 217.77, "rút con dao đi rừng...", "N"], [217.77, 219.66, "và bỏ lại ngón tay đó cho ngải.", "N"], [220.6, 221.81, "Gà rừng gáy vang.", "N"], [221.81, 224.1, "Tiếng bước chân sau lưng anh tắt lịm.", "N"], [224.69, 225.73, "Lợi về tới nhà,", "N"], [225.73, 227.3, "bàn tay quấn giẻ đẫm máu.", "N"], [227.3, 228.71, "Thắm đã ngồi dậy được,", "N"], [228.71, 229.78, "má hồng trở lại.", "N"], [230.37, 233.05, "“Anh Hai... anh đi đâu mà tay chảy”", "TM"], [233.05, 234.18, "“máu vầy nè?”", "TM"], [234.18, 236.9, "“Em nằm mơ thấy ác mộng quá trời...”", "TM"], [237.49, 238.32, "Lợi ôm vợ,", "N"], [238.32, 240.77, "khóc ròng. Anh tưởng mọi chuyện đã xong.", "N"], [241.71, 243.59, "Tối đó, đi ngang đầu giường,", "N"], [243.59, 244.67, "Lợi khựng lại.", "N"], [244.67, 246.37, "Ở đó có một chậu cây nhỏ.", "N"], [246.37, 248.22, "Lá dài, gân đỏ như mạch máu.", "N"], [248.81, 250.75, "“Cây con hôm bữa đó anh.”", "TM"], [250.75, 252.55, "“Em lén tách ra trồng,”", "TM"], [252.55, 255.09, "“thấy đẹp nên để đầu giường luôn.”", "TM"], [256.03, 257.05, "Lợi lạnh toát.", "N"], [257.05, 258.44, "Chậu ngải lớn đã trả.", "N"], [258.44, 260.1, "Nhưng chậu ngải con này...", "N"], [260.1, 261.01, "chưa ai trả,", "N"], [261.01, 262.21, "và chưa ai cho ăn.", "N"], [263.15, 264.74, "Nửa đêm, Thắm ngủ say,", "N"], [264.74, 266.32, "quay lưng về phía Lợi.", "N"], [266.32, 267.79, "Rồi sát bên tai anh,", "N"], [267.79, 269.29, "có tiếng vợ thì thầm.", "N"], [270.23, 275.84, "“Anh Hai... ơi... đói quá...”", "GTM"], [278.33, 279.55, "Lợi mệt rã rời,", "N"], [279.55, 280.95, "nửa mê nửa tỉnh...", "N"], [280.95, 282.57, "lỡ miệng dạ một tiếng.", "N"], [283.51, 284.43, "Sáng hôm sau,", "N"], [284.43, 286.41, "chậu ngải nhỏ đâm thêm một chồi đỏ", "N"], [286.41, 287.63, "như máu. Còn Lợi...", "N"], [287.63, 289.23, "không bao giờ thức dậy nữa.", "N"], [290.92, 292.99, "Nếu nửa đêm nghe người thân kêu tên", "N"], [292.99, 294.66, "mình... bạn có dám dạ không?", "N"], [295.6, 296.62, "Để lại bình luận,", "N"], [296.62, 298.63, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 6.9981875, 11.189041666666666, 13.874520833333333, 20.867395833333333, 25.940895833333332, 32.5749375, 42.171437499999996, 54.604458333333326, 60.054958333333325, 66.48893749999999, 73.72652083333332, 79.9173125, 87.01785416666667, 90.35689583333334, 96.728125, 100.6031875, 106.22447916666667, 113.3043125, 118.86449999999999, 122.69558333333332, 128.43797916666665, 136.38299999999998, 141.07010416666665, 152.70287499999998, 158.74747916666664, 165.62331249999997, 174.13629166666664, 180.3482083333333, 191.93535416666663, 199.82524999999995, 206.55733333333328, 213.73924999999994, 220.5686041666666, 224.6573541666666, 230.33720833333328, 237.4579791666666, 241.6843541666666, 248.7765416666666, 256.00014583333325, 263.12014583333325, 270.1985624999999, 278.30139583333323, 283.48170833333324, 290.8876874999999, 295.57231249999995], "durs": [6.19