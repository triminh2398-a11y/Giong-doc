4.35, 16.5, "Hai Lợi bán trái cây ở chợ Châu", "N"], [16.5, 18.17, "Đốc, nợ nần chồng chất.", "N"], [18.17, 19.36, "Vợ anh là Thắm,", "N"], [19.36, 20.76, "mê trồng cây kiểng.", "N"], [21.5, 23.46, "Đường cùng, Lợi lén lên núi Cấm,", "N"], [23.46, 24.42, "tìm thầy Bảy,", "N"], [24.42, 25.98, "người nuôi ngải có tiếng.", "N"], [26.72, 28.75, "Thầy đưa cho anh một chậu ngải.", "N"], [28.75, 30.6, "Lá dài, gân đỏ như mạch máu,", "N"], [30.6, 32.76, "củ dưới gốc phình lên như nắm tay.", "N"], [33.5, 35.75, "“Ngải này kêu khách cho mầy.”", "TB"], [35.75, 37.36, "“Nhưng nhớ ba điều.”", "TB"], [37.36, 40.16, "“Một... đêm rằm nào cũng phải nhỏ ba”", "TB"], [40.16, 42.51, "“giọt máu ngón giữa cho nó ăn.”", "TB"], [43.25, 46.26, "“Hai, hổng được để ai khác đụng vô”", "TB"], [46.26, 48.16, "“chậu, kể cả vợ con.”", "TB"], [48.16, 49.98, "“Ba... ngải mà đói,”", "TB"], [49.98, 52.83, "“nó giả tiếng người nhà kêu tên.”", "TB"], [52.83, 55.09, "“Ai dạ... nó ăn người đó!”", "TB"], [55.83, 58.73, "“Còn nữa... hổng được nói cho ai biết.”", "TB"], [58.73, 60.69, "“Nói ra là ngải mất linh.”", "TB"], [61.43, 62.93, "Từ bữa có chậu ngải,", "N"], [62.93, 65.51, "sạp trái cây của Lợi đông nghẹt khách.", "N"], [65.51, 67.28, "Nửa năm, anh trả sạch nợ.", "N"], [68.02, 68.94, "Đêm rằm nào,", "N"], [68.94, 70.52, "Lợi cũng đóng cửa buồng,", "N"], [70.52, 72.04, "nhỏ ba giọt máu vô gốc.", "N"], [72.04, 73.67, "Lá ngải rung lên khe khẽ,", "N"], [73.67, 74.67, "như đang nuốt.", "N"], [75.41, 77.51, "Thắm hỏi chậu gì mà lá đỏ đẹp", "N"], [77.51, 79.99, "vậy. Lợi chỉ nói là cây phong thủy,", "N"], [79.99, 81.01, "cấm đụng vô.", "N"], [81.75, 82.88, "“Anh Hai ơi,”", "TM"], [82.88, 85.16, "“cây đó đẻ thêm cây con kìa!”", "TM"], [85.16, 88.26, "“Để em tách ra trồng một chậu nhỏ nghen?”", "TM"], [89.0, 90.76, "“Đã nói đừng có đụng vô mà!”", "L"], [90.76, 91.75, "“Em nghe chưa?”", "L"], [92.49, 94.78, "Tháng đó, Lợi có mối hàng lớn trên", "N"], [94.78, 97.07, "Sài Gòn, người ta hẹn sáng sau đêm", "N"], [97.07, 98.27, "rằm mới ký giấy.", "N"], [99.01, 100.51, "Lợi nghĩ... trễ một đêm,", "N"], [100.51, 101.55, "chắc không sao.", "N"], [101.55, 102.29, "Anh ở lại.", "N"], [103.03, 104.69, "Đêm đó, Thắm ở nhà một mình.", "N"], [104.69, 105.54, "Gần nửa đêm,", "N"], [105.54, 107.71, "cô nghe tiếng chồng kêu từ trong buồng.", "N"], [108.8, 111.83, "“Thắm ơi... Thắm...”", "GL"], [111.83, 114.69, "“mở cửa cho anh...”", "GL"], [115.88, 117.35, "Thắm tưởng chồng về sớm,", "N"], [117.35, 118.36, "đi lối cửa sau.", "N"], [118.36, 119.82, "Cô bước tới cửa buồng...", "N"], [119.82, 120.85, "và dạ một tiếng.", "N"], [121.59, 124.24, "“Dạ... em ra liền nè anh Hai!”", "TM"], [125.43, 126.62, "Bên trong im bặt.", "N"], [126.62, 128.19, "Rồi có tiếng sột soạt...", "N"], [128.19, 130.23, "như rễ cây đang bò trên nền gạch.", "N"], [131.32, 132.61, "Sáng hôm sau Lợi về.", "N"], [132.61, 133.59, "Thắm nằm liệt,", "N"], [133.59, 134.57, "người gầy rộc,", "N"], [134.57, 135.45, "môi tím tái.", "N"], [135.45, 136.95, "Còn chậu ngải xanh mướt,", "N"], [136.95, 138.67, "đâm thêm một chồi đỏ như máu.", "N"], [139.41, 141.29, "Lợi gọi điện cho thầy Bảy.", "N"], [141.29, 143.51, "Đầu dây bên kia im lặng rất lâu.", "N"], [144.25, 146.22, "“Nó nếm máu vợ mầy rồi.”", "TB"], [146.22, 148.91, "“Muốn cứu, đêm nay ôm chậu trả về”", "TB"], [148.91, 150.44, "“chỗ cũ trên núi,”", "TB"], [150.44, 151.75, "“trước gà gáy.”", "TB"], [151.75, 153.5, "“Hổng được quay đầu,”", "TB"], [153.5, 155.29, "“hổng được dạ ai hết!”", "TB"], [156.03, 158.57, "“Và nhớ... nó lấy của nhà mầy bao”", "TB"], [158.57, 161.49, "“nhiêu máu, mầy phải trả lại bấy nhiêu.”", "TB"], [162.23, 164.39, "Đêm đó, Lợi ôm chậu ngải leo núi", "N"], [164.39, 165.74, "Cấm. Càng lên cao,", "N"], [165.74, 166.91, "chậu càng nặng,", "N"], [166.91, 168.51, "như ôm một đứa con nít.", "N"], [169.25, 171.32, "Mấy sợi rễ trồi lên khỏi đất,", "N"], [171.32, 172.96, "quấn quanh cổ tay anh,", "N"], [172.96, 173.88, "đâm vô da.", "N"], [173.88, 175.15, "Máu anh rỉ ra...", "N"], [175.15, 176.83, "và cái chậu ấm dần lên.", "N"], [177.92, 179.21, "Tới lưng chừng núi,", "N"], [179.21, 181.54, "sau lưng anh vang lên tiếng bước chân.", "N"], [181.54, 183.19, "Rồi tiếng vợ anh, nhỏ nhẹ.", "N"], [184.28, 186.57, "“Anh Hai ơi...”", "GTM"], [186.57, 189.75, "“em đi theo anh nè...”", "GTM"], [189.75, 194.68, "“anh quay lại nhìn em một cái đi...”", "GTM"], [195.87, 197.58, "Lợi cắn môi tới bật máu.", "N"], [197.58, 198.76, "Không quay đầu.", "N"], [198.76, 201.25, "Không dạ. Tiếng bước chân bám sát gót", "N"], [201.25, 202.82, "anh, tới tận đỉnh núi.", "N"], [203.91, 205.14, "Dưới tảng đá lớn,", "N"], [205.14, 207.16, "chỗ ngải được bứng lên năm xưa,", "N"], [207.16, 208.96, "Lợi cào đất bằng tay không,", "N"], [208.96, 210.05, "đặt chậu xuống.", "N"], [210.79, 212.82, "Nhưng rễ ngải không chịu buông.", "N"], [212.82, 214.63, "Nó siết chặt ngón tay giữa,", "N"], [214.63, 217.03, "ngón tay đã nuôi nó bao nhiêu đêm rằm.", "N"], [218.12, 219.56, "Phía đông đã ửng sáng.", "N"], [219.56, 220.68, "Lợi nghiến răng,", "N"], [220.68, 222.12, "rút con dao đi rừng...", "N"], [222.12, 224.01, "và bỏ lại ngón tay đó cho ngải.", "N"], [225.1, 226.31, "Gà rừng gáy vang.", "N"], [226.31, 228.6, "Tiếng bước chân sau lưng anh tắt lịm.", "N"], [229.34, 230.38, "Lợi về tới nhà,", "N"], [230.38, 231.95, "bàn tay quấn giẻ đẫm máu.", "N"], [231.95, 233.36, "Thắm đã ngồi dậy được,", "N"], [233.36, 234.43, "má hồng trở lại.", "N"], [235.17, 237.85, "“Anh Hai... anh đi đâu mà tay chảy”", "TM"], [237.85, 238.98, "“máu vầy nè?”", "TM"], [238.98, 241.7, "“Em nằm mơ thấy ác mộng quá trời...”", "TM"], [242.44, 243.27, "Lợi ôm vợ,", "N"], [243.27, 245.72, "khóc ròng. Anh tưởng mọi chuyện đã xong.", "N"], [246.81, 248.69, "Tối đó, đi ngang đầu giường,", "N"], [248.69, 249.77, "Lợi khựng lại.", "N"], [249.77, 251.47, "Ở đó có một chậu cây nhỏ.", "N"], [251.47, 253.32, "Lá dài, gân đỏ như mạch máu.", "N"], [254.06, 256.0, "“Cây con hôm bữa đó anh.”", "TM"], [256.0, 257.8, "“Em lén tách ra trồng,”", "TM"], [257.8, 260.34, "“thấy đẹp nên để đầu giường luôn.”", "TM"], [261.43, 262.45, "Lợi lạnh toát.", "N"], [262.45, 263.84, "Chậu ngải lớn đã trả.", "N"], [263.84, 265.5, "Nhưng chậu ngải con này...", "N"], [265.5, 266.41, "chưa ai trả,", "N"], [266.41, 267.61, "và chưa ai cho ăn.", "N"], [268.7, 270.29, "Nửa đêm, Thắm ngủ say,", "N"], [270.29, 271.87, "quay lưng về phía Lợi.", "N"], [271.87, 273.34, "Rồi sát bên tai anh,", "N"], [273.34, 274.84, "có tiếng vợ thì thầm.", "N"], [275.93, 281.54, "“Anh Hai... ơi... đói quá...”", "GTM"], [284.03, 285.15, "Lợi mệt rã rời,", "N"], [285.15, 286.44, "mơ mơ màng màng...", "N"], [286.44, 288.04, "buột miệng dạ một tiếng.", "N"], [289.13, 290.04, "Sáng hôm sau,", "N"], [290.04, 292.02, "chậu ngải nhỏ đâm thêm một chồi đỏ", "N"], [292.02, 293.25, "như máu. Còn Lợi...", "N"], [293.25, 294.84, "không bao giờ thức dậy nữa.", "N"], [296.53, 298.6, "Nếu nửa đêm nghe người thân kêu tên", "N"], [298.6, 300.28, "mình... bạn có dám dạ không?", "N"], [301.37, 302.39, "Để lại bình luận,", "N"], [302.39, 304.4, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 7.148187500000001, 11.489041666666667, 14.324520833333334, 21.467395833333335, 26.690895833333332, 33.474937499999996, 43.22143749999999, 55.80445833333332, 61.40495833333332, 67.98893749999999, 75.37652083333333, 81.7173125, 88.96785416666668, 92.45689583333336, 98.97812500000003, 103.00318750000004, 108.77447916666671, 115.85431250000003, 121.56450000000004, 125.39558333333336, 131.2879791666667, 139.38300000000004, 144.22010416666672, 156.00287500000005, 162.1974791666667, 169.22331250000005, 177.88629166666672, 184.2482083333334, 195.83535416666672, 203.87525000000005, 210.75733333333338, 218.08925000000005, 225.06860416666672, 229.30735416666673, 235.1372083333334, 242.40797916666673, 246.78435416666673, 254.02654166666673, 261.4001458333334, 268.6701458333334, 275.8985625, 284.00139583333333, 289.0965625, 296.5025416666667, 3