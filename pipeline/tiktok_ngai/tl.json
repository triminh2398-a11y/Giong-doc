[13.9, 16.11, "Lợi bán trái cây ở chợ Châu Đốc,", "N"], [16.11, 17.48, "nợ nần chồng chất.", "N"], [17.48, 18.68, "Vợ anh là Thắm,", "N"], [18.68, 20.08, "mê trồng cây kiểng.", "N"], [20.67, 22.63, "Đường cùng, Lợi lén lên núi Cấm,", "N"], [22.63, 23.59, "tìm thầy Bảy,", "N"], [23.59, 25.15, "người nuôi ngải có tiếng.", "N"], [25.74, 27.77, "Thầy đưa cho anh một chậu ngải.", "N"], [27.77, 29.62, "Lá dài, gân đỏ như mạch máu,", "N"], [29.62, 31.78, "củ dưới gốc phình lên như nắm tay.", "N"], [32.37, 34.62, "“Ngải này kêu khách cho mầy.”", "TB"], [34.62, 36.23, "“Nhưng nhớ ba điều.”", "TB"], [36.23, 39.03, "“Một... đêm rằm nào cũng phải nhỏ ba”", "TB"], [39.03, 41.38, "“giọt máu ngón giữa cho nó ăn.”", "TB"], [41.97, 44.98, "“Hai, hổng được để ai khác đụng vô”", "TB"], [44.98, 46.88, "“chậu, kể cả vợ con.”", "TB"], [46.88, 48.7, "“Ba... ngải mà đói,”", "TB"], [48.7, 51.55, "“nó giả tiếng người nhà kêu tên.”", "TB"], [51.55, 53.81, "“Ai dạ... nó ăn người đó!”", "TB"], [54.4, 57.3, "“Còn nữa... hổng được nói cho ai biết.”", "TB"], [57.3, 59.26, "“Nói ra là ngải mất linh.”", "TB"], [59.85, 61.35, "Từ bữa có chậu ngải,", "N"], [61.35, 63.93, "sạp trái cây của Lợi đông nghẹt khách.", "N"], [63.93, 65.7, "Nửa năm, anh trả sạch nợ.", "N"], [66.29, 67.21, "Đêm rằm nào,", "N"], [67.21, 68.79, "Lợi cũng đóng cửa buồng,", "N"], [68.79, 70.31, "nhỏ ba giọt máu vô gốc.", "N"], [70.31, 71.94, "Lá ngải rung lên khe khẽ,", "N"], [71.94, 72.94, "như đang nuốt.", "N"], [73.53, 75.63, "Thắm hỏi chậu gì mà lá đỏ đẹp", "N"], [75.63, 78.11, "vậy. Lợi chỉ nói là cây phong thủy,", "N"], [78.11, 79.13, "cấm đụng vô.", "N"], [79.72, 80.84, "“Anh Lợi ơi,”", "TM"], [80.84, 83.07, "“cây đó đẻ thêm cây con kìa!”", "TM"], [83.07, 86.12, "“Để em tách ra trồng một chậu nhỏ nghen?”", "TM"], [86.71, 88.47, "“Đã nói đừng có đụng vô mà!”", "L"], [88.47, 89.46, "“Em nghe chưa?”", "L"], [90.05, 92.34, "Tháng đó, Lợi có mối hàng lớn trên", "N"], [92.34, 94.63, "Sài Gòn, người ta hẹn sáng sau đêm", "N"], [94.63, 95.83, "rằm mới ký giấy.", "N"], [96.42, 97.92, "Lợi nghĩ... trễ một đêm,", "N"], [97.92, 98.96, "chắc không sao.", "N"], [98.96, 99.71, "Anh ở lại.", "N"], [100.3, 101.95, "Đêm đó, Thắm ở nhà một mình.", "N"], [101.95, 102.8, "Gần nửa đêm,", "N"], [102.8, 104.98, "cô nghe tiếng chồng kêu từ trong buồng.", "N"], [105.92, 108.94, "“Thắm ơi... Thắm...”", "GL"], [108.94, 111.81, "“mở cửa cho anh...”", "GL"], [113.0, 114.46, "Thắm tưởng chồng về sớm,", "N"], [114.46, 115.47, "đi lối cửa sau.", "N"], [115.47, 116.94, "Cô bước tới cửa buồng...", "N"], [116.94, 117.97, "và dạ một tiếng.", "N"], [118.56, 121.03, "“Dạ... em ra liền nè anh Lợi!”", "TM"], [122.22, 123.42, "Bên trong im bặt.", "N"], [123.42, 124.99, "Rồi có tiếng sột soạt...", "N"], [124.99, 127.03, "như rễ cây đang bò trên nền gạch.", "N"], [127.97, 129.26, "Sáng hôm sau Lợi về.", "N"], [129.26, 130.24, "Thắm nằm liệt,", "N"], [130.24, 131.22, "người gầy rộc,", "N"], [131.22, 132.1, "môi tím tái.", "N"], [132.1, 133.59, "Còn chậu ngải xanh mướt,", "N"], [133.59, 135.32, "đâm thêm một chồi đỏ như máu.", "N"], [135.91, 137.79, "Lợi gọi điện cho thầy Bảy.", "N"], [137.79, 140.01, "Đầu dây bên kia im lặng rất lâu.", "N"], [140.6, 142.56, "“Nó nếm máu vợ mầy rồi.”", "TB"], [142.56, 145.26, "“Muốn cứu, đêm nay ôm chậu trả về”", "TB"], [145.26, 146.79, "“chỗ cũ trên núi,”", "TB"], [146.79, 148.1, "“trước gà gáy.”", "TB"], [148.1, 149.85, "“Hổng được quay đầu,”", "TB"], [149.85, 151.64, "“hổng được dạ ai hết!”", "TB"], [152.23, 154.77, "“Và nhớ... nó lấy của nhà mầy bao”", "TB"], [154.77, 157.68, "“nhiêu máu, mầy phải trả lại bấy nhiêu.”", "TB"], [158.27, 160.44, "Đêm đó, Lợi ôm chậu ngải leo núi", "N"], [160.44, 161.78, "Cấm. Càng lên cao,", "N"], [161.78, 162.95, "chậu càng nặng,", "N"], [162.95, 164.56, "như ôm một đứa con nít.", "N"], [165.15, 167.22, "Mấy sợi rễ trồi lên khỏi đất,", "N"], [167.22, 168.86, "quấn quanh cổ tay anh,", "N"], [168.86, 169.77, "đâm vô da.", "N"], [169.77, 171.05, "Máu anh rỉ ra...", "N"], [171.05, 172.72, "và cái chậu ấm dần lên.", "N"], [173.66, 174.96, "Tới lưng chừng núi,", "N"], [174.96, 177.29, "sau lưng anh vang lên tiếng bước chân.", "N"], [177.29, 178.94, "Rồi tiếng vợ anh, nhỏ nhẹ.", "N"], [179.88, 182.15, "“Anh Lợi ơi...”", "GTM"], [182.15, 185.31, "“em đi theo anh nè...”", "GTM"], [185.31, 190.21, "“anh quay lại nhìn em một cái đi...”", "GTM"], [191.4, 193.12, "Lợi cắn môi tới bật máu.", "N"], [193.12, 194.3, "Không quay đầu.", "N"], [194.3, 196.79, "Không dạ. Tiếng bước chân bám sát gót", "N"], [196.79, 198.35, "anh, tới tận đỉnh núi.", "N"], [199.29, 200.53, "Dưới tảng đá lớn,", "N"], [200.53, 202.55, "chỗ ngải được bứng lên năm xưa,", "N"], [202.55, 204.34, "Lợi cào đất bằng tay không,", "N"], [204.34, 205.44, "đặt chậu xuống.", "N"], [206.03, 208.06, "Nhưng rễ ngải không chịu buông.", "N"], [208.06, 209.87, "Nó siết chặt ngón tay giữa,", "N"], [209.87, 212.27, "ngón tay đã nuôi nó bao nhiêu đêm rằm.", "N"], [213.21, 214.66, "Phía đông đã ửng sáng.", "N"], [214.66, 215.8, "Lợi nghiến răng,", "N"], [215.8, 216.99, "giật mạnh tay ra.", "N"], [216.99, 218.28, "Rễ ngải đứt phựt...", "N"], [218.28, 220.33, "nhưng ngón tay giữa của anh thì ở", "N"], [220.33, 221.54, "lại dưới gốc ngải.", "N"], [222.48, 223.7, "Gà rừng gáy vang.", "N"], [223.7, 225.98, "Tiếng bước chân sau lưng anh tắt lịm.", "N"], [226.57, 227.62, "Lợi về tới nhà,", "N"], [227.62, 229.18, "bàn tay quấn giẻ đẫm máu.", "N"], [229.18, 230.59, "Thắm đã ngồi dậy được,", "N"], [230.59, 231.66, "má hồng trở lại.", "N"], [232.25, 235.02, "“Anh Lợi... anh đi đâu mà tay chảy”", "TM"], [235.02, 236.18, "“máu vầy nè?”", "TM"], [236.18, 238.99, "“Em nằm mơ thấy ác mộng quá trời...”", "TM"], [239.58, 240.41, "Lợi ôm vợ,", "N"], [240.41, 242.87, "khóc ròng. Anh tưởng mọi chuyện đã xong.", "N"], [243.81, 245.68, "Tối đó, đi ngang đầu giường,", "N"], [245.68, 246.76, "Lợi khựng lại.", "N"], [246.76, 248.47, "Ở đó có một chậu cây nhỏ.", "N"], [248.47, 250.31, "Lá dài, gân đỏ như mạch máu.", "N"], [250.9, 252.84, "“Cây con hôm bữa đó anh.”", "TM"], [252.84, 254.65, "“Em lén tách ra trồng,”", "TM"], [254.65, 257.18, "“thấy đẹp nên để đầu giường luôn.”", "TM"], [258.12, 259.14, "Lợi lạnh toát.", "N"], [259.14, 260.53, "Chậu ngải lớn đã trả.", "N"], [260.53, 262.19, "Nhưng chậu ngải con này...", "N"], [262.19, 263.1, "chưa ai trả,", "N"], [263.1, 264.3, "và chưa ai cho ăn.", "N"], [265.24, 266.83, "Nửa đêm, Thắm ngủ say,", "N"], [266.83, 268.42, "quay lưng về phía Lợi.", "N"], [268.42, 269.89, "Rồi sát bên tai anh,", "N"], [269.89, 271.38, "có tiếng vợ thì thầm.", "N"], [272.32, 277.77, "“Anh Lợi... ơi... đói quá...”", "GTM"], [280.26, 281.48, "Lợi mệt rã rời,", "N"], [281.48, 282.88, "nửa mê nửa tỉnh...", "N"], [282.88, 284.5, "lỡ miệng dạ một tiếng.", "N"], [285.44, 286.35, "Sáng hôm sau,", "N"], [286.35, 288.33, "chậu ngải nhỏ đâm thêm một chồi đỏ", "N"], [288.33, 289.55, "như máu. Còn Lợi...", "N"], [289.55, 291.15, "không bao giờ thức dậy nữa.", "N"], [292.84, 294.91, "Nếu nửa đêm nghe người thân kêu tên", "N"], [294.91, 296.59, "mình... bạn có dám dạ không?", "N"], [297.53, 298.55, "Để lại bình luận,", "N"], [298.55, 300.56, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 6.9981875, 11.189041666666666, 13.874520833333333, 20.637395833333333, 25.710895833333332, 32.3449375, 41.9414375, 54.37445833333334, 59.824958333333335, 66.2589375, 73.49652083333334, 79.6873125, 86.68214583333334, 90.0211875, 96.39241666666666, 100.26747916666666, 105.88877083333333, 112.96860416666665, 118.52879166666665, 122.19297916666665, 127.93537499999998, 135.88039583333332, 140.5675, 152.20027083333332, 158.24487499999998, 165.1207083333333, 173.63368749999998, 179.84560416666665, 191.3737083333333, 199.26360416666662, 205.99568749999995, 213.1776041666666, 222.45281249999994, 226.54156249999994, 232.2214166666666, 239.55268749999993, 243.77906249999992, 250.87124999999992, 258.0948541666666, 265.2148541666666, 272.2932708333333, 280.2257083333333, 