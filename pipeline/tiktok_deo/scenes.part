// ================= cảnh: CHUYẾN XE CUỐI ĐÈO =================
const S={};let ctaFlag=false,BLACK=0,TITLE=false,RED=0,RAIN=0,FLASH=0,NOW=0,CCTV=0;
const JUMPS=[['title',0.02,0.4,1],['face',0.3,0.45,1]];
const SOFT=[['spk',0.2,0.25,0]];
const TK=sp=>{for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a&&NOW<b)return Math.sin(NOW*14)>-0.2?'o':undefined}return undefined};
const flick=T=>0.85+0.15*Math.sin(T*11)*Math.sin(T*3.7);
// vị trí chuẩn trong cabin
const KH=[-0.55,0.05],HN=[0.55,0.05];
const inCab=(T,o={})=>{cabReset();put(C.khoa,KH[0],KH[1],Object.assign({sit:true,drive:true,eyes:1,T},o.K||{}),0);put(C.hanh,HN[0],HN[1],Object.assign({sit:true,a:0.95,open:0.2},o.H||{}),0);cabAnim(T,o.spd||1)};
const hideH=()=>{C.hanh.visible=false};
const rd=T=>{RAIN=0.5};
// ---- mở đầu: SÁNG, không hù ----
S.hook=(lt,D,T)=>{CUR='pas';pasMode('dusk');const p=sm(lt/D);truckAt(1.4,0,lerp(-16,-3,p),0);put(C.hanh,-1.6,-4.2,{a:0.9,wave:true,open:0.15,glow:0.5,T},0);cm([lerp(-1.8,-0.6,p),1.5,6],[0.2,1.0,-5],lerp(52,46,p));return 'pas'};
S.hook2=(lt,D,T)=>{CUR='cab';inCab(T,{H:{open:0.1,look:-1},K:{eyes:1.05,look:1}});cHemi.intensity=1.5;cDome.intensity=3.4;cab.background.set(0x4a5c7c);cab.fog.color.set(0x4a5c7c);cab.fog.density=0.02;cm([0.1,1.2,lerp(3.4,3.0,sm(lt/D))],[0,0.9,0],46);return 'cab'};
S.title=(lt,D,T)=>{CUR='pas';pasMode('dusk');TITLE=true;truckAt(1.2,0,lerp(-5,-1,sm(lt/D)),0);cm([-1.6,1.4,4.6],[0.6,1.0,-1.5],48);return 'pas'};
S.intro=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.35;const p=sm(lt/D);truckAt(1.5,0,lerp(12,-12,p),Math.PI);cm([-8.5,2.4,lerp(5,-5,p)],[0.8,1.2,lerp(8,-8,p)],40);return 'pas'};
S.wave=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.35;const p=sm(lt/D);truckAt(1.3,0,lerp(8,3.2,p),Math.PI);put(C.hanh,-2.5,-2.0,{a:0.95,wave:true,open:0.15,glow:0.6,T},0);pCold.intensity=2.5;pCold.position.set(-2.0,1.4,-0.5);cm([-6.2,1.9,lerp(8,6.6,p)],[-1.2,1.0,-1.2],48);return 'pas'};
S.ask=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.3;truckAt(1.3,0,0.6,Math.PI);put(C.hanh,-1.2,0.4,{a:0.95,open:0.25,mouth:TK('GT'),glow:0.6,T},0);pCold.intensity=2.2;pCold.position.set(-0.8,1.4,2.4);close(C.hanh,lerp(1.5,1.2,sm(lt/D)),38,0.25);return 'pas'};
S.ride=(lt,D,T)=>{CUR='cab';inCab(T);RAIN=0;cm([lerp(0.9,0.3,sm(lt/D)),1.2,lerp(3.6,3.0,sm(lt/D))],[0,0.9,0],46);return 'cab'};
S.face=(lt,D,T)=>{CUR='cab';inCab(T,{K:{eyes:lt>D*0.3?1.45:1,pupil:lt>D*0.3?1.8:undefined,sweat:lt>D*0.3?1:undefined},H:{open:lt>D*0.3?0.6:0.2,look:lt>D*0.3?0:-1,tilt:lt>D*0.3?0.1:0}});cCold.intensity=lt>D*0.3?3:0;if(lt<D*0.3){cm([0.1,1.2,3.2],[0,0.9,0],46);return 'cab'}close(C.hanh,lerp(1.6,1.2,sm(seg(lt,D*0.3,D))),36,0.1);return 'cab'};
S.fear=(lt,D,T)=>{CUR='cab';inCab(T,{spd:2,K:{eyes:1.4,pupil:2,sweat:1},H:{open:0.15}});cCold.intensity=1.6;const sh=0.01*Math.sin(T*40);cm([0.35+sh,1.2,lerp(3.0,2.5,sm(lt/D))],[-0.3,0.95,0],46);return 'cab'};
S.curve=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.4;const p=sm(lt/D);truckAt(lerp(0.8,3.0,p),0,lerp(6,-0.6,p),Math.PI-lerp(0,1.15,sm(seg(lt,D*0.3,D))));cm([-2.4,2.0,lerp(7,3.6,p)],[lerp(1,3,p),0.9,lerp(2,-0.6,p)],50);return 'pas'};
S.brake=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.3;const p=sm(lt/D);truckAt(3.55,0,-0.5,Math.PI-1.15,lerp(0,0.2,sm(seg(lt,0,D*0.4))));cm([lerp(0.2,0.9,p),2.2,2.8],[5.6,-2.6,-1.4],56);return 'pas'};
S.spk=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.25;truckAt(3.55,0,-0.5,Math.PI-1.15,0.2);put(C.hanh,5.4,-3.4,{a:0.95,open:0.3+0.2*Math.max(0,Math.sin(T*7)),mouth:TK('GT'),glow:0.7,T},0.3);pCold.intensity=3.5;pCold.position.set(5.2,1.8,-1.4);const q=sm(lt/D);cm([5.5,1.5,lerp(-0.2,-0.9,q)],[5.4,1.2,-3.4],36);return 'pas'};
S.light=(lt,D,T)=>{CUR='pas';pasMode('night');pas.fog.density=0.008;pHemi.intensity=2.4;RAIN=0.2;truckAt(3.55,0,-0.5,Math.PI-1.15,0.2);HELM.material.emissiveIntensity=2.2;pFill.intensity=18;pFill.distance=10;pFill.position.set(5.6,-6.6,1.2);const p=sm(lt/D);cm([lerp(3.4,5.2,p),lerp(1.2,0.2,p),lerp(0.9,0.8,p)],[6.4,-7.6,-0.1],lerp(46,32,p));return 'pas'};
S.back=(lt,D,T)=>{CUR='pas';pasMode('night');RAIN=0.25;const p=sm(lt/D);truckAt(lerp(3.55,1.6,p),0,lerp(-0.5,0.7,p),Math.PI-lerp(1.15,0.2,p),lerp(0.2,0,sm(seg(lt,0.3,D*0.8))));cm([-3.2,1.8,-3.6],[1.8,0.8,0.3],50);return 'pas'};
S.dawn=(lt,D,T)=>{CUR='pas';pasMode('dawn');truckAt(1.5,0,-6,Math.PI);put(C.sau,-3.0,-0.2,{eyes:1,T},0);put(C.khoa,-1.9,0.2,{eyes:1.1,look:-1,T},0);const p=sm(lt/D);cm([lerp(-0.2,-0.8,p),1.5,lerp(4.6,3.8,p)],[-3.0,1.0,-1.8],lerp(46,42,p));return 'pas'};
S.os1=(lt,D,T)=>{CUR='pas';pasMode('dawn');put(C.sau,-3.0,-0.2,{eyes:1,mouth:TK('OS'),T},0);put(C.khoa,-1.9,0.3,{eyes:1.1,look:-1,T},0);close(C.sau,lerp(1.5,1.2,sm(lt/D)),38,0.2);return 'pas'};
S.os2=(lt,D,T)=>{CUR='pas';pasMode('dawn');put(C.sau,-3.0,-0.2,{eyes:1.05,mouth:TK('OS'),point:lt>D*0.4,T},0);put(C.khoa,-1.9,0.3,{eyes:1.2,look:-1,T},0);if(lt<D*0.5){close(C.sau,1.2,38,-0.2);return 'pas'}cm([-1.6,1.4,2.4],[-3.0,1.1,-0.2],44);return 'pas'};
S.down=(lt,D,T)=>{CUR='pas';pasMode('dawn');truckAt(1.2,0,-7,Math.PI);put(C.sau,3.0,-1.6,{point:true,eyes:1,T},0);put(C.khoa,2.8,0.0,{eyes:1.1,look:1,T},0);put(C.x1,2.9,-3.2,{eyes:1,T},0);put(C.x2,2.8,1.6,{eyes:1,T},0);const p=sm(lt/D);cm([lerp(0.2,1.0,p),1.7,lerp(4.4,3.4,p)],[3.8,lerp(0.9,-0.4,p),-0.8],50);return 'pas'};
S.mother=(lt,D,T)=>{CUR='mod';modDay();put(C.lua,2.6,0.2,{helmet:true,tears:true,eyes:1.05,T},0);put(C.khoa,3.7,0.5,{eyes:1,look:-1,T},0);cm([3.1,1.4,lerp(4.4,3.4,sm(lt/D))],[3.1,1.0,0.3],44);return 'mod'};
S.end=(lt,D,T)=>{CUR='pas';pasMode('dawn');AMSL.intensity=1.6;put(C.sau,-2.6,3.6,{incense:true,eyes:1,T},0);put(C.lua,-1.5,4.0,{eyes:1,tears:true,T},0);put(C.khoa,-0.8,3.8,{eyes:1,look:-1,T},0);truckAt(1.5,0,-2,Math.PI);cm([lerp(-0.4,-1.0,sm(lt/D)),1.4,8.4],[-2.2,0.9,3.4],42);return 'pas'};
S.end2=(lt,D,T)=>{CUR='pas';pasMode('dusk');const p=sm(lt/D);truckAt(0.9,0,lerp(-10,4,p),0);cm([-2.6,1.6,lerp(7,3,p)],[0.4,1.0,-1],46);return 'pas'};
S.cta=(lt,D,T)=>{CUR='pas';pasMode('dusk');ctaFlag=true;truckAt(1.0,0,-4,0);cm([-1.8,1.5,6],[0.6,1.0,-3],48);return 'pas'};
S.cta2=S.cta;
// ===== LỚP CHUYỂN ĐỘNG CHUNG (áp cho mọi cảnh) =====
const HSH=s=>{let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))%9973;return h/9973};
const SPK={sau:'OS',hanh:'GT'};const STILL={};
const speaking=(kk)=>{const sp=SPK[kk];if(!sp)return false;for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a-0.05&&NOW<b+0.15)return true}return false};
const GHOST={hanh:1};
function startleAt(t){let best=-1;for(const [jk,jf] of JUMPS.concat(SOFT)){const q=TLD.scenes.find(x=>x[0]===jk);if(!q)continue;const d=t-(q[1]+(q[2]-q[1])*jf);if(d>=0&&d<0.7)best=d}return best}
function motionPre(kk,c,t){if(STILL[kk]){c.userData.o0=c.userData.o;return}const o=Object.assign({},c.userData.o);const h=HSH(kk);
 if(!GHOST[kk]&&!o.back){const per=3.2+h*1.6,u=(t+h*7)%per;if(u<0.13&&(o.eyes===undefined||o.eyes>0.3))o.eyes=0.05}
 if(speaking(kk)&&!o.pot&&!o.phone&&!o.phoneLap&&!o.point&&!o.sit&&!o.back){const g=-0.18-0.22*Math.max(0,Math.sin(t*2.6+h*5));
  if(kk==='lua'){const a=(o.arm||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.arm=a}}else{const a=(o.armA||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.armA=a}}}
 if(!GHOST[kk]&&!speaking(kk)&&o.walk===undefined&&o.phase===undefined&&!o.jar&&!o.pot&&!o.clutch&&!o.bell&&!o.ears&&!o.cover&&!o.sit&&!o.back&&!o.hoe){const sw=0.05*Math.sin(t*1.1+h*7);if(kk==='lua'){const ar=(o.arm||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.12+sw;if(ar[1]===undefined)ar[1]=0.12+sw;o.arm=ar}else if(kk==='khoa'||kk==='sau'){const ar=(o.armA||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.1+sw;if(ar[1]===undefined)ar[1]=0.1+sw;o.armA=ar}}
 if(o.walk!==undefined&&(kk==='lua')&&!o.pot){const a=(o.arm||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.32*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.32*Math.sin(o.walk);o.arm=a}
 c.userData.o0=c.userData.o;c.userData.o=o}
function motionPost(kk,c,t){if(STILL[kk]){c.userData.o=c.userData.o0;return}const h=HSH(kk);
 if(c.userData.o&&c.userData.o.crawl){c.rotateZ(1.3);}
 if(GHOST[kk]){c.position.y+=0.03*Math.sin(t*1.2+h*6);c.rotateZ(0.03*Math.sin(t*0.6+h*3));}
 else{const br=0.012*Math.sin(t*2.2+h*9);c.position.x+=0.012*Math.sin(t*0.7+h*5);c.scale.set(1,1+br,1);c.position.y+=0.98*br;c.rotateZ(0.012*Math.sin(t*0.9+h*4));
  if(speaking(kk))c.rotateZ(0.02*Math.sin(t*5.5+h));
  const d=startleAt(t);if(d>=0){const k=1-d/0.7;c.position.x+=0.035*Math.sin(d*55)*k;c.scale.y*=1-0.03*k}}
 c.userData.o=c.userData.o0}
// ================= vòng vẽ =================
function rain(a){g2.save();g2.strokeStyle=`rgba(180,200,230,${0.35*a})`;g2.lineWidth=1.6;for(let i=0;i<140;i++){const x=(R(i)*RW*1.2+NOW*60)%(RW*1.2)-RW*0.1,y=(R(i+300)*RH+NOW*1800*(0.8+R(i+7)*0.4))%RH;g2.beginPath();g2.moveTo(x,y);g2.lineTo(x-6,y+38);g2.stroke()}g2.restore()}
window.draw=function(t){NOW=t;const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;CCTV=0;BLACK=0;TITLE=false;RED=0;RAIN=0;FLASH=0;blkA.scale.set(1.25,1,0.8);g2.clearRect(0,0,RW,RH);
 CC.inn.loi.castShadow=true;
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set(1.4+(R(i+5)-0.5)*7,0.3+((R(i+9)*2.5+t*0.05)%2.5),-2.4+p*4);m.material.opacity=0.3*Math.sin(p*Math.PI)});
 smoke.forEach((s,i)=>{const p=(t*0.15+i/12)%1;s.position.set(1.2+Math.sin(p*6+i)*0.06,2.3+p*0.9,-2.35);s.scale.setScalar(0.08+p*0.3);s.material.opacity=0.18*Math.sin(p*Math.PI)});
 riceWind(t);JAR_E.visible=false;JAR_I.visible=false;foundL.intensity=0;HANDS.forEach(h=>h.visible=false);eSun.intensity=0;eMist.forEach((m,i)=>{const z=4+i*0.7;const x=((R(i)*20+t*0.12)%20)-10;m.position.set(x,0.6+R(i+2)*0.5,z)});
 mist.forEach((m,i)=>{const z=6-i*0.6;const x=((R(i)*14+t*0.15)%14)-7;m.position.set(x,H(x,z)+0.5+R(i+2)*0.6,z)});
 if(!S[k])console.log('missing',k);const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 let JF=-1;for(const [jk,jf,jz,hard] of JUMPS.concat(SOFT)){const sc2=TLD.scenes.find(q=>q[0]===jk);if(!sc2)continue;const tj=sc2[1]+(sc2[2]-sc2[1])*jf,dt=t-tj;if(dt<0||dt>1.4)continue;const z=dt<0.1?dt/0.1*jz:jz*Math.max(0,1-(dt-0.1)/1.3);const tv=new THREE.Vector3(...CT);cam.position.lerp(tv,z);if(hard&&dt<0.5){const a2=0.05*(1-dt/0.5);cam.position.x+=(R(t*977)-0.5)*a2*2;cam.position.y+=(R(t*631)-0.5)*a2*2}cam.lookAt(tv);if(hard)JF=dt}
 for(const kk in CC[mode]){const c=CC[mode][kk];if(!c.visible){c.scale.set(1,1,1);continue}motionPre(kk,c,t);c.userData.paint(t);c.scale.set(1,1,1);c.lookAt(cam.position.x,c.position.y,cam.position.z);motionPost(kk,c,t)}
 renderer.render(SCN[mode],cam);renderer.domElement.style.filter=CCTV?"grayscale(1) contrast(1.35) brightness(1.2)":"";
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.18)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(RAIN)rain(RAIN);
 if(FLASH){g2.fillStyle=`rgba(220,230,255,${FLASH})`;g2.fillRect(0,0,RW,RH)}
 if(RED){g2.fillStyle=`rgba(140,0,0,${RED})`;g2.fillRect(0,0,RW,RH)}
 if(JF>=0&&JF<0.3){if(JF<0.06){g2.fillStyle='rgba(255,255,255,.55)';g2.fillRect(0,0,RW,RH)}else{g2.fillStyle=`rgba(160,0,0,${0.35*(1-JF/0.3)})`;g2.fillRect(0,0,RW,RH)}}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
