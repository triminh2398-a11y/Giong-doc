{"dur": 268.49, "scenes": [["hook", 0, 9.228, [0.3]], ["hook2", 9.228, 14.939, [0.2]], ["title", 14.939, 17.63, [0.2]], ["buy", 17.63, 29.234, [0.2]], ["hung", 29.234, 33.176, [0.2]], ["hung1", 33.176, 45.6, [0.2]], ["water", 45.6, 53.362, [0.2]], ["check", 53.362, 64.331, [0.2]], ["cam", 64.331, 75.675, [0.2]], ["offer", 75.675, 85.942, [0.2]], ["bowls", 85.942, 96.007, [0.2]], ["su1", 96.007, 100.596, [0.2]], ["su", 100.596, 108.813, [0.2]], ["hung2", 108.813, 121.056, [0.2]], ["hung3", 121.056, 134.37, [0.2]], ["find", 134.37, 140.024, [0.2]], ["tu1", 140.024, 145.611, [0.2]], ["tu2", 145.611, 153.078, [0.2]], ["night", 153.078, 164.446, [0.2]], ["gs", 164.446, 172.965, [0.2]], ["stop", 172.965, 181.514, [0.2]], ["turn", 181.514, 187.343, [0.2]], ["come", 187.343, 192.957, [0.2]], ["tu3", 192.957, 196.374, [0.2]], ["gs2", 196.374, 206.8, [0.2]], ["tu4", 206.8, 211.37, [0.2]], ["door", 211.37, 221.196, [0.2]], ["morning", 221.196, 228.984, [0.2]], ["end", 228.984, 234.407, [0.2]], ["end2", 234.407, 246.221, [0.2]], ["gs3", 246.221, 257.169, [0.2]], ["cta", 257.169, 268.494, [0.2, 6.32]]], "subs": [[0.33, 1.44, "Người ta nói,", "N"], [1.44, 3.84, "mua nhà cũ thì phải thắp nén nhang", "N"], [3.84, 5.14, "xin phép chủ cũ.", "N"], [5.14, 7.54, "Vì có những người chủ… chết rồi mà", "N"], [7.54, 8.87, "vẫn chưa chịu đi.", "N"], [9.46, 11.28, "Và nếu nửa đêm nghe dưới bếp có", "N"], [11.28, 13.35, "tiếng gọi ăn cơm… thì tuyệt đối đừng", "N"], [13.35, 14.23, "ngồi vào bàn.", "N"], [15.17, 16.92, "Câu chuyện hôm nay… Người chủ cũ.", "N"], [17.86, 19.09, "Vy làm văn phòng,", "N"], [19.09, 21.22, "một mình nuôi con gái nhỏ tên Su.", "N"], [21.22, 23.24, "Cô mua được căn nhà phố ba tầng", "N"], [23.24, 24.36, "giá rẻ bất ngờ.", "N"], [24.36, 25.88, "Người bán là anh Tuấn,", "N"], [25.88, 27.5, "ký giấy xong là đi ngay,", "N"], [27.5, 28.87, "không dám ngoái lại.", "N"], [29.46, 31.06, "Bác Hùng nhà bên sang chào,", "N"], [31.06, 32.82, "nhìn vào gian bếp rồi hạ giọng.", "N"], [33.43, 35.45, "“Nhà này của bà cụ Sáu.”", "HU"], [35.45, 37.39, "“Bà mất ngay dưới bếp.”", "HU"], [37.39, 40.0, "“Cháu nhớ thắp hương cho tử tế.”", "HU"], [40.0, 42.31, "“Đêm mà nghe bà gọi ăn cơm,”", "HU"], [42.31, 44.82, "“thì đừng ai ngồi vào bàn nhé.”", "HU"], [45.83, 46.75, "Đêm đầu tiên,", "N"], [46.75, 47.87, "đúng ba giờ sáng,", "N"], [47.87, 49.87, "dưới bếp có tiếng nước chảy ào ào.", "N"], [49.87, 51.45, "Rồi tiếng dao băm lộc cộc.", "N"], [51.45, 53.0, "Tiếng bát đĩa va vào nhau.", "N"], [53.59, 55.06, "Vy bật đèn đi xuống.", "N"], [55.06, 56.3, "Bếp không có ai.", "N"], [56.3, 57.95, "Vòi nước vẫn đang chảy,", "N"], [57.95, 59.59, "nước tràn khỏi bồn rửa,", "N"], [59.59, 60.89, "lênh láng ra sàn.", "N"], [60.89, 63.62, "Mà cái vòi… cô đã khóa chặt trước khi ngủ.", "N"], [64.56, 66.12, "Cô lắp camera trong bếp.", "N"], [66.12, 68.26, "Sáng hôm sau mở điện thoại xem lại.", "N"], [68.26, 69.18, "Ba giờ sáng,", "N"], [69.18, 71.11, "có một bà cụ tóc bạc đứng trước", "N"], [71.11, 72.23, "bồn rửa, vo gạo.", "N"], [72.23, 73.9, "Rồi bà từ từ quay đầu lại,", "N"], [73.9, 75.32, "nhìn thẳng vào camera.", "N"], [75.91, 77.73, "Vy sợ, ngày nào cũng cúng.", "N"], [77.73, 79.73, "Nhưng mâm cúng bày bao nhiêu,", "N"], [79.73, 81.67, "sáng ra sạch trơn bấy nhiêu.", "N"], [81.67, 83.61, "Nồi cơm điện bị vét tới đáy.", "N"], [83.61, 85.58, "Cúng bao nhiêu cũng không đủ.", "N"], [86.17, 87.31, "Rồi một sáng,", "N"], [87.31, 89.34, "trên bàn ăn có hai cái bát.", "N"], [89.34, 90.8, "Một bát cơm trắng,", "N"], [90.8, 92.19, "cắm đứng đôi đũa.", "N"], [92.19, 94.6, "Bát còn lại để trống… ngay chỗ bé", "N"], [94.6, 95.65, "Su hay ngồi.", "N"], [96.24, 97.7, "Bé Su bắt đầu ăn ít,", "N"], [97.7, 98.81, "người gầy rộc.", "N"], [98.81, 100.24, "Vy hỏi, con bé cười.", "N"], [100.83, 103.48, "“Đêm nào bà cũng gọi con xuống ăn”", "SU"], [103.48, 105.78, "“cơm. Bà bảo con ăn hết bát,”", "SU"], [105.78, 107.9, "“là được ở với bà mãi mãi.”", "SU"], [109.04, 111.41, "“Bà Sáu không chết bệnh đâu.”", "HU"], [111.41, 113.41, "“Hồi bà ốm liệt giường,”", "HU"], [113.41, 116.44, "“thằng Tuấn khóa trái bà trong bếp để”", "HU"], [116.44, 117.63, "“đi bán nhà.”", "HU"], [117.63, 118.88, "“Bà chết đói,”", "HU"], [118.88, 120.63, "“tay còn ôm nồi cơm.”", "HU"], [121.31, 123.22, "“Bà không ăn đồ cúng.”", "HU"], [123.22, 125.05, "“Bà nấu cơm chờ con.”", "HU"], [125.05, 126.96, "“Thằng Tuấn không về,”", "HU"], [126.96, 129.48, "“thì bà tìm đứa khác thế vào.”", "HU"], [129.48, 132.0, "“Con bé mà ăn hết bát cơm ấy…”", "HU"], [132.0, 133.96, "“là ở lại với bà luôn.”", "HU"], [134.6, 136.3, "Vy lục lại hợp đồng mua bán,", "N"], [136.3, 138.1, "tìm ra số điện thoại anh Tuấn.", "N"], [138.1, 139.66, "Cô gọi, kể hết mọi chuyện.", "N"], [140.25, 142.67, "“Là tôi… tôi nhốt má tôi… Đêm nào”", "TU"], [142.67, 145.2, "“tôi cũng nghe má gọi… tôi xin lỗi…”", "TU"], [145.84, 147.71, "Tuấn khóc nấc rồi cúp máy.", "N"], [147.71, 149.03, "Vy không hề biết,", "N"], [149.03, 150.05, "ngay đêm đó,", "N"], [150.05, 152.37, "anh đã một mình tìm về căn nhà cũ.", "N"], [153.31, 155.32, "Nửa đêm, đèn bếp chập chờn.", "N"], [155.32, 156.89, "Bé Su ngồi ở bàn ăn,", "N"], [156.89, 159.4, "hai tay bưng bát cơm đưa lên miệng.", "N"], [159.4, 160.72, "Sau lưng con bé,", "N"], [160.72, 162.98, "có một bà cụ gầy trơ xương đang", "N"], [162.98, 164.09, "đứng xới cơm.", "N"], [164.7, 170.39, "“Ăn đi con… ăn cho hết… rồi ở với bà…”", "GS"], [173.2, 174.17, "Vy lao tới,", "N"], [174.17, 176.07, "giật bát cơm khỏi tay con.", "N"], [176.07, 177.23, "Cơm đổ ra bàn.", "N"], [177.23, 178.63, "Đó không phải cơm.", "N"], [178.63, 179.67, "Là gạo sống,", "N"], [179.67, 180.8, "lúc nhúc giòi.", "N"], [181.74, 183.04, "Bà cụ từ từ quay lại.", "N"], [183.04, 184.13, "Hai mắt trắng dã,", "N"], [184.13, 185.22, "má hóp sát xương,", "N"], [185.22, 186.48, "miệng nhai nhóp nhép.", "N"], [187.57, 188.51, "Đúng lúc đó,", "N"], [188.51, 189.61, "cửa bếp bật mở.", "N"], [189.61, 190.59, "Tuấn đứng đó,", "N"], [190.59, 191.69, "mặt trắng bệch,", "N"], [191.69, 192.6, "run lẩy bẩy.", "N"], [193.21, 195.96, "“Má… con về rồi nè má… con xin lỗi má…”", "TU"], [196.62, 200.98, "“Tuấn hả con… Má chờ con lâu quá…”", "GS"], [200.98, 204.49, "“ngồi xuống ăn cơm với má…”", "GS"], [207.05, 208.93, "“Má tha cho con bé đi má… để”", "TU"], [208.93, 210.6, "“con ở lại ăn cơm với má…”", "TU"], [211.6, 213.42, "Tuấn đẩy hai mẹ con ra ngoài.", "N"], [213.42, 215.07, "Cửa bếp đóng sầm sau lưng.", "N"], [215.07, 217.26, "Bên trong vọng ra tiếng đũa chạm bát", "N"], [217.26, 219.66, "lách cách, tiếng Tuấn nghẹn ngào gọi má…", "N"], [219.66, 220.49, "rồi im bặt.", "N"], [221.43, 223.48, "Sáng ra, người ta phá cửa bếp.", "N"], [223.48, 225.25, "Tuấn ngồi gục bên bàn ăn,", "N"], [225.25, 226.95, "miệng nhét đầy gạo sống.", "N"], [226.95, 228.62, "Tay ôm chặt cái nồi cơm.", "N"], [229.21, 230.33, "Bé Su khỏe lại.", "N"], [230.33, 231.44, "Căn nhà im ắng.", "N"], [231.44, 233.7, "Mâm cúng để tới sáng vẫn còn nguyên.", "N"], [234.64, 235.84, "Cho tới một đêm,", "N"], [235.84, 237.1, "đúng ba giờ sáng,", "N"], [237.1, 238.41, "điện thoại Vy báo:", "N"], [238.41, 240.59, "camera bếp phát hiện chuyển động.", "N"], [240.59, 242.93, "Trong video, có hai người ngồi ở bàn", "N"], [242.93, 245.36, "ăn. Và một chiếc ghế… vừa được kéo ra.", "N"], [246.49, 250.8, "“Vy ơi… xuống ăn cơm cháu… bà dọn”", "GS"], [250.8, 253.56, "“sẵn ba cái bát rồi…”", "GS"], [257.4, 259.8, "Nếu nửa đêm camera nhà bạn quay được", "N"], [259.8, 262.57, "người lạ trong bếp… bạn có dám xuống không?", "N"], [263.51, 264.56, "Để lại bình luận,", "N"], [264.56, 266.63, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 9.427729166666667, 15.139479166666666, 17.829625, 29.43358333333333, 33.375729166666666, 45.80020833333334, 53.56222916666667, 64.53114583333333, 75.87527083333333, 86.14166666666667, 96.20725, 100.79595833333333, 109.01316666666666, 121.25583333333333, 134.5704375, 140.22366666666667, 145.8108125, 153.27829166