{"dur": 291.36, "scenes": [["hook", 0, 9.228, [0.3]], ["hook2", 9.228, 14.939, [0.2]], ["title", 14.939, 17.63, [0.2]], ["buy", 17.63, 28.495, [0.2]], ["hung", 28.495, 32.438, [0.2]], ["hung1", 32.438, 44.862, [0.2]], ["water", 44.862, 52.624, [0.2]], ["check", 52.624, 63.593, [0.2]], ["cam", 63.593, 74.937, [0.2]], ["offer", 74.937, 85.204, [0.2]], ["bowls", 85.204, 93.574, [0.2]], ["su1", 93.574, 100.185, [0.2]], ["cam2", 100.185, 110.679, [0.2]], ["hung2", 110.679, 122.922, [0.2]], ["hung3", 122.922, 135.752, [0.2]], ["find", 135.752, 141.405, [0.2]], ["tu1", 141.405, 146.992, [0.2]], ["tu2", 146.992, 156.844, [0.2]], ["night", 156.844, 167.912, [0.2]], ["gs", 167.912, 176.432, [0.2]], ["come", 176.432, 180.393, [0.2]], ["stop", 180.393, 187.919, [0.2]], ["turn", 187.919, 193.748, [0.2]], ["tu3", 193.748, 197.165, [0.2]], ["gs2", 197.165, 207.59, [0.2]], ["tu4", 207.59, 212.204, [0.2]], ["door", 212.204, 222.279, [0.2]], ["morning", 222.279, 232.73, [0.2]], ["end", 232.73, 238.618, [0.2]], ["end2", 238.618, 250.432, [0.2]], ["gs3", 250.432, 260.78, [0.2]], ["leave", 260.78, 269.473, [0.2]], ["leave2", 269.473, 280.033, [0.2]], ["cta", 280.033, 291.358, [0.2, 6.32]]], "subs": [[0.33, 1.44, "Người ta nói,", "N"], [1.44, 3.84, "mua nhà cũ thì phải thắp nén nhang", "N"], [3.84, 5.14, "xin phép chủ cũ.", "N"], [5.14, 7.54, "Vì có những người chủ… chết rồi mà", "N"], [7.54, 8.87, "vẫn chưa chịu đi.", "N"], [9.46, 11.28, "Và nếu nửa đêm nghe dưới bếp có", "N"], [11.28, 13.35, "tiếng gọi ăn cơm… thì tuyệt đối đừng", "N"], [13.35, 14.23, "ngồi vào bàn.", "N"], [15.17, 16.92, "Câu chuyện hôm nay… Người chủ cũ.", "N"], [17.86, 19.13, "Vy làm văn phòng,", "N"], [19.13, 20.23, "sống một mình.", "N"], [20.23, 22.32, "Cô mua được căn nhà phố ba tầng", "N"], [22.32, 23.48, "giá rẻ bất ngờ.", "N"], [23.48, 25.04, "Người bán là anh Tuấn,", "N"], [25.04, 26.72, "ký giấy xong là đi ngay,", "N"], [26.72, 28.14, "không dám ngoái lại.", "N"], [28.73, 30.32, "Bác Hùng nhà bên sang chào,", "N"], [30.32, 32.08, "nhìn vào gian bếp rồi hạ giọng.", "N"], [32.69, 34.71, "“Nhà này của bà cụ Sáu.”", "HU"], [34.71, 36.65, "“Bà mất ngay dưới bếp.”", "HU"], [36.65, 39.26, "“Cháu nhớ thắp hương cho tử tế.”", "HU"], [39.26, 41.57, "“Đêm mà nghe bà gọi ăn cơm,”", "HU"], [41.57, 44.08, "“thì đừng ai ngồi vào bàn nhé.”", "HU"], [45.09, 46.01, "Đêm đầu tiên,", "N"], [46.01, 47.14, "đúng ba giờ sáng,", "N"], [47.14, 49.13, "dưới bếp có tiếng nước chảy ào ào.", "N"], [49.13, 50.71, "Rồi tiếng dao băm lộc cộc.", "N"], [50.71, 52.26, "Tiếng bát đĩa va vào nhau.", "N"], [52.85, 54.32, "Vy bật đèn đi xuống.", "N"], [54.32, 55.56, "Bếp không có ai.", "N"], [55.56, 57.21, "Vòi nước vẫn đang chảy,", "N"], [57.21, 58.85, "nước tràn khỏi bồn rửa,", "N"], [58.85, 60.15, "lênh láng ra sàn.", "N"], [60.15, 62.88, "Mà cái vòi… cô đã khóa chặt trước khi ngủ.", "N"], [63.82, 65.38, "Cô lắp camera trong bếp.", "N"], [65.38, 67.53, "Sáng hôm sau mở điện thoại xem lại.", "N"], [67.53, 68.44, "Ba giờ sáng,", "N"], [68.44, 70.37, "có một bà cụ tóc bạc đứng trước", "N"], [70.37, 71.5, "bồn rửa, vo gạo.", "N"], [71.5, 73.16, "Rồi bà từ từ quay đầu lại,", "N"], [73.16, 74.58, "nhìn thẳng vào camera.", "N"], [75.17, 76.99, "Vy sợ, ngày nào cũng cúng.", "N"], [76.99, 78.99, "Nhưng mâm cúng bày bao nhiêu,", "N"], [78.99, 80.93, "sáng ra sạch trơn bấy nhiêu.", "N"], [80.93, 82.87, "Nồi cơm điện bị vét tới đáy.", "N"], [82.87, 84.84, "Cúng bao nhiêu cũng không đủ.", "N"], [85.43, 86.42, "Rồi một sáng,", "N"], [86.42, 88.16, "trên bàn ăn có hai cái bát.", "N"], [88.16, 89.42, "Một bát cơm trắng,", "N"], [89.42, 90.62, "cắm đứng đôi đũa.", "N"], [90.62, 93.21, "Bát còn lại để trống… ngay chỗ Vy hay ngồi.", "N"], [93.8, 94.95, "Từ đó, Vy ăn ít,", "N"], [94.95, 96.0, "người gầy rộc.", "N"], [96.0, 97.26, "Sáng nào thức dậy,", "N"], [97.26, 99.48, "miệng cô cũng dính đầy hạt gạo sống.", "N"], [100.42, 101.95, "Cô mở camera xem lại.", "N"], [101.95, 102.96, "Ba giờ sáng,", "N"], [102.96, 104.91, "chính cô đang ngồi ở bàn ăn,", "N"], [104.91, 106.09, "đối diện bà cụ,", "N"], [106.09, 107.87, "ngoan ngoãn bưng bát cơm.", "N"], [107.87, 110.32, "Vy hoảng loạn chạy sang nhà bác Hùng.", "N"], [110.91, 113.28, "“Bà Sáu không chết bệnh đâu.”", "HU"], [113.28, 115.28, "“Hồi bà ốm liệt giường,”", "HU"], [115.28, 118.31, "“thằng Tuấn khóa trái bà trong bếp để”", "HU"], [118.31, 119.5, "“đi bán nhà.”", "HU"], [119.5, 120.75, "“Bà chết đói,”", "HU"], [120.75, 122.5, "“tay còn ôm nồi cơm.”", "HU"], [123.17, 125.0, "“Bà không ăn đồ cúng.”", "HU"], [125.0, 126.77, "“Bà nấu cơm chờ con.”", "HU"], [126.77, 128.6, "“Thằng Tuấn không về,”", "HU"], [128.6, 131.17, "“thì bà tìm người khác thế vào.”", "HU"], [131.17, 133.66, "“Cháu mà ăn hết bát cơm ấy… là”", "HU"], [133.66, 135.32, "“ở lại với bà luôn.”", "HU"], [135.98, 137.68, "Vy lục lại hợp đồng mua bán,", "N"], [137.68, 139.48, "tìm ra số điện thoại anh Tuấn.", "N"], [139.48, 141.04, "Cô gọi, kể hết mọi chuyện.", "N"], [141.63, 144.05, "“Là tôi… tôi nhốt má tôi… Đêm nào”", "TU"], [144.05, 146.58, "“tôi cũng nghe má gọi… tôi xin lỗi…”", "TU"], [147.22, 149.11, "Tuấn khóc nấc rồi cúp máy.", "N"], [149.11, 150.45, "Vy không hề biết,", "N"], [150.45, 151.48, "ngay đêm đó,", "N"], [151.48, 153.91, "anh cầm chiếc chìa khóa cửa sau còn", "N"], [153.91, 156.13, "giữ, một mình tìm về căn nhà cũ.", "N"], [157.07, 159.47, "Nửa đêm, Vy lại mộng du xuống bếp.", "N"], [159.47, 160.76, "Cô ngồi vào bàn,", "N"], [160.76, 163.22, "hai tay bưng bát cơm đưa lên miệng.", "N"], [163.22, 164.26, "Sau lưng cô,", "N"], [164.26, 166.48, "có một bà cụ gầy trơ xương đang", "N"], [166.48, 167.55, "đứng xới cơm.", "N"], [168.16, 173.85, "“Ăn đi con… ăn cho hết… rồi ở với bà…”", "GS"], [176.66, 177.43, "Đúng lúc đó,", "N"], [177.43, 178.34, "cửa bếp bật mở.", "N"], [178.34, 179.16, "Tuấn lao vào,", "N"], [179.16, 180.03, "mặt trắng bệch.", "N"], [180.62, 182.79, "Anh hất văng bát cơm khỏi tay Vy.", "N"], [182.79, 183.87, "Cơm đổ ra bàn.", "N"], [183.87, 185.19, "Đó không phải cơm.", "N"], [185.19, 186.16, "Là gạo sống,", "N"], [186.16, 187.21, "lúc nhúc giòi.", "N"], [188.15, 189.44, "Bà cụ từ từ quay lại.", "N"], [189.44, 190.53, "Hai mắt trắng dã,", "N"], [190.53, 191.63, "má hóp sát xương,", "N"], [191.63, 192.89, "miệng nhai nhóp nhép.", "N"], [194.0, 196.75, "“Má… con về rồi nè má… con xin lỗi má…”", "TU"], [197.41, 201.77, "“Tuấn hả con… Má chờ con lâu quá…”", "GS"], [201.77, 205.28, "“ngồi xuống ăn cơm với má…”", "GS"], [207.82, 209.7, "“Má tha cho cô ấy đi má… để”", "TU"], [209.7, 211.43, "“con ở lại ăn cơm với má…”", "TU"], [212.43, 213.93, "Tuấn đẩy Vy ra ngoài.", "N"], [213.93, 215.72, "Cửa bếp đóng sầm sau lưng.", "N"], [215.72, 218.08, "Bên trong vọng ra tiếng đũa chạm bát", "N"], [218.08, 220.68, "lách cách, tiếng Tuấn nghẹn ngào gọi má…", "N"], [220.68, 221.57, "rồi im bặt.", "N"], [222.51, 224.75, "Sáng ra, cửa bếp bị khóa trái từ", "N"], [224.75, 227.06, "bên trong. Người ta phải phá cửa.", "N"], [227.06, 228.88, "Tuấn ngồi gục bên bàn ăn,", "N"], [228.88, 230.64, "miệng nhét đầy gạo sống.", "N"], [230.64, 232.37, "Tay ôm chặt cái nồi cơm.", "N"], [232.96, 234.19, "Vy hết mộng du.", "N"], [234.19, 235.42, "Căn nhà im ắng.", "N"], [235.42, 237.91, "Mâm cúng để tới sáng vẫn còn nguyên.", "N"], [238.85, 240.05, "Cho tới một đêm,", "N"], [240.05, 241.31, "đúng ba giờ sáng,", "N"], [241.31, 242.62, "điện thoại Vy báo:", "N"], [242.62, 244.8, "camera bếp phát hiện chuyển động.", "N"], [244.8, 247.14, "Trong video, có hai người ngồi ở bàn", "N"], [247.14, 249.57, "ăn. Và một chiếc ghế… vừa được kéo ra.", "N"], [250.7, 255.01, "“Vy ơi… xuống ăn cơm cháu… bà dọn”", "GS"], [255.01, 257.77, "“sẵn ba cái bát rồi…”", "GS"], [261.01, 262.35, "Ngay sáng hôm sau,", "N"], [262.35, 264.09, "Vy thu dọn đồ đạc dọn đi.", "N"], [264.09, 265.13, "Cô không bán,", "N"], [265.13, 266.99, "cũng không dám cho ai thuê.", "N"], [266.99, 268.76, "Căn nhà bị bỏ hoang từ đó.", "N"], [269.7, 271.06, "Người trong xóm kể,", "N"], [271.06, 272.54, "đêm đêm đi ngang qua,", "N"], [272.54, 274.07, "vẫn thấy đèn bếp sáng,", "N"], [274.07, 276.39, "và nghe tiếng bát đũa lách cách… như", "N"], [276.39, 278.17, "có cả nhà đang ngồi ăn cơm.", "N"], [280.26, 282.66, "Nếu nửa đêm camera nhà bạn quay được", "N"], [282.66, 285.44, "người lạ trong bếp… bạn có dám xuống không?", "N"], [286.38, 287.43, "Để lại bình luận,", "N"], [287.43, 289.5, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 9.427729166666667, 15.139479166666666, 17.829625, 28.695479166666665, 32.637625, 45.062104166666664, 52.824124999999995, 63.79304166666666, 75.13716666666666, 85.40356249999999, 93.77352083333332, 100.38547916666666, 110.87895833333332, 123.12162499999998, 135.9517708333333, 141.605, 147.1921458333333, 157.04437499999997, 168.11247916666665, 176.63220833333332, 180.59329166666666, 188.1189375, 193.94779166666666, 197.36475, 207.7904375, 212.40366666666665, 222.47910416666664, 232.92979166666663, 238.81768749999995, 250.63162499999996, 260.97964583333334, 269.6727916666667, 280.2326458333333, 286.3480625], "durs": [8.627729166666667, 4.86175, 1.8401458333333334, 10.365854166666667, 3.4421458333333335, 11.574479166666666, 7.262020833333334, 10.118916666666667, 10.844125, 9.766395833333334, 7.869958333333333, 5.761958333333333, 9.993479166666667, 11.742666666666667, 12.330145833333333, 5.153229166666667, 5.0871458333333335, 9.002229166666666, 10.568104166666666, 7.519729166666667, 3.4610833333333333, 6.675645833333333, 4.828854166666667, 2.9169583333333335, 9.4256875, 3.7632291666666666, 9.2254375, 9.9506875, 5.037895833333334, 10.8139375, 8.748020833333333, 7.843145833333334, 8.559854166666666, 5.265416666666667, 3.2096875], "lines": ["hook", "hook2", "title", "buy", "hung", "hung1", "water", "check", "cam", "offer", "bowls", "su1", "cam2", "hung2", "hung3", "find", "tu1", "tu2", "night", "gs", "come", "stop", "turn", "tu3", "gs2", "tu4", "door", "morning", "end", "end2", "gs3", "leave", "leave2", "cta", "ct