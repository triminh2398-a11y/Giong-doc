{"dur": 255.75, "scenes": [["hook", 0, 9.228, [0.3]], ["hook2", 9.228, 14.939, [0.2]], ["title", 14.939, 17.63, [0.2]], ["buy", 17.63, 29.234, [0.2]], ["hung", 29.234, 32.951, [0.2]], ["hung1", 32.951, 45.375, [0.2]], ["water", 45.375, 53.137, [0.2]], ["check", 53.137, 64.106, [0.2]], ["cam", 64.106, 75.45, [0.2]], ["offer", 75.45, 85.716, [0.2]], ["bowls", 85.716, 95.782, [0.2]], ["su1", 95.782, 100.723, [0.2]], ["su", 100.723, 108.342, [0.2]], ["hung2", 108.342, 120.584, [0.2]], ["hung3", 120.584, 133.634, [0.2]], ["find", 133.634, 140.158, [0.2]], ["tu1", 140.158, 145.338, [0.2]], ["tu2", 145.338, 151.319, [0.2]], ["night", 151.319, 162.686, [0.2]], ["gs", 162.686, 171.206, [0.2]], ["stop", 171.206, 179.259, [0.2]], ["turn", 179.259, 185.088, [0.2]], ["tu3", 185.088, 188.666, [0.2]], ["gs2", 188.666, 198.412, [0.2]], ["door", 198.412, 208.104, [0.2]], ["morning", 208.104, 215.892, [0.2]], ["end", 215.892, 221.66, [0.2]], ["end2", 221.66, 233.474, [0.2]], ["gs3", 233.474, 244.422, [0.2]], ["cta", 244.422, 255.747, [0.2, 6.32]]], "subs": [[0.33, 1.44, "Người ta nói,", "N"], [1.44, 3.84, "mua nhà cũ thì phải thắp nén nhang", "N"], [3.84, 5.14, "xin phép chủ cũ.", "N"], [5.14, 7.54, "Vì có những người chủ… chết rồi mà", "N"], [7.54, 8.87, "vẫn chưa chịu đi.", "N"], [9.46, 11.28, "Và nếu nửa đêm nghe dưới bếp có", "N"], [11.28, 13.35, "tiếng gọi ăn cơm… thì tuyệt đối đừng", "N"], [13.35, 14.23, "ngồi vào bàn.", "N"], [15.17, 16.92, "Câu chuyện hôm nay… Người chủ cũ.", "N"], [17.86, 19.09, "Vy làm văn phòng,", "N"], [19.09, 21.22, "một mình nuôi con gái nhỏ tên Su.", "N"], [21.22, 23.24, "Cô mua được căn nhà phố ba tầng", "N"], [23.24, 24.36, "giá rẻ bất ngờ.", "N"], [24.36, 25.88, "Người bán là anh Tuấn,", "N"], [25.88, 27.5, "ký giấy xong là đi ngay,", "N"], [27.5, 28.87, "không dám ngoái lại.", "N"], [29.46, 30.95, "Bác Hùng nhà bên sang chào,", "N"], [30.95, 32.59, "nhìn vào gian bếp rồi hạ giọng.", "N"], [33.2, 35.22, "“Nhà này của bà cụ Sáu.”", "HU"], [35.22, 37.16, "“Bà mất ngay dưới bếp.”", "HU"], [37.16, 39.77, "“Cháu nhớ thắp hương cho tử tế.”", "HU"], [39.77, 42.08, "“Đêm mà nghe bà gọi ăn cơm,”", "HU"], [42.08, 44.59, "“thì đừng ai ngồi vào bàn nhé.”", "HU"], [45.61, 46.52, "Đêm đầu tiên,", "N"], [46.52, 47.65, "đúng ba giờ sáng,", "N"], [47.65, 49.64, "dưới bếp có tiếng nước chảy ào ào.", "N"], [49.64, 51.22, "Rồi tiếng dao băm lộc cộc.", "N"], [51.22, 52.78, "Tiếng bát đĩa va vào nhau.", "N"], [53.37, 54.84, "Vy bật đèn đi xuống.", "N"], [54.84, 56.07, "Bếp không có ai.", "N"], [56.07, 57.72, "Vòi nước vẫn đang chảy,", "N"], [57.72, 59.37, "nước tràn khỏi bồn rửa,", "N"], [59.37, 60.66, "lênh láng ra sàn.", "N"], [60.66, 63.4, "Mà cái vòi… cô đã khóa chặt trước khi ngủ.", "N"], [64.34, 65.89, "Cô lắp camera trong bếp.", "N"], [65.89, 68.04, "Sáng hôm sau mở điện thoại xem lại.", "N"], [68.04, 68.95, "Ba giờ sáng,", "N"], [68.95, 70.88, "có một bà cụ tóc bạc đứng trước", "N"], [70.88, 72.01, "bồn rửa, vo gạo.", "N"], [72.01, 73.67, "Rồi bà từ từ quay đầu lại,", "N"], [73.67, 75.09, "nhìn thẳng vào camera.", "N"], [75.68, 77.5, "Vy sợ, ngày nào cũng cúng.", "N"], [77.5, 79.5, "Nhưng mâm cúng bày bao nhiêu,", "N"], [79.5, 81.45, "sáng ra sạch trơn bấy nhiêu.", "N"], [81.45, 83.39, "Nồi cơm điện bị vét tới đáy.", "N"], [83.39, 85.36, "Cúng bao nhiêu cũng không đủ.", "N"], [85.95, 87.09, "Rồi một sáng,", "N"], [87.09, 89.12, "trên bàn ăn có hai cái bát.", "N"], [89.12, 90.57, "Một bát cơm trắng,", "N"], [90.57, 91.97, "cắm đứng đôi đũa.", "N"], [91.97, 94.37, "Bát còn lại để trống… ngay chỗ bé", "N"], [94.37, 95.42, "Su hay ngồi.", "N"], [96.01, 97.6, "Bé Su bắt đầu ăn ít,", "N"], [97.6, 98.81, "người gầy rộc.", "N"], [98.81, 100.36, "Vy hỏi, con bé cười.", "N"], [100.95, 103.37, "“Đêm nào bà cũng gọi con xuống ăn”", "SU"], [103.37, 105.47, "“cơm. Bà bảo con ăn hết bát,”", "SU"], [105.47, 107.4, "“là được ở với bà mãi mãi.”", "SU"], [108.57, 110.94, "“Bà Sáu không chết bệnh đâu.”", "HU"], [110.94, 112.94, "“Hồi bà ốm liệt giường,”", "HU"], [112.94, 115.97, "“thằng Tuấn khóa trái bà trong bếp để”", "HU"], [115.97, 117.16, "“đi bán nhà.”", "HU"], [117.16, 118.41, "“Bà chết đói,”", "HU"], [118.41, 120.16, "“tay còn ôm nồi cơm.”", "HU"], [120.83, 122.7, "“Bà không ăn đồ cúng.”", "HU"], [122.7, 124.49, "“Bà nấu cơm chờ con.”", "HU"], [124.49, 126.36, "“Thằng Tuấn không về,”", "HU"], [126.36, 128.82, "“thì bà tìm đứa khác thế vào.”", "HU"], [128.82, 131.29, "“Con bé mà ăn hết bát cơm ấy…”", "HU"], [131.29, 133.2, "“là ở lại với bà luôn.”", "HU"], [133.86, 135.74, "Vy lục lại hợp đồng mua bán,", "N"], [135.74, 137.39, "tìm ra địa chỉ anh Tuấn.", "N"], [137.39, 138.52, "Cô đến tận nơi,", "N"], [138.52, 139.8, "quỳ xuống van xin.", "N"], [140.39, 141.61, "“Tôi không về đâu!”", "TU"], [141.61, 143.73, "“Đêm nào tôi cũng nghe má tôi gọi…”", "TU"], [143.73, 144.92, "“tôi không dám về!”", "TU"], [145.57, 146.78, "Nhưng tối hôm đó,", "N"], [146.78, 148.16, "Tuấn vẫn đi theo Vy.", "N"], [148.16, 149.48, "Mặt anh trắng bệch,", "N"], [149.48, 150.61, "tay run lẩy bẩy.", "N"], [151.55, 153.56, "Nửa đêm, đèn bếp chập chờn.", "N"], [153.56, 155.13, "Bé Su ngồi ở bàn ăn,", "N"], [155.13, 157.64, "hai tay bưng bát cơm đưa lên miệng.", "N"], [157.64, 158.96, "Sau lưng con bé,", "N"], [158.96, 161.22, "có một bà cụ gầy trơ xương đang", "N"], [161.22, 162.33, "đứng xới cơm.", "N"], [162.94, 168.63, "“Ăn đi con… ăn cho hết… rồi ở với bà…”", "GS"], [171.44, 172.35, "Vy lao tới,", "N"], [172.35, 174.12, "giật bát cơm khỏi tay con.", "N"], [174.12, 175.21, "Cơm đổ ra bàn.", "N"], [175.21, 176.52, "Đó không phải cơm.", "N"], [176.52, 177.49, "Là gạo sống,", "N"], [177.49, 178.55, "lúc nhúc giòi.", "N"], [179.49, 180.78, "Bà cụ từ từ quay lại.", "N"], [180.78, 181.87, "Hai mắt trắng dã,", "N"], [181.87, 182.97, "má hóp sát xương,", "N"], [182.97, 184.23, "miệng nhai nhóp nhép.", "N"], [185.34, 188.25, "“Má… con về rồi nè má… con xin lỗi má…”", "TU"], [188.92, 192.84, "“Tuấn hả con… Má chờ con lâu quá…”", "GS"], [192.84, 195.99, "“ngồi xuống ăn cơm với má…”", "GS"], [198.64, 200.0, "Cửa bếp đóng sầm.", "N"], [200.0, 201.8, "Vy ôm con chạy ra ngoài.", "N"], [201.8, 203.65, "Trong bếp, Tuấn gào thét,", "N"], [203.65, 205.2, "đập cửa thình thịch.", "N"], [205.2, 207.39, "Tiếng gào nhỏ dần… rồi tắt hẳn.", "N"], [208.33, 210.39, "Sáng ra, người ta phá cửa bếp.", "N"], [210.39, 212.15, "Tuấn ngồi gục bên bàn ăn,", "N"], [212.15, 213.86, "miệng nhét đầy gạo sống.", "N"], [213.86, 215.53, "Tay ôm chặt cái nồi cơm.", "N"], [216.12, 217.32, "Bé Su khỏe lại.", "N"], [217.32, 218.52, "Căn nhà im ắng.", "N"], [218.52, 220.95, "Mâm cúng để tới sáng vẫn còn nguyên.", "N"], [221.89, 223.09, "Cho tới một đêm,", "N"], [223.09, 224.35, "đúng ba giờ sáng,", "N"], [224.35, 225.67, "điện thoại Vy báo:", "N"], [225.67, 227.84, "camera bếp phát hiện chuyển động.", "N"], [227.84, 230.18, "Trong video, có hai người ngồi ở bàn", "N"], [230.18, 232.61, "ăn. Và một chiếc ghế… vừa được kéo ra.", "N"], [233.74, 238.05, "“Vy ơi… xuống ăn cơm cháu… bà dọn”", "GS"], [238.05, 240.81, "“sẵn ba cái bát rồi…”", "GS"], [244.65, 247.05, "Nếu nửa đêm camera nhà bạn quay được", "N"], [247.05, 249.83, "người lạ trong bếp… bạn có dám xuống không?", "N"], [250.77, 251.82, "Để lại bình luận,", "N"], [251.82, 253.89, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 9.427729166666667, 15.139479166666666, 17.829625, 29.43358333333333, 33.1505625, 45.57504166666667, 53.3370625, 64.30597916666666, 75.65010416666667, 85.9165, 95.98208333333334, 100.923125, 108.54179166666667, 120.78445833333333, 133.83425, 140.35847916666665, 145.53772916666665, 151.51852083333333, 162.88583333333332, 171.4055625, 179.459375, 185.28822916666667, 188.86554166666667, 198.611875, 208.30370833333333, 216.092125, 221.85977083333333, 233.67370833333334, 244.62172916666665, 250.7371458333333], "durs": [8.627729166666667, 4.86175, 1.8401458333333334, 11.103958333333333, 3.2169791666666665, 11.574479166666666, 7.262020833333334, 10.1