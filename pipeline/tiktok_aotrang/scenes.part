// ================= cảnh: ÁO TRẮNG QUA HANG (bản 3: ma giữ cửa hang) =================
const S={};let ctaFlag=false,BLACK=0,TITLE=false,RED=0,RAIN=0,FLASH=0,NOW=0,CCTV=0;
const JUMPS=[['face',0.15,0.45,1]];
const SOFT=[['drag',0.2,0.25,0],['p2',0.8,0.2,0]];
const TK=sp=>{for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a&&NOW<b)return Math.sin(NOW*14)>-0.2?'o':undefined}return undefined};
const flick=T=>0.85+0.15*Math.sin(T*11)*Math.sin(T*3.7);
function lcd(n,tot){g2.save();g2.strokeStyle='rgba(20,20,22,.95)';g2.lineWidth=60;g2.strokeRect(0,0,RW,RH);g2.strokeStyle='rgba(230,230,230,.8)';g2.lineWidth=2;g2.strokeRect(46,46,RW-92,RH-92);g2.fillStyle='#eaeaea';g2.font='bold 26px "DejaVu Sans"';g2.fillText('▶  '+n+(tot?'/'+tot:''),70,90);g2.fillText('INTERVAL 10s',RW-270,90);g2.restore()}
const egret=(T,x0,y0,z0,dx,fall)=>{CO.visible=true;const p=(T*0.25)%1;const x=x0+dx*p,y=y0-(fall?Math.max(0,p-0.5)*2*y0*0.95:0);CO.position.set(x,y,z0);CO.rotation.z=fall&&p>0.5?-0.9:0;const f=Math.sin(T*10)*(fall&&p>0.5?0.1:0.6);CO.userData['w-1'].rotation.y=f;CO.userData['w1'].rotation.y=-f};
const W={white:true};
const tripodView=()=>cm([0.8,1.25,2.5],[0,1.1,-2.6],44);
// ---- mở đầu: sáng, không hù ----
S.hook=(lt,D,T)=>{CUR='ban';banMode('day');ban.add(CO);const p=sm(lt/D);egret(T*0.6,-14,9,-18,20,false);cm([lerp(6,2,p),lerp(3.5,2.6,p),lerp(12,9,p)],[-6,3,-16],lerp(50,44,p));return 'ban'};
S.hook2=(lt,D,T)=>{CUR='hang';hangMode('day');hang.add(CO);const p=sm(lt/D);egret(lt/D*4,-5,4.2,-2.0,10,true);cm([0.4,1.6,lerp(9,7.5,p)],[0,2.8,-2.7],48);return 'hang'};
S.title=(lt,D,T)=>{CUR='hang';hangMode('day');TITLE=true;hmist(0.5,T);cm([0,1.4,lerp(6.5,5.6,sm(lt/D))],[0,2.2,-2.7],46);return 'hang'};
S.intro=(lt,D,T)=>{CUR='ban';banMode('day');CO.visible=false;put(C.linh,2.4,0.6,{camera:true,eyes:1,look:1,smileF:true,T},0);put(C.lang,3.6,0.3,{eyes:1,look:-1,T},0);const p=sm(lt/D);cm([lerp(0.6,1.6,p),1.5,lerp(5.4,4.4,p)],[3.0,1.4,-1.2],46);return 'ban'};
S.rule=(lt,D,T)=>{CUR='ban';banMode('day');put(C.linh,2.4,0.6,{camera:true,eyes:1.1,look:1,T},0);put(C.lang,3.6,0.3,{eyes:1.1,look:-1,armA:[undefined,lt>D*0.3?-1.6:undefined],T},0);put(C.x1,4.6,0.9,{eyes:1.2,T},0);put(C.x2,1.2,1.2,{eyes:1.2,T},0);cm([3.2,1.5,lerp(3.6,3.0,sm(lt/D))],[3.4,1.3,0.3],40);return 'ban'};
S.day1=(lt,D,T)=>{CUR='hang';hangMode('day');TRIPOD.visible=true;const p=sm(lt/D);put(C.linh,lerp(0.8,0.0,p),lerp(2.0,0.6,p),Object.assign({walk:p<0.9?T*5:undefined,eyes:1,smileF:true,T},W),0);cm([2.6,1.5,lerp(6.4,5.6,p)],[0.2,1.2,0],46);return 'hang'};
S.p1=(lt,D,T)=>{CUR='hang';hangMode('day');put(C.linh,1.0,0.6,Object.assign({eyes:1,smileF:true,T},W),0);put(C.mat,-0.3,-2.55,{a:lt>D*0.35?0.55:0,open:0.15,glow:0.3},0);tripodView();lcd(lt>D*0.35?847:12,1260);return 'hang'};
S.day2=(lt,D,T)=>{CUR='hang';hangMode('day');TRIPOD.visible=true;put(C.linh,0.0,lerp(0.6,-0.8,sm(lt/D)),Object.assign({walk:T*4,eyes:1,smileF:true,T},W),0);cm([-2.2,1.5,4.6],[0,1.2,-1],44);return 'hang'};
S.p2=(lt,D,T)=>{CUR='hang';hangMode('day');put(C.linh,1.1,-0.6,Object.assign({eyes:1,T},W),0);const k=Math.min(4,Math.floor(lt/D*5));const z=[-2.55,-2.3,-2.0,-1.7,-1.4][k];put(C.mat,[-0.3,-0.2,-0.1,0,0][k],z,{a:0.85,open:0.2+k*0.1,reach:k===4,glow:0.4},0);tripodView();lcd(310+k*47,1180);return 'hang'};
S.show=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);put(C.linh,-0.6,0.9,{camera:true,eyes:1,look:1,smileF:true,T},0);put(C.lang,0.9,0.7,{sit:true,eyes:lt>D*0.5?1.4:1,pupil:lt>D*0.5?2:undefined,look:-1,T},0);cm([0.2,1.4,lerp(4.2,3.6,sm(lt/D))],[0.3,0.9,0.6],46);return 'san'};
S.lang=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);put(C.lang,0.9,0.7,{sit:true,eyes:1.2,mouth:TK('LANG'),T},0);close(C.lang,lerp(1.4,1.2,sm(lt/D)),38,0.25,-0.3);return 'san'};
S.day3=(lt,D,T)=>{CUR='hang';hangMode('day');TRIPOD.visible=true;const p=sm(seg(lt,D*0.35,D));put(C.linh,lerp(0.5,0.1,p),lerp(1.8,-2.3,p),Object.assign({flash:1,walk:T*4,eyes:1,T},W),0);cm([2.4,1.6,5.6],[0,1.2,-1.6],44);return 'hang'};
S.inside=(lt,D,T)=>{CUR='tr';const q=lt/D;const lit=q<0.3?1:0;const fl=q>0.35?Math.max(0,1-(q-0.35)/0.45):0;put(C.linh,0,-3,Object.assign({flash:lit,lighter:!lit,flame:fl,eyes:1.3,pupil:2,sweat:1,T},W),0);flashL.intensity=lit*(q>0.2?(Math.sin(T*40)>0?14:2):14);flashL.position.set(0.3,1.2,-2.9);flashL.target.position.set(0.3,0.8,-7);lightL.intensity=fl*2.2;lightL.position.set(0.3,1.2,-2.8);gGlow.intensity=q>0.82?2*sm(seg(q,0.82,1)):0;gGlow.position.set(0,1.3,-5.4);tHemi.intensity=0.55;cm([0.9,1.35,-1.0],[0,1.1,-4],46);return 'tr'};
S.face=(lt,D,T)=>{CUR='tr';tHemi.intensity=0.5;put(C.mat,0,-4.2,{a:0.95,open:0.75,look:0,tilt:0.08},0.05);gGlow.intensity=3;gGlow.position.set(0,1.4,-3.4);put(C.linh,0.9,-2.9,Object.assign({eyes:1.45,pupil:2,T},W),0);if(lt<D*0.15){cm([1.6,1.35,-1.2],[0.3,1.2,-4],44)}else close(C.mat,lerp(1.3,1.0,sm(lt/D)),36,0.05,-0.05);return 'tr'};
S.gm=(lt,D,T)=>{CUR='tr';tHemi.intensity=0.5;put(C.mat,0,-4.2,{a:0.95,open:0.4+0.35*Math.max(0,Math.sin(T*6)),reach:true,mouth:TK('GM')},0.05);gGlow.intensity=3;gGlow.position.set(0,1.4,-3.4);close(C.mat,1.1,36,-0.1,-0.05);return 'tr'};
S.push=(lt,D,T)=>{CUR='tr';tHemi.intensity=0.5;const f=sm(seg(lt,D*0.4,D));put(C.mat,0.6,-4.6,{a:0.9,open:0.5,reach:true},0.05);gGlow.intensity=2.6;gGlow.position.set(0.4,1.4,-3.8);put(C.linh,lerp(-0.2,-0.3,f),-3.4,Object.assign({eyes:f>0.5?0.3:1.3,T,tilt:-f*1.2},W),-f*0.35);cm([1.4,1.3,-1.4],[0,0.8,-3.8],46);return 'tr'};
S.drag=(lt,D,T)=>{CUR='tr';const p=sm(lt/D);const z=lerp(-3.6,1.2,p);tHemi.intensity=0.5+p*0.6;sunIn.intensity=p*30;put(C.linh,0,z,Object.assign({eyes:0.2,crawl:true,T},W),-0.45);put(C.mat,0,z-0.75,{a:0.9,reach:true,open:0.2,look:0.2},0.05);gGlow.intensity=2.4;gGlow.position.set(0,1.3,z-0.2);cm([1.6,1.4,z+2.6],[0,0.7,z-0.4],46);return 'tr'};
S.wake=(lt,D,T)=>{CUR='hang';hangMode('day');TRIPOD.visible=true;const up=sm(seg(lt,D*0.4,D));put(C.linh,0.2,0.4,Object.assign({crawl:up<0.5,sit:up>=0.5,eyes:lerp(0.2,1,up),sick:true,T},W),up<0.5?-0.45:0);cm([-1.4,1.2,2.6],[0.2,0.5,0.4],42);return 'hang'};
S.cam=(lt,D,T)=>{CUR='hang';hangMode('day');const k=Math.min(3,Math.floor(lt/D*4));const z=[-2.4,-1.6,-0.8,0.2][k];put(C.linh,0.1,z,Object.assign({crawl:true,eyes:0.2,T},W),-0.45);if(k<3)put(C.mat,0.1,z-0.7,{a:0.85,reach:true,open:0.2},0.05);tripodView();lcd(2210+k,2213);return 'hang'};
S.lang2=(lt,D,T)=>{CUR='san';sanMode('day');put(C.lang,0.9,0.7,{sit:true,eyes:1,mouth:TK('LANG'),T},0);put(C.linh,-0.6,0.9,{sit:true,sick:true,eyes:1.1,look:1,T},0);if(lt<D*0.5)close(C.lang,1.3,38,0.25,-0.3);else cm([0.2,1.3,3.8],[0.2,0.8,0.7],48);return 'san'};
S.lang3=(lt,D,T)=>{CUR='san';sanMode('day');put(C.lang,0.9,0.7,{sit:true,eyes:1.05,mouth:TK('LANG'),T},0);put(C.linh,-0.6,0.9,{sit:true,sick:true,eyes:1.2,tears:lt>D*0.6,look:1,T},0);if(lt<D*0.6)close(C.lang,1.2,38,-0.2,-0.3);else close(C.linh,1.3,38,0.2,-0.3);return 'san'};
S.end=(lt,D,T)=>{CUR='hang';hangMode('day');const q=sm(lt/D);wall(lerp(0.3,1,q));put(C.linh,-1.0,-1.4,{eyes:1,T,arm:[-0.6,0.6]},0);put(C.x1,0.6,-1.5,{eyes:1,armA:[-0.6,0.6],T},0);put(C.x2,1.7,-1.3,{eyes:1,T},0);cm([0.6,1.6,lerp(4.4,3.6,q)],[0.2,1.1,-2.4],46);return 'hang'};
S.end2=(lt,D,T)=>{CUR='hang';hangMode('day');wall(1);CARVE.visible=true;const p=sm(lt/D);cm([lerp(-1.4,-2.6,p),2.0,lerp(4.4,2.6,p)],[-3.0,2.0,-2.7],lerp(48,40,p));return 'hang'};
S.cta=(lt,D,T)=>{CUR='hang';hangMode('dawn');wall(1);CARVE.visible=true;ctaFlag=true;hmist(0.3,T);cm([0,1.5,lerp(7,6,sm(lt/D))],[0,2.0,-2.7],46);return 'hang'};
S.cta2=S.cta;
// ===== LỚP CHUYỂN ĐỘNG CHUNG (áp cho mọi cảnh) =====
const HSH=s=>{let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))%9973;return h/9973};
const SPK={lang:'LANG',mat:'GM'};const STILL={};
const speaking=(kk)=>{const sp=SPK[kk];if(!sp)return false;for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a-0.05&&NOW<b+0.15)return true}return false};
const GHOST={mat:1};
function startleAt(t){let best=-1;for(const [jk,jf] of JUMPS.concat(SOFT)){const q=TLD.scenes.find(x=>x[0]===jk);if(!q)continue;const d=t-(q[1]+(q[2]-q[1])*jf);if(d>=0&&d<0.7)best=d}return best}
const GLITCH=(t,h)=>{const per=2.3+h*1.4,u=(t+h*11)%per;return u<0.09?(u<0.045?1:-1):0};
function motionPre(kk,c,t){if(STILL[kk]){c.userData.o0=c.userData.o;return}const o=Object.assign({},c.userData.o);const h=HSH(kk);
 if(!GHOST[kk]&&!o.back){const per=3.2+h*1.6,u=(t+h*7)%per;if(u<0.13&&(o.eyes===undefined||o.eyes>0.3))o.eyes=0.05}
 if(speaking(kk)&&!o.pot&&!o.phone&&!o.phoneLap&&!o.point&&!o.sit&&!o.back){const g=-0.18-0.22*Math.max(0,Math.sin(t*2.6+h*5));
  if(kk==='linh'){const a=(o.arm||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.arm=a}}else{const a=(o.armA||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.armA=a}}}
 if(!GHOST[kk]&&!speaking(kk)&&o.walk===undefined&&o.phase===undefined&&!o.jar&&!o.pot&&!o.clutch&&!o.bell&&!o.ears&&!o.cover&&!o.sit&&!o.back&&!o.hoe){const sw=0.05*Math.sin(t*1.1+h*7);if(kk==='linh'){const ar=(o.arm||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.12+sw;if(ar[1]===undefined)ar[1]=0.12+sw;o.arm=ar}else if(kk==='lang'||kk==='x1'){const ar=(o.armA||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.1+sw;if(ar[1]===undefined)ar[1]=0.1+sw;o.armA=ar}}
 if(o.walk!==undefined&&!o.pot){for(const key of ['arm','armA']){const a=(o[key]||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.34*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.34*Math.sin(o.walk);o[key]=a}}
 if(false&&o.walk!==undefined&&(kk==='linh')&&!o.pot){const a=(o.arm||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.32*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.32*Math.sin(o.walk);o.arm=a}
 c.userData.o0=c.userData.o;c.userData.o=o}
function motionPost(kk,c,t){const h=HSH(kk);const o=c.userData.o||{};
 if(o.crawl){c.rotateZ(1.3);}
 if(GHOST[kk]){const g=GLITCH(t,h);c.position.y+=0.03*Math.sin(t*1.2+h*6);c.rotateZ(0.04*Math.sin(t*0.5+h*3)+g*0.12);c.position.x+=g*0.05;c.material.opacity=0.7+0.06*Math.sin(t*23+h)*(g?1:0.3)}
 else{const br=0.012*Math.sin(t*2.2+h*9);c.position.x+=0.012*Math.sin(t*0.7+h*5);c.scale.set(1,1+br,1);c.position.y+=0.98*br;c.rotateZ(0.012*Math.sin(t*0.9+h*4));
  if(o.walk!==undefined){const b=Math.abs(Math.sin(o.walk));c.position.y+=0.035*b;c.scale.y*=1-0.015*b;c.rotateZ(0.025*Math.sin(o.walk))}
  if(speaking(kk))c.rotateZ(0.025*Math.sin(t*4.2+h)*Math.max(0,Math.sin(t*1.3+h)));
  const d=startleAt(t);if(d>=0){const k=1-d/0.7;c.position.x+=0.035*Math.sin(d*55)*k;c.scale.y*=1-0.05*k*Math.max(0,1-d*4)+0.03*k*Math.max(0,d*4-1)}}
 c.userData.o=c.userData.o0}
// ================= vòng vẽ =================
function rain(a){g2.save();g2.strokeStyle=`rgba(180,200,230,${0.35*a})`;g2.lineWidth=1.6;for(let i=0;i<140;i++){const x=(R(i)*RW*1.2+NOW*60)%(RW*1.2)-RW*0.1,y=(R(i+300)*RH+NOW*1800*(0.8+R(i+7)*0.4))%RH;g2.beginPath();g2.moveTo(x,y);g2.lineTo(x-6,y+38);g2.stroke()}g2.restore()}
window.draw=function(t){NOW=t;const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;CCTV=0;BLACK=0;TITLE=false;RED=0;RAIN=0;FLASH=0;blkA.scale.set(1.25,1,0.8);g2.clearRect(0,0,RW,RH);
 CC.inn.loi.castShadow=true;
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set(1.4+(R(i+5)-0.5)*7,0.3+((R(i+9)*2.5+t*0.05)%2.5),-2.4+p*4);m.material.opacity=0.3*Math.sin(p*Math.PI)});
 smoke.forEach((s,i)=>{const p=(t*0.15+i/12)%1;s.position.set(1.2+Math.sin(p*6+i)*0.06,2.3+p*0.9,-2.35);s.scale.setScalar(0.08+p*0.3);s.material.opacity=0.18*Math.sin(p*Math.PI)});
 riceWind(t);JAR_E.visible=false;JAR_I.visible=false;foundL.intensity=0;HANDS.forEach(h=>h.visible=false);eSun.intensity=0;eMist.forEach((m,i)=>{const z=4+i*0.7;const x=((R(i)*20+t*0.12)%20)-10;m.position.set(x,0.6+R(i+2)*0.5,z)});
 mist.forEach((m,i)=>{const z=6-i*0.6;const x=((R(i)*14+t*0.15)%14)-7;m.position.set(x,H(x,z)+0.5+R(i+2)*0.6,z)});
 if(!S[k])console.log('missing',k);const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 let JF=-1;for(const [jk,jf,jz,hard] of JUMPS.concat(SOFT)){const sc2=TLD.scenes.find(q=>q[0]===jk);if(!sc2)continue;const tj=sc2[1]+(sc2[2]-sc2[1])*jf,dt=t-tj;if(dt<0||dt>1.4)continue;const z=dt<0.1?dt/0.1*jz:jz*Math.max(0,1-(dt-0.1)/1.3);const tv=new THREE.Vector3(...CT);cam.position.lerp(tv,z);if(hard&&dt<0.5){const a2=0.05*(1-dt/0.5);cam.position.x+=(R(t*977)-0.5)*a2*2;cam.position.y+=(R(t*631)-0.5)*a2*2}cam.lookAt(tv);if(hard)JF=dt}
 for(const kk in CC[mode]){const c=CC[mode][kk];if(!c.visible){c.scale.set(1,1,1);continue}motionPre(kk,c,t);c.userData.paint(t);c.scale.set(1,1,1);c.lookAt(cam.position.x,c.position.y,cam.position.z);motionPost(kk,c,t)}
 renderer.render(SCN[mode],cam);renderer.domElement.style.filter=CCTV?"grayscale(1) contrast(1.35) brightness(1.2)":"";
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.2)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(RAIN)rain(RAIN);
 if(FLASH){g2.fillStyle=`rgba(220,230,255,${FLASH})`;g2.fillRect(0,0,RW,RH)}
 if(RED){g2.fillStyle=`rgba(140,0,0,${RED})`;g2.fillRect(0,0,RW,RH)}
 if(JF>=0&&JF<0.3){if(JF<0.06){g2.fillStyle='rgba(255,255,255,.55)';g2.fillRect(0,0,RW,RH)}else{g2.fillStyle=`rgba(160,0,0,${0.35*(1-JF/0.3)})`;g2.fillRect(0,0,RW,RH)}}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 if(CCTV)cctvOv(t);
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
