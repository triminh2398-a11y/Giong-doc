// ================= cảnh: ÁO TRẮNG QUA HANG =================
const S={};let ctaFlag=false,BLACK=0,TITLE=false,RED=0,RAIN=0,FLASH=0,NOW=0,CCTV=0;
const JUMPS=[['title',0.02,0.4,1],['photo3',0.35,0.45,1],['turn',0.3,0.45,1],['grab',0.2,0.45,1]];
const SOFT=[['gm',0.2,0.25,0]];
const TK=sp=>{for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a&&NOW<b)return Math.sin(NOW*14)>-0.2?'o':undefined}return undefined};
const flick=T=>0.85+0.15*Math.sin(T*11)*Math.sin(T*3.7);
// khung màn hình máy ảnh khi xem lại ảnh
function lcd(n){g2.save();g2.strokeStyle='rgba(20,20,22,.95)';g2.lineWidth=60;g2.strokeRect(0,0,RW,RH);g2.strokeStyle='rgba(230,230,230,.8)';g2.lineWidth=2;g2.strokeRect(46,46,RW-92,RH-92);g2.fillStyle='#eaeaea';g2.font='bold 26px "DejaVu Sans"';g2.fillText('▶  '+n+'/3',70,90);g2.fillText('ISO 400  f/2.8',RW-290,90);g2.restore()}
const egret=(T,x0,y0,z0,dx,fall)=>{CO.visible=true;const p=(T*0.25)%1;const x=x0+dx*p,y=y0-(fall?Math.max(0,p-0.5)*2*y0*0.9:0);CO.position.set(x,y,z0);CO.rotation.z=fall&&p>0.5?-0.9:0;const f=Math.sin(T*10)*0.6;CO.userData['w-1'].rotation.y=f;CO.userData['w1'].rotation.y=-f};
const LW={white:true};
// ---- mở đầu: SÁNG, không hù ----
S.hook=(lt,D,T)=>{CUR='ban';banMode('day');const p=sm(lt/D);egret(T*0.6,-14,9,-18,20,false);cm([lerp(6,2,p),lerp(3.5,2.6,p),lerp(12,9,p)],[-6,3,-16],lerp(50,44,p));return 'ban'};
S.hook2=(lt,D,T)=>{CUR='hang';hangMode('day');const p=sm(lt/D);hang.add(CO);egret(T*0.9+0.2,-5,6.5,-2.2,10,true);cm([0.4,1.6,lerp(9,7.5,p)],[0,3.4,-2.7],48);return 'hang'};
S.title=(lt,D,T)=>{CUR='hang';hangMode('day');TITLE=true;mist(0.6,T);cm([0,1.4,lerp(6.5,5.6,sm(lt/D))],[0,2.2,-2.7],46);return 'hang'};
S.intro=(lt,D,T)=>{CUR='ban';banMode('day');ban.add(CO);CO.visible=false;put(C.linh,2.4,0.6,{camera:true,eyes:1,look:1,T},0);put(C.pia,3.5,0.3,{eyes:1,look:-1,T},0);const p=sm(lt/D);cm([lerp(0.6,1.6,p),1.5,lerp(5.4,4.4,p)],[3.0,1.4,-1.2],46);return 'ban'};
S.dress=(lt,D,T)=>{CUR='ban';banMode('day');const p=sm(lt/D);put(C.linh,lerp(1.8,-3.2,p),lerp(0.8,-1.6,p),Object.assign({camera:true,walk:T*6,eyes:1,smileF:lt>D*0.6,T},LW),0);put(C.x1,-5.2,-3.2,{eyes:1.3,armA:[undefined,lt>D*0.3?-2.4:undefined],T},0);put(C.x2,-6.4,-3.6,{eyes:1.3,T},0);cm([2.4,1.7,5.2],[lerp(1,-3,p),1.1,-1.4],46);return 'ban'};
S.shoot=(lt,D,T)=>{CUR='hang';hangMode('day');mist(0.3,T);put(C.linh,0.3,0.4,Object.assign({eyes:1,smileF:true,T},LW),0);cm([0.9,1.4,lerp(4.6,4.0,sm(lt/D))],[0.2,1.3,-1.2],44);return 'hang'};
S.photo=(lt,D,T)=>{CUR='hang';hangMode('day');put(C.linh,0.3,0.4,Object.assign({eyes:1,smileF:true,T},LW),0);const two=lt>D*0.45;put(C.mat,two?-0.6:0.2,two?-2.3:-3.4,{a:two?0.85:0.5,open:0.2,glow:0.4},0);cm([0.3,1.3,4.2],[0.2,1.3,-1.2],44);lcd(two?2:1);return 'hang'};
S.photo3=(lt,D,T)=>{CUR='hang';hangMode('day');put(C.linh,0.3,0.4,Object.assign({eyes:1,smileF:true,T},LW),0);put(C.mat,0.75,0.05,{a:0.95,open:0.35,look:-0.3,tilt:0.12},0.08);if(lt<D*0.35){cm([0.3,1.3,4.2],[0.2,1.3,-1.2],44)}else{cm([0.55,1.35,2.2],[0.55,1.25,0.1],36)}lcd(3);return 'hang'};
S.back=(lt,D,T)=>{CUR='hang';hangMode('day');const p=sm(seg(lt,D*0.35,D));put(C.linh,0.3,lerp(0.4,4,p),Object.assign({eyes:1.45,pupil:2,camera:true,walk:p>0?T*12:undefined,T},LW),0);cm([1.4,1.5,lerp(4.8,7.5,p)],[0,1.4,-1.5],46);return 'hang'};
S.pia=(lt,D,T)=>{CUR='san';sanMode('day');put(C.linh,-1.2,0.4,Object.assign({eyes:1.2,camera:true,sick:true,T},LW),0);put(C.pia,0.6,0.1,{basket:lt<D*0.25,eyes:lt>D*0.25?1.45:1,pupil:lt>D*0.25?2:undefined,T},0);RO.position.set(lt<D*0.25?0.6:0.9,0,lt<D*0.25?0.1:0.6);cm([-0.2,1.5,3.6],[-0.3,1.1,0.2],46);return 'san'};
S.pia1=(lt,D,T)=>{CUR='san';sanMode('day');put(C.pia,0.6,0.1,{eyes:1.1,mouth:TK('BA'),T},0);put(C.linh,-1.2,0.4,Object.assign({eyes:1.2,sick:true,T},LW),0);close(C.pia,lerp(1.4,1.2,sm(lt/D)),38,0.25);return 'san'};
S.pia2=(lt,D,T)=>{CUR='san';sanMode('day');put(C.pia,0.6,0.1,{eyes:1.2,mouth:TK('BA'),T},0);put(C.linh,-1.2,0.4,Object.assign({eyes:1.35,pupil:2,sick:true,T},LW),0);if(lt<D*0.55){close(C.pia,1.2,38,-0.2)}else{close(C.linh,1.4,38,0.2)}return 'san'};
S.night=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);put(C.linh,-2.2,0.0,{sit:true,sick:true,eyes:lt<D*0.5?0.05:1.1,T},0);put(C.pia,2.6,-1.6,{sit:true,eyes:0.05,T},0);cm([-0.4,1.4,lerp(3.6,3.0,sm(lt/D))],[-1.4,0.8,0],44);return 'san'};
S.see=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);put(C.linh,-2.2,0.0,{sit:true,sick:true,eyes:1.4,pupil:2,T},0);put(C.mat,1.1,0.2,{sit:true,a:0.9,open:0.1,look:-1,tilt:0.25},0);cm([-2.6,1.2,2.4],[0.9,0.7,0.2],44);return 'san'};
S.turn=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);put(C.mat,1.1,0.2,{sit:true,a:0.95,open:lt>D*0.3?0.75:0.2,look:-0.6,tilt:lerp(0.3,0.05,sm(lt/D))},0);sCold.intensity=2.4;sCold.position.set(0.4,1.2,1.6);close(C.mat,lerp(1.5,1.1,sm(lt/D)),36,-0.2,-0.35);return 'san'};
S.gm=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);put(C.mat,1.1,0.2,{sit:true,a:0.95,open:0.4+0.35*Math.max(0,Math.sin(T*6)),look:-0.6,mouth:TK('GM')},0);sCold.intensity=2.4;sCold.position.set(0.4,1.2,1.6);close(C.mat,1.1,36,-0.2,-0.35);return 'san'};
S.pia3=(lt,D,T)=>{CUR='san';sanMode('night');sanAnim(T);const q=sm(seg(lt,0,D*0.4));put(C.pia,-0.6,1.0,{torch:true,eyes:1.4,pupil:2,T},0);TORCH.intensity=3;TORCH.position.set(-0.4,1.6,1.2);if(q<1)put(C.mat,1.1,0.2,{sit:true,a:0.9*(1-q),open:0.3},0);put(C.linh,-2.2,0.0,{sit:true,sick:true,eyes:1.3,T},0);cm([-0.4,1.6,4.2],[-0.2,0.9,0],46);return 'san'};
S.mo=(lt,D,T)=>{CUR='san';sanMode('day');put(C.mo,0.8,0.0,{eyes:1,T},0);put(C.pia,1.9,0.3,{eyes:1,look:-1,T},0);put(C.linh,-0.8,0.5,{sit:true,sick:true,eyes:1.1,look:1,T},0);cm([0.4,1.5,lerp(4.2,3.6,sm(lt/D))],[0.6,1.0,0.2],46);return 'san'};
S.mo1=(lt,D,T)=>{CUR='san';sanMode('day');put(C.mo,0.8,0.0,{eyes:1.05,mouth:TK('MO'),T},0);close(C.mo,lerp(1.4,1.2,sm(lt/D)),38,0.25);return 'san'};
const nightRite=(T,o={})=>{hangMode('night');CHIENG.visible=true;CHIENG.userData.d.rotation.z=Math.sin(T*9)*0.05;put(C.mo,1.4,-1.0,Object.assign({chant:true,eyes:1,T},o.M||{}),0);put(C.pia,-2.0,-0.2,Object.assign({eyes:1,look:1,T},o.P||{}),0);hCold.intensity=0;pyreL.intensity=2.6*flick(T);pyreL.position.set(1.2,0.6,-0.4)};
S.cave=(lt,D,T)=>{CUR='hang';nightRite(T);put(C.linh,0.0,0.6,Object.assign({torch:true,eyes:1.1,sick:true,T},LW),0);mist(0.4,T);const p=sm(lt/D);cm([lerp(3.4,2.2,p),1.6,lerp(6.2,5.0,p)],[-0.2,1.2,-0.8],46);return 'hang'};
S.walk=(lt,D,T)=>{CUR='hang';nightRite(T);const p=sm(lt/D);const x=lerp(0.2,-0.4,p),z=lerp(0.6,2.2,p);put(C.linh,x,z,Object.assign({torch:true,walk:T*5,eyes:1.2,sick:true,T},LW),0);put(C.mat,x+0.5,z-1.3,{a:0.75,open:0.2,look:-0.5},0.05);mist(0.5,T);cm([x+2.2,1.5,z+3.2],[x,1.1,z-0.4],44);return 'hang'};
S.grab=(lt,D,T)=>{CUR='hang';nightRite(T);mist(0.7,T);const lean=sm(seg(lt,D*0.2,D))*0.18;put(C.linh,0.6,-1.2,Object.assign({torch:true,flame:lerp(1,0.25,sm(lt/D)),eyes:1.45,pupil:2,tilt:-lean,T},LW),0);put(C.mat,0.25,-1.7,{a:0.92,reach:true,open:0.6,look:0.4},0.05);hCold.intensity=3;hCold.position.set(0.6,1.4,0.6);if(lt<D*0.2){cm([2.0,1.5,1.8],[0.5,1.1,-1.5],44)}else{close(C.linh,lerp(1.5,1.2,sm(lt/D)),38,0.5)}return 'hang'};
S.hold=(lt,D,T)=>{CUR='hang';nightRite(T,{P:{eyes:1.3}});mist(lerp(0.7,0.2,sm(lt/D)),T);const q=sm(lt/D);put(C.linh,lerp(0.6,-0.2,q),lerp(-1.2,0.8,q),Object.assign({torch:true,flame:lerp(0.25,0.9,q),walk:T*4,eyes:1.3,T},LW),0);put(C.mat,lerp(0.25,0.1,q),lerp(-1.7,-0.2,q),{a:0.9*(1-q*0.4),reach:q<0.7,open:0.4},0.05);cm([2.6,1.6,lerp(2.6,4.0,q)],[0.2,1.1,-0.4],46);return 'hang'};
S.home=(lt,D,T)=>{CUR='ban';banMode('night');banL.intensity=2.4*flick(T);const p=sm(lt/D);const x=lerp(-1.2,-2.0,p),z=lerp(6,4.6,p);banL.position.set(x+0.3,1.6,z+0.4);put(C.linh,x,z,Object.assign({torch:true,flame:0.9,walk:p<0.7?T*5:undefined,eyes:1,T},LW),0);put(C.mat,x+0.4,z+1.0,{a:lerp(0.75,0,sm(seg(lt,D*0.6,D))),open:0.1,look:-0.3},0.05);cm([x+2.6,1.6,z+3.4],[x-0.6,0.8,z-1.0],46);return 'ban'};
S.end=(lt,D,T)=>{CUR='ban';banMode('day');NEWMO.visible=true;put(C.linh,-1.0,5.6,{camera:true,eyes:1,look:-1,T},0);put(C.pia,-2.4,5.8,{eyes:1,T},0);put(C.mo,-3.4,5.4,{eyes:1,T},0);put(C.x1,-4.4,5.0,{eyes:1,T},0);cm([lerp(0.8,0.2,sm(lt/D)),1.6,10.2],[-2.2,0.8,6.2],44);return 'ban'};
S.end2=(lt,D,T)=>{CUR='ban';banMode('day');const p=sm(lt/D);egret(T*0.5,-16,8,-14,24,false);cm([lerp(4,1,p),3,lerp(10,8,p)],[-6,4,-18],46);return 'ban'};
S.cta=(lt,D,T)=>{CUR='hang';hangMode('dawn');ctaFlag=true;mist(0.4,T);cm([0,1.5,lerp(7,6,sm(lt/D))],[0,2.2,-2.7],46);return 'hang'};
S.cta2=S.cta;
// ===== LỚP CHUYỂN ĐỘNG CHUNG (áp cho mọi cảnh) =====
const HSH=s=>{let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))%9973;return h/9973};
const SPK={pia:'BA',mo:'MO',mat:'GM'};const STILL={};
const speaking=(kk)=>{const sp=SPK[kk];if(!sp)return false;for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a-0.05&&NOW<b+0.15)return true}return false};
const GHOST={mat:1};
function startleAt(t){let best=-1;for(const [jk,jf] of JUMPS.concat(SOFT)){const q=TLD.scenes.find(x=>x[0]===jk);if(!q)continue;const d=t-(q[1]+(q[2]-q[1])*jf);if(d>=0&&d<0.7)best=d}return best}
const GLITCH=(t,h)=>{const per=2.3+h*1.4,u=(t+h*11)%per;return u<0.09?(u<0.045?1:-1):0};
function motionPre(kk,c,t){if(STILL[kk]){c.userData.o0=c.userData.o;return}const o=Object.assign({},c.userData.o);const h=HSH(kk);
 if(!GHOST[kk]&&!o.back){const per=3.2+h*1.6,u=(t+h*7)%per;if(u<0.13&&(o.eyes===undefined||o.eyes>0.3))o.eyes=0.05}
 if(speaking(kk)&&!o.pot&&!o.phone&&!o.phoneLap&&!o.point&&!o.sit&&!o.back){const g=-0.18-0.22*Math.max(0,Math.sin(t*2.6+h*5));
  if(kk==='linh'||kk==='pia'){const a=(o.arm||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.arm=a}}else{const a=(o.armA||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.armA=a}}}
 if(!GHOST[kk]&&!speaking(kk)&&o.walk===undefined&&o.phase===undefined&&!o.jar&&!o.pot&&!o.clutch&&!o.bell&&!o.ears&&!o.cover&&!o.sit&&!o.back&&!o.hoe){const sw=0.05*Math.sin(t*1.1+h*7);if(kk==='linh'||kk==='pia'){const ar=(o.arm||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.12+sw;if(ar[1]===undefined)ar[1]=0.12+sw;o.arm=ar}else if(kk==='mo'){const ar=(o.armA||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.1+sw;if(ar[1]===undefined)ar[1]=0.1+sw;o.armA=ar}}
 if(o.walk!==undefined&&!o.pot){for(const key of ['arm','armA']){const a=(o[key]||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.34*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.34*Math.sin(o.walk);o[key]=a}}
 if(false&&o.walk!==undefined&&(kk==='linh'||kk==='pia')&&!o.pot){const a=(o.arm||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.32*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.32*Math.sin(o.walk);o.arm=a}
 c.userData.o0=c.userData.o;c.userData.o=o}
function motionPost(kk,c,t){const h=HSH(kk);const o=c.userData.o||{};
 if(o.crawl){c.rotateZ(1.3);}
 if(GHOST[kk]){const g=GLITCH(t,h);c.position.y+=0.03*Math.sin(t*1.2+h*6);c.rotateZ(0.04*Math.sin(t*0.5+h*3)+g*0.12);c.position.x+=g*0.05;c.material.opacity=0.7+0.06*Math.sin(t*23+h)*(g?1:0.3)}
 else{const br=0.012*Math.sin(t*2.2+h*9);c.position.x+=0.012*Math.sin(t*0.7+h*5);c.scale.set(1,1+br,1);c.position.y+=0.98*br;c.rotateZ(0.012*Math.sin(t*0.9+h*4));
  if(o.walk!==undefined){const b=Math.abs(Math.sin(o.walk));c.position.y+=0.035*b;c.scale.y*=1-0.015*b;c.rotateZ(0.025*Math.sin(o.walk))}
  if(speaking(kk))c.rotateZ(0.025*Math.sin(t*4.2+h)*Math.max(0,Math.sin(t*1.3+h)));
  const d=startleAt(t);if(d>=0){const k=1-d/0.7;c.position.x+=0.035*Math.sin(d*55)*k;c.scale.y*=1-0.05*k*Math.max(0,1-d*4)+0.03*k*Math.max(0,d*4-1)}}
 c.userData.o=c.userData.o0}
// ================= vòng vẽ =================
function rain(a){g2.save();g2.strokeStyle=`rgba(180,200,230,${0.35*a})`;g2.lineWidth=1.6;for(let i=0;i<140;i++){const x=(R(i)*RW*1.2+NOW*60)%(RW*1.2)-RW*0.1,y=(R(i+300)*RH+NOW*1800*(0.8+R(i+7)*0.4))%RH;g2.beginPath();g2.moveTo(x,y);g2.lineTo(x-6,y+38);g2.stroke()}g2.restore()}
window.draw=function(t){NOW=t;const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;CCTV=0;BLACK=0;TITLE=false;RED=0;RAIN=0;FLASH=0;blkA.scale.set(1.25,1,0.8);g2.clearRect(0,0,RW,RH);
 CC.inn.loi.castShadow=true;
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set(1.4+(R(i+5)-0.5)*7,0.3+((R(i+9)*2.5+t*0.05)%2.5),-2.4+p*4);m.material.opacity=0.3*Math.sin(p*Math.PI)});
 smoke.forEach((s,i)=>{const p=(t*0.15+i/12)%1;s.position.set(1.2+Math.sin(p*6+i)*0.06,2.3+p*0.9,-2.35);s.scale.setScalar(0.08+p*0.3);s.material.opacity=0.18*Math.sin(p*Math.PI)});
 riceWind(t);JAR_E.visible=false;JAR_I.visible=false;foundL.intensity=0;HANDS.forEach(h=>h.visible=false);eSun.intensity=0;eMist.forEach((m,i)=>{const z=4+i*0.7;const x=((R(i)*20+t*0.12)%20)-10;m.position.set(x,0.6+R(i+2)*0.5,z)});
 mist.forEach((m,i)=>{const z=6-i*0.6;const x=((R(i)*14+t*0.15)%14)-7;m.position.set(x,H(x,z)+0.5+R(i+2)*0.6,z)});
 if(!S[k])console.log('missing',k);const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 let JF=-1;for(const [jk,jf,jz,hard] of JUMPS.concat(SOFT)){const sc2=TLD.scenes.find(q=>q[0]===jk);if(!sc2)continue;const tj=sc2[1]+(sc2[2]-sc2[1])*jf,dt=t-tj;if(dt<0||dt>1.4)continue;const z=dt<0.1?dt/0.1*jz:jz*Math.max(0,1-(dt-0.1)/1.3);const tv=new THREE.Vector3(...CT);cam.position.lerp(tv,z);if(hard&&dt<0.5){const a2=0.05*(1-dt/0.5);cam.position.x+=(R(t*977)-0.5)*a2*2;cam.position.y+=(R(t*631)-0.5)*a2*2}cam.lookAt(tv);if(hard)JF=dt}
 for(const kk in CC[mode]){const c=CC[mode][kk];if(!c.visible){c.scale.set(1,1,1);continue}motionPre(kk,c,t);c.userData.paint(t);c.scale.set(1,1,1);c.lookAt(cam.position.x,c.position.y,cam.position.z);motionPost(kk,c,t)}
 renderer.render(SCN[mode],cam);renderer.domElement.style.filter=CCTV?"grayscale(1) contrast(1.35) brightness(1.2)":"";
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.2)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(RAIN)rain(RAIN);
 if(FLASH){g2.fillStyle=`rgba(220,230,255,${FLASH})`;g2.fillRect(0,0,RW,RH)}
 if(RED){g2.fillStyle=`rgba(140,0,0,${RED})`;g2.fillRect(0,0,RW,RH)}
 if(JF>=0&&JF<0.3){if(JF<0.06){g2.fillStyle='rgba(255,255,255,.55)';g2.fillRect(0,0,RW,RH)}else{g2.fillStyle=`rgba(160,0,0,${0.35*(1-JF/0.3)})`;g2.fillRect(0,0,RW,RH)}}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 if(CCTV)cctvOv(t);
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
