const leafT=ctex(128,512,(g,w,h)=>{g.clearRect(0,0,w,h);g.fillStyle='#2f5a2c';g.strokeStyle='#0c0c0c';g.lineWidth=5;g.beginPath();g.moveTo(w/2,h);g.quadraticCurveTo(w,h*0.5,w/2,4);g.quadraticCurveTo(0,h*0.5,w/2,h);g.fill();g.stroke();
 g.strokeStyle='#d8202a';g.lineWidth=5;g.beginPath();g.moveTo(w/2,h);g.lineTo(w/2,10);g.stroke();g.lineWidth=2.5;for(let j=1;j<9;j++){const y=h-j*h/9;for(const sd of [-1,1]){g.beginPath();g.moveTo(w/2,y);g.quadraticCurveTo(w/2+sd*20,y-14,w/2+sd*34,y-36);g.stroke()}}});
function ngaiPot(par,x,y,z,s=1,small=false){const g=new THREE.Group();g.position.set(x,y,z);g.scale.setScalar(s);par.add(g);
 const p=new THREE.Mesh(new THREE.CylinderGeometry(0.2,0.14,0.28,18),M({color:0xa8542e,roughness:0.8}));p.position.y=0.14;p.castShadow=true;g.add(p);const rim=new THREE.Mesh(new THREE.TorusGeometry(0.2,0.025,8,24),M({color:0x8a4022}));rim.rotation.x=Math.PI/2;rim.position.y=0.28;g.add(rim);
 const soil=new THREE.Mesh(new THREE.CircleGeometry(0.19,20),M({color:0x1a120c,roughness:1}));soil.rotation.x=-Math.PI/2;soil.position.y=0.27;g.add(soil);
 const bulb=new THREE.Mesh(new THREE.SphereGeometry(0.07,12,10),M({color:0x8a6a4a}));bulb.scale.y=0.45;bulb.position.y=0.27;g.add(bulb);
 const leafM=new THREE.MeshStandardMaterial({map:leafT,transparent:true,alphaTest:0.3,side:THREE.DoubleSide,emissive:0x400000,emissiveIntensity:0.6});const L=[];
 const n=small?8:14;for(let k=0;k<n;k++){const piv=new THREE.Group();piv.position.y=0.27;piv.rotation.y=k*2.39;g.add(piv);const hh=0.55*(0.7+R(k)*0.45);const lf=new THREE.Group();for(const ry of [0,Math.PI/2]){const pl=new THREE.Mesh(new THREE.PlaneGeometry(0.12,hh),leafM);pl.geometry.translate(0,hh/2,0);pl.rotation.y=ry;pl.castShadow=true;lf.add(pl)}lf.userData.b=0.12+R(k+4)*0.3;lf.rotation.x=lf.userData.b;piv.add(lf);L.push(lf)}
 const sh=new THREE.Mesh(new THREE.ConeGeometry(0.03,0.34,8),new THREE.MeshStandardMaterial({color:0xc01820,emissive:0x900010,emissiveIntensity:1}));sh.geometry.translate(0,0.17,0);sh.position.set(0.02,0.27,0.02);sh.visible=false;g.add(sh);
 const gl=new THREE.PointLight(0xff2a2a,0,2.6,1.4);gl.position.set(0,0.95,0.25);g.add(gl);
 g.userData={L,sh,gl,leafM};return g}
function potAnim(P,T,o={}){const{L,sh,gl,leafM}=P.userData;L.forEach((l,k)=>{l.rotation.x=l.userData.b+Math.sin(T*(o.shake?14:1.6)+k)*(o.shake?0.07:0.025)*(o.amp||1);l.rotation.z=Math.sin(T*1.2+k*2)*0.03});sh.visible=!!o.shoot;sh.scale.y=o.shoot||1;gl.intensity=o.glow||0;leafM.emissiveIntensity=0.5+(o.pulse?0.6*(0.5+0.5*Math.sin(T*4)):0)}
const POT=ngaiPot(HOUSE,4.5,0.8,-2.15,1.0);
const POT2=ngaiPot(HOUSE,-0.85,0.45,-2.25,0.6,true);
// rễ bò trên nền (buồng) — TubeGeometry, mọc theo q
const ROOTS=[];const rootM=M({color:0xc89a6a,roughness:0.7,emissive:0x802020,emissiveIntensity:0.8});
for(let k=0;k<6;k++){const pts=[];const x0=4.5,z0=-2.0;for(let i=0;i<=10;i++){const t=i/10;pts.push(new THREE.Vector3(lerp(x0,3.1+R(k)*0.2,t)+Math.sin(t*8+k)*0.12,i===0?0.85:0.02+0.02*R(i+k),lerp(z0,-1.2+(R(k+2)-0.5)*0.8,t)+Math.cos(t*6+k)*0.15))}
 const cv=new THREE.CatmullRomCurve3(pts);const geo=new THREE.TubeGeometry(cv,60,0.05+R(k)*0.03,8,false);const m=new THREE.Mesh(geo,rootM);m.castShadow=true;HOUSE.add(m);ROOTS.push(m)}
function roots(q){ROOTS.forEach((m,k)=>{m.visible=q>0;m.geometry.setDrawRange(0,Math.floor(m.geometry.index.count*Math.min(1,q*(0.8+R(k)*0.4)))/3*3|0)})}
inn.add(new THREE.HemisphereLight(0x2a3040,0x0a0806,0.35));
