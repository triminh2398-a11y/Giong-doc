const NHANG=[];function nhang(par,x,y,z){const g=new THREE.Group();g.position.set(x,y,z);par.add(g);const b=new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.05,0.08,12),M({color:0xd8d0c0}));b.position.y=0.04;g.add(b);for(let k=0;k<3;k++){const s=new THREE.Mesh(new THREE.CylinderGeometry(0.004,0.004,0.3,4),M({color:0xb03020}));s.position.set((k-1)*0.03,0.2,0);s.rotation.z=(k-1)*0.15;g.add(s);const tip=new THREE.Mesh(new THREE.SphereGeometry(0.008,6,4),new THREE.MeshBasicMaterial({color:0xff5020}));tip.position.set((k-1)*0.03+(k-1)*-0.022,0.35,0);g.add(tip)}NHANG.push(g);return g}
