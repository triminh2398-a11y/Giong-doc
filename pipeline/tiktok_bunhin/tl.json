{"dur": 249.72, "scenes": [["hook", 0, 10.134, [0.3]], ["hook2", 10.134, 15.495, [0.2]], ["title", 15.495, 19.155, [0.2]], ["rent", 19.155, 28.819, [0.2]], ["scare", 28.819, 40.014, [0.2]], ["chin", 40.014, 45.408, [0.2]], ["chin1", 45.408, 55.067, [0.2]], ["tam1", 55.067, 57.826, [0.2]], ["swap", 57.826, 69.481, [0.2]], ["burn", 69.481, 77.255, [0.2]], ["near", 77.255, 83.981, [0.2]], ["ha1", 83.981, 88.609, [0.2]], ["tam2", 88.609, 92.512, [0.2]], ["near2", 92.512, 101.123, [0.2]], ["sick", 101.123, 113.695, [0.2]], ["call", 113.695, 119.321, [0.2]], ["gt", 119.321, 128.739, [0.2]], ["cover", 128.739, 137.16, [0.2]], ["run", 137.16, 140.613, [0.2]], ["chin2", 140.613, 149.406, [0.2]], ["chin3", 149.406, 160.03, [0.2]], ["night", 160.03, 169.2, [0.2]], ["strip", 169.2, 178.121, [0.2]], ["gt2", 178.121, 184.681, [0.2]], ["turn", 184.681, 193.045, [0.2]], ["pull", 193.045, 204.071, [0.2]], ["morning", 204.071, 213.081, [0.2]], ["end", 213.081, 219.94, [0.2]], ["end2", 219.94, 231.207, [0.2]], ["gh", 231.207, 239.031, [0.2]], ["cta", 239.031, 249.716, [0.2, 5.26]]], "subs": [[0.33, 1.54, "Ở miền Tây xưa,", "N"], [1.54, 4.03, "có những con bù nhìn đứng giữa ruộng", "N"], [4.03, 5.86, "mà không ai dám đụng tới.", "N"], [5.86, 6.95, "Người ta nói,", "N"], [6.95, 9.77, "cái áo trên mình nó… là áo của người chết.", "N"], [10.36, 12.78, "Hễ nó được khoác áo mới… là trong", "N"], [12.78, 14.78, "xóm sắp mất thêm một người.", "N"], [15.72, 18.45, "Câu chuyện hôm nay… Bù nhìn mặc áo người.", "N"], [19.39, 21.66, "Vợ chồng Tâm với Hạnh mới về xóm", "N"], [21.66, 24.61, "Kinh Ngang, mướn lại miếng ruộng cuối kinh.", "N"], [24.61, 26.21, "Chủ cũ là ông Ba Đực,", "N"], [26.21, 28.46, "đi đâu biệt tăm hơn một năm nay.", "N"], [29.05, 31.41, "Ngay đầu ruộng có một con bù nhìn", "N"], [31.41, 33.28, "rơm. Đầu đội nón lá rách,", "N"], [33.28, 35.33, "mình mặc cái áo bà ba nâu cũ", "N"], [35.33, 36.51, "mèm. Lạ ở chỗ,", "N"], [36.51, 38.44, "mặt nó không ngó ra ruộng,", "N"], [38.44, 39.65, "mà quay vô nhà.", "N"], [40.24, 42.09, "Tâm định nhổ nó lên dựng lại,", "N"], [42.09, 44.1, "thì bà Chín nhà bên cạnh lật đật", "N"], [44.1, 45.05, "chạy qua cản.", "N"], [45.66, 47.01, "“Đừng đụng nó con!”", "CH"], [47.01, 49.16, "“Nó đứng coi ruộng này lâu rồi.”", "CH"], [49.16, 51.24, "“Chạng vạng thì đừng ra ruộng.”", "CH"], [51.24, 52.78, "“Còn nghe nó kêu tên,”", "CH"], [52.78, 54.65, "“thì đừng có trả lời nghen.”", "CH"], [55.32, 57.07, "“Dạ… con biết rồi bà Chín.”", "TA"], [58.06, 60.3, "Tâm cười, nghĩ bà già lẩm cẩm.", "N"], [60.3, 62.87, "Chiều đó, thấy cái áo trên mình con", "N"], [62.87, 64.34, "bù nhìn rách bươm,", "N"], [64.34, 65.88, "anh lột ra đem đốt,", "N"], [65.88, 68.06, "rồi khoác cho nó cái áo bà ba", "N"], [68.06, 69.12, "cũ của mình.", "N"], [69.71, 70.95, "Lúc lửa bén lên,", "N"], [70.95, 73.2, "Hạnh thấy trong túi áo rớt ra một", "N"], [73.2, 74.32, "cây lược sừng.", "N"], [74.32, 76.9, "Trên sống lược có khắc hai chữ: Ba Đực.", "N"], [77.49, 78.4, "Sáng hôm sau,", "N"], [78.4, 80.49, "con bù nhìn không còn đứng đầu ruộng", "N"], [80.49, 81.97, "nữa. Nó đứng giữa ruộng,", "N"], [81.97, 83.62, "gần nhà hơn chừng chục bước.", "N"], [84.23, 86.58, "“Anh ơi… sao con bù nhìn nó dời”", "HA"], [86.58, 88.16, "“vô gần nhà vậy anh?”", "HA"], [88.84, 90.97, "“Chắc tụi con nít nó phá đó em.”", "TA"], [90.97, 92.09, "“Em đừng có lo.”", "TA"], [92.74, 95.32, "Nhưng ngày nào nó cũng nhích gần thêm", "N"], [95.32, 97.23, "một chút. Tới bữa thứ năm,", "N"], [97.23, 99.38, "nó đứng ngay bờ mương sau nhà.", "N"], [99.38, 100.76, "Và Tâm bắt đầu lạ.", "N"], [101.35, 102.41, "Anh ăn ít,", "N"], [102.41, 104.82, "nói ít, da khô khốc như giấy.", "N"], [104.82, 107.93, "Đêm nằm, Hạnh nghe trong người chồng có", "N"], [107.93, 110.19, "tiếng sột soạt như rơm khô.", "N"], [110.19, 112.99, "Sáng ra, gối anh dính đầy cọng rơm.", "N"], [113.93, 114.95, "Rồi một đêm,", "N"], [114.95, 117.12, "ngoài cửa sổ vọng vô tiếng kêu.", "N"], [117.12, 118.96, "Giọng y hệt giọng của Tâm.", "N"], [119.55, 123.78, "“Hạnh ơi… mở cửa cho anh vô… ngoài”", "GT"], [123.78, 126.42, "“này lạnh quá em ơi…”", "GT"], [128.97, 130.08, "Hạnh quay qua.", "N"], [130.08, 131.71, "Tâm vẫn nằm sát bên cô,", "N"], [131.71, 133.1, "mắt mở trừng trừng,", "N"], [133.1, 134.97, "miệng mấp máy định trả lời.", "N"], [134.97, 136.8, "Cô vội bịt miệng chồng lại.", "N"], [137.39, 138.49, "Trời vừa sáng,", "N"], [138.49, 140.25, "Hạnh chạy qua nhà bà Chín.", "N"], [140.84, 141.98, "“Nó mặc áo ai,”", "CH"], [141.98, 143.69, "“thì nó thành người đó.”", "CH"], [143.69, 146.23, "“Hồi trước thằng Ba Đực cũng thay áo”", "CH"], [146.23, 147.82, "“cho nó… rồi đi luôn,”", "CH"], [147.82, 148.99, "“có về nữa đâu.”", "CH"], [149.66, 151.99, "“Đêm nay, con phải lột cái áo của”", "CH"], [151.99, 153.75, "“thằng Tâm khỏi mình nó,”", "CH"], [153.75, 155.63, "“đem đốt trước khi gà gáy.”", "CH"], [155.63, 157.71, "“Nó kêu gì cũng đừng trả lời.”", "CH"], [157.71, 159.25, "“Đừng nhìn vô mặt nó.”", "CH"], [160.26, 162.52, "Nửa đêm, Hạnh cầm cây đèn dầu ra", "N"], [162.52, 164.66, "bờ mương. Con bù nhìn đứng đó.", "N"], [164.66, 166.49, "Cái áo của Tâm phồng lên,", "N"], [166.49, 168.84, "như có người đang mặc ở bên trong.", "N"], [169.43, 171.74, "Hạnh run tay gỡ từng cái nút áo.", "N"], [171.74, 173.42, "Tới cái nút cuối cùng,", "N"], [173.42, 175.61, "tay cô đụng phải một thứ ấm ấm", "N"], [175.61, 176.73, "dưới lớp rơm.", "N"], [176.73, 177.76, "Là da người.", "N"], [178.39, 182.08, "“Em… đừng lột áo anh mà em…”", "GT"], [184.91, 187.3, "Cái đầu bù nhìn từ từ xoay lại.", "N"], [187.3, 188.76, "Dưới vành nón lá,", "N"], [188.76, 190.49, "là gương mặt của Tâm,", "N"], [190.49, 192.19, "hai mắt nhồi đầy rơm.", "N"], [193.28, 194.39, "Hạnh nhắm mắt,", "N"], [194.39, 196.2, "giật mạnh. Cái áo tuột ra.", "N"], [196.2, 197.89, "Cô quăng nó vô ngọn đèn.", "N"], [197.89, 198.95, "Lửa bùng lên,", "N"], [198.95, 200.94, "trong lửa có tiếng ai rên rỉ.", "N"], [200.94, 201.81, "Rồi xa xa,", "N"], [201.81, 203.36, "gà gáy tiếng đầu tiên.", "N"], [204.3, 205.97, "Sáng ra, Tâm tỉnh lại,", "N"], [205.97, 207.64, "ói ra một nắm rơm khô.", "N"], [207.64, 208.88, "Ngoài bờ mương,", "N"], [208.88, 210.55, "con bù nhìn đã đổ sụp,", "N"], [210.55, 212.37, "chỉ còn một đống rơm mục.", "N"], [213.31, 214.83, "Hai vợ chồng bỏ ruộng,", "N"], [214.83, 216.01, "dọn đi xóm khác.", "N"], [216.01, 217.41, "Nhưng có một chuyện,", "N"], [217.41, 219.23, "Hạnh chưa dám nói với chồng.", "N"], [220.17, 221.11, "Bữa dọn đi,", "N"], [221.11, 222.18, "cô ngoái lại.", "N"], [222.18, 223.18, "Ở đầu ruộng,", "N"], [223.18, 225.13, "đã có ai dựng lại một con bù", "N"], [225.13, 226.78, "nhìn mới. Trên mình nó,", "N"], [226.78, 228.67, "là cái áo bà ba của cô… cái", "N"], [228.67, 230.35, "áo cô mới phơi hồi sáng.", "N"], [231.48, 235.45, "“Hạnh ơi… chừng nào em về…”", "GH"], [239.26, 241.23, "Nếu thấy một con bù nhìn mặc áo", "N"], [241.23, 243.38, "của mình… bạn có dám tới gần không?", "N"], [244.32, 245.51, "Để lại bình luận,", "N"], [245.51, 247.86, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 10.3336875, 15.694583333333332, 19.355416666666667, 29.018875, 40.214312500000005, 45.60775, 55.26722916666667, 58.026, 69.68127083333334, 77.4553125, 84.18114583333333, 88.80879166666666, 92.71158333333334, 101.32345833333333, 113.89520833333333, 119.52127083333333, 128.93885416666666, 137.35991666666666, 140.81260416666666, 149.60645833333334, 160.22977083333333, 169.40014583333334, 178.32079166666668, 184.8813125, 193.24510416666666, 204.27116666666666, 213.28129166666665, 220.1400208333333, 231.4074583333333, 239.2311666666666, 244.29068749999993], "durs": [9.5336875, 4.5108958333333335, 2.8108333333333335, 9.163458333333333, 10.6954375, 4.8934375, 9.159479166666667, 1.9087708333333333, 11.155270833333333, 7.274041666666666, 6.225833333333333, 4.127645833333333, 3.402791666666667, 8.111875, 11.72175, 5.1260625, 8.417583333333333, 7.9210625, 2.9526875, 8.2938541666666