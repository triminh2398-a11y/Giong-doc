{"dur": 166.6, "scenes": [["hook", 0, 10.375, [0.3]], ["hook2", 10.375, 17.074, [0.2]], ["title", 17.074, 21.124, [0.2]], ["intro", 21.124, 30.392, [0.2]], ["first", 30.392, 42.683, [0.2]], ["cry", 42.683, 53.238, [0.2]], ["thay", 53.238, 58.697, [0.2]], ["thay1", 58.697, 64.817, [0.2]], ["cycle", 64.817, 75.876, [0.2]], ["turns", 75.876, 86.49, [0.2]], ["grand", 86.49, 92.152, [0.2]], ["night1", 92.152, 102.486, [0.2]], ["night2", 102.486, 115.49, [0.2]], ["gm", 115.49, 123.307, [0.2]], ["run", 123.307, 135.734, [0.2]], ["leave", 135.734, 142.625, [0.2]], ["end", 142.625, 154.736, [0.2]], ["cta", 154.736, 166.6, [0.2, 6.75]]], "subs": [[0.33, 1.66, "Ở một tỉnh miền Tây,", "N"], [1.66, 2.77, "giữa bãi cỏ dại,", "N"], [2.77, 4.68, "có một căn nhà ngói cũ bỏ hoang", "N"], [4.68, 5.64, "mấy chục năm.", "N"], [5.64, 6.97, "Người trong xóm nói,", "N"], [6.97, 9.09, "đêm đêm trong nhà vẫn vọng ra tiếng", "N"], [9.09, 10.02, "con nít khóc.", "N"], [10.61, 12.7, "Gia đình chủ nhà từng mời thầy về", "N"], [12.7, 14.91, "trấn yểm, cứ bốn năm tháng một lần.", "N"], [14.91, 16.36, "Vậy mà không ai ở nổi.", "N"], [17.3, 20.41, "Câu chuyện hôm nay… Căn nhà bỏ hoang.", "N"], [21.35, 23.51, "Câu chuyện này do người cháu của chủ", "N"], [23.51, 24.35, "nhà kể lại.", "N"], [24.35, 26.35, "Ngày xưa, ông nội anh cất căn nhà", "N"], [26.35, 27.45, "này, tường gạch,", "N"], [27.45, 28.34, "mái ngói đỏ,", "N"], [28.34, 29.68, "khang trang nhất xóm.", "N"], [30.62, 32.21, "Nhưng từ ngày dọn vào,", "N"], [32.21, 33.97, "nhà bắt đầu có chuyện lạ.", "N"], [33.97, 36.6, "Nửa đêm nghe tiếng bước chân ngoài hiên.", "N"], [36.6, 38.19, "Cửa cài then kỹ lưỡng,", "N"], [38.19, 39.71, "sáng ra lại mở toang.", "N"], [39.71, 42.32, "Chén bát trong tủ rớt xuống bể tan tành.", "N"], [42.91, 44.84, "Lạ nhất là tiếng em bé khóc.", "N"], [44.84, 46.6, "Nhà không có đứa nhỏ nào,", "N"], [46.6, 48.93, "vậy mà đêm nào cũng nghe tiếng khóc", "N"], [48.93, 50.69, "oe oe, lúc ở buồng trong,", "N"], [50.69, 52.53, "lúc ở ngay dưới gầm giường.", "N"], [53.47, 55.38, "Ông nội mời thầy về trấn yểm.", "N"], [55.38, 56.9, "Thầy dán bùa khắp cửa,", "N"], [56.9, 58.34, "chôn bùa bốn góc nhà.", "N"], [58.93, 60.12, "“Đất này có vong.”", "TH"], [60.12, 62.5, "“Tui chỉ trấn được một thời gian thôi.”", "TH"], [62.5, 64.4, "“Muốn yên, phải biết nó là ai.”", "TH"], [65.05, 66.67, "Được vài tháng thì yên.", "N"], [66.67, 68.53, "Rồi mọi chuyện lại bắt đầu.", "N"], [68.53, 69.8, "Cứ bốn năm tháng,", "N"], [69.8, 71.37, "nhà lại phải mời thầy.", "N"], [71.37, 72.93, "Bùa dán chồng lên bùa.", "N"], [72.93, 75.17, "Mà tiếng khóc thì mỗi lúc một gần.", "N"], [76.11, 77.05, "Ông nội mất.", "N"], [77.05, 79.12, "Con cháu lần lượt thay nhau về ở", "N"], [79.12, 81.07, "giữ nhà. Người ở được nửa năm,", "N"], [81.07, 82.69, "người chỉ được vài tuần.", "N"], [82.69, 84.03, "Rồi ai cũng dọn đi,", "N"], [84.03, 85.78, "không ai dám nói rõ vì sao.", "N"], [86.72, 87.75, "Người cháu kể,", "N"], [87.75, 88.99, "năm hai mươi tuổi,", "N"], [88.99, 90.01, "anh không tin,", "N"], [90.01, 91.44, "xin về ở thử một mình.", "N"], [92.38, 93.26, "Đêm thứ ba,", "N"], [93.26, 95.4, "tiếng em bé khóc vang lên ngay sát", "N"], [95.4, 97.92, "bên giường. Anh soi đèn xuống gầm giường.", "N"], [97.92, 98.85, "Không có ai.", "N"], [98.85, 100.82, "Chỉ có mấy dấu tay người lớn in", "N"], [100.82, 101.78, "trên lớp bụi.", "N"], [102.72, 103.64, "Đêm thứ bảy,", "N"], [103.64, 105.22, "anh giật mình thức giấc.", "N"], [105.22, 106.26, "Ở cuối giường,", "N"], [106.26, 108.44, "có một người đàn bà ngồi quay lưng,", "N"], [108.44, 109.42, "tóc ướt sũng,", "N"], [109.42, 111.28, "tay ẵm một đứa nhỏ đang khóc.", "N"], [111.28, 112.64, "Rồi trong góc buồng,", "N"], [112.64, 114.63, "một người đàn ông từ từ bước ra.", "N"], [115.72, 120.35, "“Nhà này của gia đình tao… đi ra…”", "GM"], [123.54, 125.73, "Anh bỏ chạy ra khỏi nhà ngay trong", "N"], [125.73, 127.58, "đêm. Lúc chạy ra tới bãi cỏ,", "N"], [127.58, 128.65, "anh ngoái lại.", "N"], [128.65, 130.0, "Trước khung cửa sổ,", "N"], [130.0, 131.07, "người đàn ông,", "N"], [131.07, 132.69, "người đàn bà ẵm đứa nhỏ,", "N"], [132.69, 133.99, "đứng sát bên nhau,", "N"], [133.99, 135.02, "nhìn theo anh.", "N"], [135.96, 137.06, "Sáng hôm sau,", "N"], [137.06, 139.26, "cả nhà quyết định không ai về ở", "N"], [139.26, 141.92, "nữa. Căn nhà bị bỏ hoang từ đó tới nay.", "N"], [142.86, 144.84, "Bây giờ, cỏ dại đã mọc ngang hông", "N"], [144.84, 146.57, "người. Bùa trên cửa bạc màu,", "N"], [146.57, 147.83, "tường loang lổ rêu.", "N"], [147.83, 148.87, "Vậy mà ban đêm,", "N"], [148.87, 151.07, "người đi ngang qua vẫn nghe tiếng con", "N"], [151.07, 152.88, "nít khóc vọng ra từ trong nhà.", "N"], [154.97, 157.15, "Nếu đi ngang một căn nhà hoang mà", "N"], [157.15, 159.46, "nghe tiếng con nít khóc… bạn có dám", "N"], [159.46, 160.58, "bước vào không?", "N"], [161.52, 162.6, "Để lại bình luận,", "N"], [162.6, 164.74, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 10.5753125, 17.273937500000002, 21.323937500000003, 30.59166666666667, 42.88341666666667, 53.43810416666667, 58.897020833333336, 65.0166875, 76.0759375, 86.68962499999999, 92.35227083333332, 102.68560416666665, 115.68987499999999, 123.50731249999998, 135.9343333333333, 142.8250208333333, 154.93560416666662, 161.48895833333327], "durs": [9.7753125, 5.848625, 3.2, 8.417729166666666, 11.79175, 9.7046875, 4.958916666666667, 5.619666666666666, 10.20925, 9.7636875, 4.812645833333334, 9.483333333333333, 12.004270833333333, 6.8174375, 11.577020833333334, 6.0406875, 10.110583333333333, 5.703354166666666, 3.3108541666666667], "lines": ["hook", "hook2", "title", "intro", "first", "cry", "thay", "thay1", "cycle", "turns", "grand", "night1", "night2", "gm", "run", "leave", "end", "cta", "cta"], "vox": [[58.9, 59.66, "TH"], [60.34, 62.06, "TH"], [62.54, 63.0, "TH"], [63.4, 64.46, "TH"], [115.69, 120.41, "GM"]]}