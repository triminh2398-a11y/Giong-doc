{"dur": 165.57, "scenes": [["hook", 0, 10.375, [0.3]], ["hook2", 10.375, 17.074, [0.2]], ["title", 17.074, 20.092, [0.2]], ["intro", 20.092, 29.36, [0.2]], ["first", 29.36, 41.651, [0.2]], ["cry", 41.651, 52.206, [0.2]], ["thay", 52.206, 57.665, [0.2]], ["thay1", 57.665, 63.785, [0.2]], ["cycle", 63.785, 74.844, [0.2]], ["turns", 74.844, 85.458, [0.2]], ["grand", 85.458, 91.12, [0.2]], ["night1", 91.12, 101.454, [0.2]], ["night2", 101.454, 114.458, [0.2]], ["gm", 114.458, 122.275, [0.2]], ["run", 122.275, 134.702, [0.2]], ["leave", 134.702, 141.593, [0.2]], ["end", 141.593, 153.704, [0.2]], ["cta", 153.704, 165.568, [0.2, 6.75]]], "subs": [[0.33, 1.66, "Ở một tỉnh miền Tây,", "N"], [1.66, 2.77, "giữa bãi cỏ dại,", "N"], [2.77, 4.68, "có một căn nhà ngói cũ bỏ hoang", "N"], [4.68, 5.64, "mấy chục năm.", "N"], [5.64, 6.97, "Người trong xóm nói,", "N"], [6.97, 9.09, "đêm đêm trong nhà vẫn vọng ra tiếng", "N"], [9.09, 10.02, "con nít khóc.", "N"], [10.61, 12.7, "Gia đình chủ nhà từng mời thầy về", "N"], [12.7, 14.91, "trấn yểm, cứ bốn năm tháng một lần.", "N"], [14.91, 16.36, "Vậy mà không ai ở nổi.", "N"], [17.3, 19.38, "Câu chuyện hôm nay… Căn nhà bỏ hoang.", "N"], [20.32, 22.48, "Câu chuyện này do người cháu của chủ", "N"], [22.48, 23.32, "nhà kể lại.", "N"], [23.32, 25.32, "Ngày xưa, ông nội anh cất căn nhà", "N"], [25.32, 26.42, "này, tường gạch,", "N"], [26.42, 27.31, "mái ngói đỏ,", "N"], [27.31, 28.65, "khang trang nhất xóm.", "N"], [29.59, 31.17, "Nhưng từ ngày dọn vào,", "N"], [31.17, 32.93, "nhà bắt đầu có chuyện lạ.", "N"], [32.93, 35.57, "Nửa đêm nghe tiếng bước chân ngoài hiên.", "N"], [35.57, 37.16, "Cửa cài then kỹ lưỡng,", "N"], [37.16, 38.68, "sáng ra lại mở toang.", "N"], [38.68, 41.29, "Chén bát trong tủ rớt xuống bể tan tành.", "N"], [41.88, 43.81, "Lạ nhất là tiếng em bé khóc.", "N"], [43.81, 45.56, "Nhà không có đứa nhỏ nào,", "N"], [45.56, 47.9, "vậy mà đêm nào cũng nghe tiếng khóc", "N"], [47.9, 49.66, "oe oe, lúc ở buồng trong,", "N"], [49.66, 51.5, "lúc ở ngay dưới gầm giường.", "N"], [52.44, 54.35, "Ông nội mời thầy về trấn yểm.", "N"], [54.35, 55.87, "Thầy dán bùa khắp cửa,", "N"], [55.87, 57.31, "chôn bùa bốn góc nhà.", "N"], [57.9, 59.09, "“Đất này có vong.”", "TH"], [59.09, 61.47, "“Tui chỉ trấn được một thời gian thôi.”", "TH"], [61.47, 63.37, "“Muốn yên, phải biết nó là ai.”", "TH"], [64.01, 65.64, "Được vài tháng thì yên.", "N"], [65.64, 67.49, "Rồi mọi chuyện lại bắt đầu.", "N"], [67.49, 68.77, "Cứ bốn năm tháng,", "N"], [68.77, 70.34, "nhà lại phải mời thầy.", "N"], [70.34, 71.9, "Bùa dán chồng lên bùa.", "N"], [71.9, 74.13, "Mà tiếng khóc thì mỗi lúc một gần.", "N"], [75.07, 76.02, "Ông nội mất.", "N"], [76.02, 78.09, "Con cháu lần lượt thay nhau về ở", "N"], [78.09, 80.04, "giữ nhà. Người ở được nửa năm,", "N"], [80.04, 81.65, "người chỉ được vài tuần.", "N"], [81.65, 82.99, "Rồi ai cũng dọn đi,", "N"], [82.99, 84.75, "không ai dám nói rõ vì sao.", "N"], [85.69, 86.71, "Người cháu kể,", "N"], [86.71, 87.96, "năm hai mươi tuổi,", "N"], [87.96, 88.98, "anh không tin,", "N"], [88.98, 90.41, "xin về ở thử một mình.", "N"], [91.35, 92.23, "Đêm thứ ba,", "N"], [92.23, 94.36, "tiếng em bé khóc vang lên ngay sát", "N"], [94.36, 96.88, "bên giường. Anh soi đèn xuống gầm giường.", "N"], [96.88, 97.82, "Không có ai.", "N"], [97.82, 99.79, "Chỉ có mấy dấu tay người lớn in", "N"], [99.79, 100.74, "trên lớp bụi.", "N"], [101.68, 102.61, "Đêm thứ bảy,", "N"], [102.61, 104.19, "anh giật mình thức giấc.", "N"], [104.19, 105.23, "Ở cuối giường,", "N"], [105.23, 107.41, "có một người đàn bà ngồi quay lưng,", "N"], [107.41, 108.39, "tóc ướt sũng,", "N"], [108.39, 110.25, "tay ẵm một đứa nhỏ đang khóc.", "N"], [110.25, 111.61, "Rồi trong góc buồng,", "N"], [111.61, 113.6, "một người đàn ông từ từ bước ra.", "N"], [114.69, 119.32, "“Nhà này của gia đình tao… đi ra…”", "GM"], [122.51, 124.7, "Anh bỏ chạy ra khỏi nhà ngay trong", "N"], [124.7, 126.55, "đêm. Lúc chạy ra tới bãi cỏ,", "N"], [126.55, 127.62, "anh ngoái lại.", "N"], [127.62, 128.97, "Trước khung cửa sổ,", "N"], [128.97, 130.03, "người đàn ông,", "N"], [130.03, 131.66, "người đàn bà ẵm đứa nhỏ,", "N"], [131.66, 132.95, "đứng sát bên nhau,", "N"], [132.95, 133.99, "nhìn theo anh.", "N"], [134.93, 136.03, "Sáng hôm sau,", "N"], [136.03, 138.23, "cả nhà quyết định không ai về ở", "N"], [138.23, 140.88, "nữa. Căn nhà bị bỏ hoang từ đó tới nay.", "N"], [141.82, 143.81, "Bây giờ, cỏ dại đã mọc ngang hông", "N"], [143.81, 145.54, "người. Bùa trên cửa bạc màu,", "N"], [145.54, 146.8, "tường loang lổ rêu.", "N"], [146.8, 147.84, "Vậy mà ban đêm,", "N"], [147.84, 150.04, "người đi ngang qua vẫn nghe tiếng con", "N"], [150.04, 151.84, "nít khóc vọng ra từ trong nhà.", "N"], [153.93, 156.12, "Nếu đi ngang một căn nhà hoang mà", "N"], [156.12, 158.43, "nghe tiếng con nít khóc… bạn có dám", "N"], [158.43, 159.55, "bước vào không?", "N"], [160.49, 161.57, "Để lại bình luận,", "N"], [161.57, 163.71, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 10.5753125, 17.273937500000002, 20.29197916666667, 29.55970833333334, 41.85145833333334, 52.40614583333334, 57.86506250000001, 63.984729166666675, 75.04397916666667, 85.65766666666667, 91.3203125, 101.65364583333333, 114.65791666666667, 122.47535416666666, 134.90237499999998, 141.79306249999996, 153.9036458333333, 160.45699999999994], "durs": [9.7753125, 5.848625, 2.168041666666667, 8.417729166666666, 11.79175, 9.7046875, 4.958916666666667, 5.619666666666666, 10.20925, 9.7636875, 4.812645833333334, 9.483333333333333, 12.004270833333333, 6.8174375, 11.577020833333334, 6.0406875, 10.110583333333333, 5.703354166666666, 3.3108541666666667], "lines": ["hook", "hook2", "title", "intro", "first", "cry", "thay", "thay1", "cycle", "turns", "grand", "night1", "night2", "gm", "run", "leave", "end", "cta", "cta"], "vox": [[57.87, 58.63, "TH"], [59.31, 61.03, "TH"], [61.51, 61.97, "TH"], [62.37, 63.43, "TH"], [114.66, 119.38, "GM"]]}