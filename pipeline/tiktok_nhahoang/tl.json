{"dur": 169.0, "scenes": [["hook", 0, 10.213, [0.3]], ["hook2", 10.213, 16.892, [0.2]], ["title", 16.892, 20.942, [0.2]], ["move", 20.942, 31.936, [0.2]], ["water", 31.936, 42.429, [0.2]], ["kitchen", 42.429, 56.976, [0.2]], ["cry", 56.976, 66.774, [0.2]], ["light", 66.774, 73.775, [0.2]], ["mirror", 73.775, 84.763, [0.2]], ["turn", 84.763, 91.273, [0.2]], ["thay", 91.273, 97.259, [0.2]], ["thay1", 97.259, 104.492, [0.2]], ["cycle", 104.492, 114.124, [0.2]], ["heavy", 114.124, 122.973, [0.2]], ["gm", 122.973, 130.79, [0.2]], ["night2", 130.79, 137.184, [0.2]], ["leave", 137.184, 143.974, [0.2]], ["end", 143.974, 157.687, [0.2]], ["cta", 157.687, 169.002, [0.2, 6.2]]], "subs": [[0.33, 1.77, "Ở một tỉnh miền Tây,", "N"], [1.77, 3.9, "có căn nhà ngói giữa bãi cỏ dại,", "N"], [3.9, 5.45, "bỏ hoang mấy chục năm.", "N"], [5.45, 7.93, "Đêm đêm, người đi ngang vẫn nghe trong", "N"], [7.93, 9.85, "nhà vọng ra tiếng em bé khóc.", "N"], [10.44, 12.48, "Gia đình cuối cùng dọn vào đó,", "N"], [12.48, 14.23, "chỉ trụ được hơn một năm.", "N"], [14.23, 16.18, "Và đây là những gì họ đã gặp.", "N"], [17.12, 20.23, "Câu chuyện hôm nay… Căn nhà bỏ hoang.", "N"], [21.17, 23.04, "Vợ chồng anh Hòa chị Ngân,", "N"], [23.04, 24.92, "cùng bà Năm là mẹ của anh,", "N"], [24.92, 27.03, "mua lại căn nhà với giá rẻ bất", "N"], [27.03, 28.54, "ngờ. Nhà tường gạch,", "N"], [28.54, 29.57, "mái ngói đỏ,", "N"], [29.57, 31.23, "sân rộng, ai cũng mừng.", "N"], [32.17, 33.52, "Ngay đêm đầu tiên,", "N"], [33.52, 34.58, "đúng nửa đêm,", "N"], [34.58, 36.87, "dưới bếp có tiếng nước chảy ào ào.", "N"], [36.87, 38.22, "Anh Hòa xuống coi.", "N"], [38.22, 40.28, "Lu nước tràn lênh láng ra nền,", "N"], [40.28, 42.07, "mà cái nắp lu vẫn đậy kín.", "N"], [42.66, 45.03, "Đêm sau, dưới bếp lại có tiếng nồi", "N"], [45.03, 46.55, "niêu khua lẻng xẻng,", "N"], [46.55, 48.26, "tiếng chén bát va nhau,", "N"], [48.26, 49.96, "như có ai đang dọn cơm.", "N"], [49.96, 51.0, "Bật đèn lên,", "N"], [51.0, 52.22, "bếp trống trơn.", "N"], [52.22, 54.35, "Chỉ có ba cái chén úp sẵn trên", "N"], [54.35, 56.27, "bàn, mà nhà chưa ai lấy ra.", "N"], [57.21, 58.87, "Rồi tới tiếng em bé khóc.", "N"], [58.87, 60.52, "Nhà không có đứa nhỏ nào,", "N"], [60.52, 62.68, "vậy mà nửa đêm nào cũng nghe tiếng", "N"], [62.68, 63.57, "khóc oe oe,", "N"], [63.57, 64.84, "lúc ở buồng trong,", "N"], [64.84, 66.41, "lúc ở ngay ngoài cửa sổ.", "N"], [67.0, 69.14, "Đèn trong nhà chớp tắt liên hồi.", "N"], [69.14, 71.04, "Cửa buồng cài then kỹ lưỡng,", "N"], [71.04, 71.91, "tự bật mở,", "N"], [71.91, 72.91, "rồi đóng sầm.", "N"], [74.0, 76.39, "Một đêm, chị Ngân đứng chải tóc trước", "N"], [76.39, 77.75, "gương. Trong gương,", "N"], [77.75, 78.77, "sau lưng chị,", "N"], [78.77, 80.81, "có một người đàn bà tóc dài ướt", "N"], [80.81, 82.29, "sũng, tay ẵm đứa nhỏ,", "N"], [82.29, 83.9, "đứng nhìn chị chằm chằm.", "N"], [84.99, 86.28, "Chị quay phắt lại.", "N"], [86.28, 87.74, "Sau lưng không có ai.", "N"], [87.74, 90.56, "Chỉ có một vũng nước đọng dưới nền, lạnh ngắt.", "N"], [91.5, 92.69, "Bà Năm hoảng quá,", "N"], [92.69, 94.08, "mời thầy về trấn yểm.", "N"], [94.08, 95.53, "Thầy dán bùa khắp cửa,", "N"], [95.53, 96.9, "chôn bùa bốn góc nhà.", "N"], [97.49, 99.53, "“Nhà này có cả một gia đình vong.”", "TH"], [99.53, 101.85, "“Tui chỉ trấn được một thời gian thôi.”", "TH"], [101.85, 104.08, "“Bốn năm tháng phải trấn lại một lần.”", "TH"], [104.72, 106.34, "Được vài tháng thì yên.", "N"], [106.34, 108.19, "Rồi mọi chuyện lại bắt đầu,", "N"], [108.19, 109.69, "mỗi lần một nặng hơn.", "N"], [109.69, 111.25, "Bùa dán chồng lên bùa.", "N"], [111.25, 113.41, "Thầy về hết lần này tới lần khác.", "N"], [114.35, 116.32, "Đêm nọ, anh Hòa nghe tiếng bước chân", "N"], [116.32, 117.71, "nặng nề đi quanh giường.", "N"], [117.71, 118.47, "Anh mở mắt.", "N"], [118.47, 120.49, "Một người đàn ông mặt trắng bệch đứng", "N"], [120.49, 121.49, "ngay đầu giường,", "N"], [121.49, 122.61, "cúi xuống nhìn anh.", "N"], [123.2, 127.83, "“Nhà này của gia đình tao… đi ra…”", "GM"], [131.02, 132.16, "Ngoài cửa buồng,", "N"], [132.16, 134.18, "người đàn bà ẵm đứa nhỏ đứng đó.", "N"], [134.18, 136.32, "Đứa nhỏ trên tay bà ta khóc ré lên.", "N"], [137.41, 138.36, "Sáng hôm sau,", "N"], [138.36, 139.36, "cả nhà dọn đi,", "N"], [139.36, 140.67, "không dám ngoái lại.", "N"], [140.67, 141.82, "Căn nhà khóa cửa,", "N"], [141.82, 143.26, "bỏ hoang từ đó tới nay.", "N"], [144.2, 146.62, "Bây giờ cỏ dại mọc ngang hông người.", "N"], [146.62, 148.15, "Bùa trên cửa bạc màu,", "N"], [148.15, 149.56, "tường loang lổ rêu.", "N"], [149.56, 150.97, "Người trong xóm kể,", "N"], [150.97, 153.33, "đêm đêm vẫn thấy đèn trong nhà chớp", "N"], [153.33, 155.83, "tắt, và nghe tiếng em bé khóc vọng ra.", "N"], [157.92, 159.93, "Nếu đi ngang một căn nhà hoang mà", "N"], [159.93, 161.95, "nghe tiếng em bé khóc… bạn có dám", "N"], [161.95, 162.98, "bước vào không?", "N"], [163.92, 165.0, "Để lại bình luận,", "N"], [165.0, 167.14, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 10.412770833333335, 17.09172916666667, 21.14172916666667, 32.13643750000001, 42.62854166666668, 57.17602083333335, 66.97366666666667, 73.97483333333334, 84.96339583333334, 91.4730625, 97.45929166666666, 104.69247916666666, 114.32404166666666, 123.17277083333333, 130.99020833333333, 137.38356249999998, 144.1743958333333, 157.8869375, 163.89116666666663], "durs": [9.612770833333334, 5.8289583333333335, 3.2, 10.144708333333334, 9.992104166666667, 13.697479166666668, 9.297645833333334, 6.001166666666666, 9.9885625, 5.659666666666666, 5.486229166666667, 6.7331875, 8.7815625, 8.348729166666667, 6.8174375, 5.393354166666667, 5.940833333333333, 11.712541666666667, 5.154229166666667, 3.3108541666666667], "lines": ["hook", "hook2", "title", "move", "water", "kitchen", "cry", "light", "mirror", "turn", "thay", "thay1", "cycle", "heavy", "gm", "night2", "leave", "end", "cta", "cta"], "vox": [[97.46, 97.84, "TH"], [98.26, 99.46, "TH"], [100.12, 101.12, "TH"]