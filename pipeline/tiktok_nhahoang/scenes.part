// ================= cảnh: CĂN NHÀ BỎ HOANG =================
const S={};let ctaFlag=false,BLACK=0,TITLE=false,RED=0,RAIN=0,FLASH=0,NOW=0,CCTV=0;
const JUMPS=[['hook2',0.06,0.45,1],['title',0.02,0.4,1],['gm',0.3,0.45,1]];
const SOFT=[['night2',0.75,0.25,0]];
const TK=sp=>{for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a&&NOW<b)return Math.sin(NOW*14)>-0.2?'o':undefined}return undefined};
const flick=T=>0.85+0.15*Math.sin(T*11)*Math.sin(T*3.7);
const bedNight=(l=0.6)=>{night();lampL.intensity=l;moonSpot.intensity=4};
const FZ=HD/2+0.2;// mép hiên
const RV=(m,old)=>{ruinMode(m,old)};
// ---- mở đầu ----
S.hook=(lt,D,T)=>{CUR='ruin';RV('night');buaN(6,true);winGlow.intensity=0.6*flick(T);const p=sm(lt/D);cm([lerp(-6,-2,p),lerp(2.2,1.6,p),lerp(16,9,p)],[0,1.4,0],lerp(48,42,p));return 'ruin'};
S.hook2=(lt,D,T)=>{CUR='inn';bedNight(0.25);fillL.color.set(0xa8c0d8);fillL.intensity=2.6;fillL.position.set(-1.0,1.6,0.6);put(C.gw,-1.2,-0.6,{a:0.95,baby:true,open:0.7});const c=C.gw;cm([c.position.x+0.1,1.3,c.position.z+lerp(2.0,1.6,sm(lt/D))],[c.position.x,1.15,c.position.z],38);RED=0.08*(1-sm(lt/D));return 'inn'};
S.title=(lt,D,T)=>{CUR='ruin';RV('night');TITLE=true;buaN(6,true);rFill.color.set(0xa8c0d8);rFill.intensity=4;rFill.position.set(0,1.8,FZ+3);put(C.gw,0,FZ-0.7,{a:0.95,baby:true});cm([0,1.75,FZ+lerp(4.4,3.8,sm(lt/D))],[0,1.2,FZ-0.7],40);BLACK=0.35;return 'ruin'};
// ---- ông nội cất nhà ----
S.intro=(lt,D,T)=>{CUR='ruin';RV('day',true);put(C.noi,-1.2,FZ+1.4,{eyes:1,look:1,T});const p=sm(lt/D);cm([lerp(5,2,p),1.6,lerp(13,9,p)],[0,1.4,0.5],46);return 'ruin'};
S.first=(lt,D,T)=>{CUR='inn';bedNight(0.3);if(lt<D*0.5){const q=sm(seg(lt,D*0.25,D*0.5));buongDoor(q);cm([0.6,1.5,1.6],[3.0,1.2,-1.1],44);return 'inn'}put(C.noi,0.6,0.2,{eyes:1.35,pupil:2,T});lampL.intensity=1.0;close(C.noi,1.2,36,0.25);return 'inn'};
S.cry=(lt,D,T)=>{CUR='inn';bedNight(0.4);inBed(C.noi,1,{eyes:1.35,pupil:2,look:-1,T});if(lt<D*0.5){cm([BED.position.x+0.3,1.7,BED.position.z+2.0],[BED.position.x,1.0,BED.position.z-0.6],44);return 'inn'}cm([BED.position.x+0.2,0.25,BED.position.z+1.4],[BED.position.x,0.15,BED.position.z],50);return 'inn'};
// ---- trấn yểm ----
S.thay=(lt,D,T)=>{CUR='ruin';RV('day',true);buaN(Math.min(6,1+Math.floor(lt/D*4)));put(C.thay2,0.9,FZ-0.9,{bua:true,eyes:1,look:-1,T});put(C.noi,2.0,FZ+0.2,{eyes:1,look:-1,T});cm([1.6,1.5,FZ+3.4],[0.3,1.3,FZ-1.2],44);return 'ruin'};
S.thay1=(lt,D,T)=>{CUR='ruin';RV('day',true);buaN(4);put(C.thay2,0.9,FZ-0.5,{eyes:1.05,mouth:TK('TH'),T});close(C.thay2,lerp(1.4,1.15,sm(lt/D)),36,0.25);return 'ruin'};
S.cycle=(lt,D,T)=>{CUR='ruin';const k=Math.min(3,Math.floor(lt/(D*0.25)));RV(k%2?'dusk':'day',true);buaN(3+k);cm([0.2,1.55,FZ+lerp(2.6,1.6,sm(lt/D))],[0,1.45,FZ-1.25],40);return 'ruin'};
// ---- con cháu thay nhau ở rồi đi ----
S.turns=(lt,D,T)=>{CUR='ruin';RV('dusk',true);buaN(6);const k=Math.min(2,Math.floor(lt/(D/3)));const q=(lt-k*D/3)/(D/3);const who=[C.phuc,C.lien,C.bay][k];put(who,lerp(-0.4,-5,q),lerp(FZ+0.8,FZ+4,q),{bundle:true,walk:T*6,phase:T*6,eyes:0.9,look:-1,T});cm([3,1.6,FZ+8],[-1.5,1.0,FZ+1.5],44);return 'ruin'};
// ---- người cháu ở thử ----
S.grand=(lt,D,T)=>{CUR='ruin';RV('day',true);buaN(6,true);const p=sm(lt/D);put(C.chau,lerp(-3,-0.5,p),lerp(FZ+5,FZ+0.8,p),{phase:T*6,eyes:1,T});cm([lerp(-1,1,p),1.6,FZ+8],[lerp(-2,-0.4,p),1.0,FZ+1],44);return 'ruin'};
S.night1=(lt,D,T)=>{CUR='inn';bedNight(0.3);if(lt<D*0.45){inBed(C.chau,0,{eyes:1.35,pupil:2,look:1,T});cm([BED.position.x+0.3,1.7,BED.position.z+2.0],[BED.position.x,1.0,BED.position.z-0.6],44);return 'inn'}
 HPR.visible=true;lampL.intensity=1.4;lampL.position.set(BED.position.x+0.3,0.3,BED.position.z+0.9);cm([BED.position.x+0.25,0.3,BED.position.z+1.5],[BED.position.x,0.02,BED.position.z+0.6],48);return 'inn'};
S.night2=(lt,D,T)=>{CUR='inn';bedNight(0.35);fillL.color.set(0xa8c0d8);fillL.intensity=2.6;fillL.position.set(BED.position.x+1.4,1.6,BED.position.z+1.6);inBed(C.chau,0,{eyes:1.4,pupil:2,T});put(C.gw,BED.position.x+0.4,BED.position.z+1.25,{sitBack:true,baby:true,a:0.95},0.05);
 if(lt>D*0.6){const q=sm(seg(lt,D*0.6,D));put(C.gm,BED.position.x+1.6,BED.position.z+0.2,{a:0.9*q})}
 cm([BED.position.x+1.4,1.75,BED.position.z+3.8],[BED.position.x+0.6,0.85,BED.position.z+0.6],46);return 'inn'};
S.gm=(lt,D,T)=>{CUR='inn';bedNight(0.35);fillL.color.set(0xa8c0d8);fillL.intensity=2.6;fillL.position.set(BED.position.x+1.4,1.6,BED.position.z+1.6);put(C.gm,BED.position.x+1.2,BED.position.z+0.5,{a:0.95,open:0.3+0.4*Math.max(0,Math.sin(T*9))});put(C.gw,BED.position.x+1.9,BED.position.z+0.1,{a:0.9,baby:true});const c=C.gm;cm([c.position.x+0.3,1.3,c.position.z+lerp(2.0,1.6,sm(lt/D))],[c.position.x+0.3,1.15,c.position.z],40);return 'ruin'===0?0:'inn'};
S.run=(lt,D,T)=>{CUR='ruin';RV('night',true);buaN(6);if(lt<D*0.45){const p=sm(lt/(D*0.45));put(C.chau,lerp(-0.4,-2.4,p),lerp(FZ+0.6,FZ+5,p),{phase:T*10,eyes:1.4,pupil:2,T});cm([1.5,1.9,FZ+9],[-1.2,1.0,FZ+2.5],44);return 'ruin'}
 winGlow.intensity=1.2*flick(T);rFill.color.set(0xa8c0d8);rFill.intensity=3.5;rFill.position.set(2.8,1.6,FZ+1.5);put(C.gm,2.4,FZ-1.0,{a:0.9});put(C.gw,3.2,FZ-1.0,{a:0.9,baby:true,wave:true});const q=sm(seg(lt,D*0.45,D));cm([lerp(-1,2.4,q),1.9,FZ+lerp(8,5.6,q)],[2.8,1.25,FZ-1],lerp(40,30,q));return 'ruin'};
S.leave=(lt,D,T)=>{CUR='ruin';RV('day',true);buaN(6);const p=sm(lt/D);put(C.phuc,lerp(-0.6,-4,p),lerp(FZ+1,FZ+4,p),{bundle:true,walk:T*6,phase:T*6,eyes:0.9,T});put(C.lien,lerp(0.2,-3.2,p),lerp(FZ+1.2,FZ+4.2,p),{bundle:true,walk:T*6,eyes:0.9,T});put(C.chau,lerp(0.9,-2.4,p),lerp(FZ+1.1,FZ+4.1,p),{phase:T*6,eyes:0.9,T});cm([3,1.6,FZ+8],[-1.5,1.0,FZ+2],44);return 'ruin'};
S.end=(lt,D,T)=>{CUR='ruin';RV('night');buaN(6,true);winGlow.intensity=0.5*flick(T);const p=sm(lt/D);cm([lerp(-4,-1,p),1.5,lerp(15,9,p)],[0,1.3,0],lerp(46,40,p));return 'ruin'};
S.cta=(lt,D,T)=>{CUR='ruin';RV('night');ctaFlag=true;buaN(6,true);winGlow.intensity=0.4*flick(T);cm([2,1.5,15],[0,1.5,0],46);return 'ruin'};
// ===== LỚP CHUYỂN ĐỘNG CHUNG (áp cho mọi cảnh) =====
const HSH=s=>{let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))%9973;return h/9973};
const SPK={thay2:'TH'};const STILL={};
const speaking=(kk)=>{const sp=SPK[kk];if(!sp)return false;for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a-0.05&&NOW<b+0.15)return true}return false};
const GHOST={gw:1,gk:1,gm:1};
function startleAt(t){let best=-1;for(const [jk,jf] of JUMPS.concat(SOFT)){const q=TLD.scenes.find(x=>x[0]===jk);if(!q)continue;const d=t-(q[1]+(q[2]-q[1])*jf);if(d>=0&&d<0.7)best=d}return best}
function motionPre(kk,c,t){if(STILL[kk]){c.userData.o0=c.userData.o;return}const o=Object.assign({},c.userData.o);const h=HSH(kk);
 if(!GHOST[kk]&&!o.back){const per=3.2+h*1.6,u=(t+h*7)%per;if(u<0.13&&(o.eyes===undefined||o.eyes>0.3))o.eyes=0.05}
 if(speaking(kk)&&!o.pot&&!o.phone&&!o.phoneLap&&!o.point&&!o.sit&&!o.back){const g=-0.18-0.22*Math.max(0,Math.sin(t*2.6+h*5));
  if(kk==='lien'||kk==='bay'){const a=(o.arm||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.arm=a}}else{const a=(o.armA||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.armA=a}}}
 if(!GHOST[kk]&&!speaking(kk)&&o.walk===undefined&&o.phase===undefined&&!o.jar&&!o.pot&&!o.clutch&&!o.bell&&!o.ears&&!o.cover&&!o.sit&&!o.back&&!o.hoe){const sw=0.05*Math.sin(t*1.1+h*7);if(kk==='lien'||kk==='bay'){const ar=(o.arm||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.12+sw;if(ar[1]===undefined)ar[1]=0.12+sw;o.arm=ar}else if(kk==='noi'||kk==='thay2'||kk==='chau'||kk==='phuc'){const ar=(o.armA||[undefined,undefined]).slice();if(ar[0]===undefined)ar[0]=-0.1+sw;if(ar[1]===undefined)ar[1]=0.1+sw;o.armA=ar}}
 if(o.walk!==undefined&&(kk==='lien'||kk==='bay')&&!o.pot){const a=(o.arm||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.32*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.32*Math.sin(o.walk);o.arm=a}
 c.userData.o0=c.userData.o;c.userData.o=o}
function motionPost(kk,c,t){if(STILL[kk]){c.userData.o=c.userData.o0;return}const h=HSH(kk);
 if(c.userData.o&&c.userData.o.crawl){c.rotateZ(1.3);}
 if(GHOST[kk]){c.position.y+=0.03*Math.sin(t*1.2+h*6);c.rotateZ(0.03*Math.sin(t*0.6+h*3));}
 else{const br=0.012*Math.sin(t*2.2+h*9);c.position.x+=0.012*Math.sin(t*0.7+h*5);c.scale.set(1,1+br,1);c.position.y+=0.98*br;c.rotateZ(0.012*Math.sin(t*0.9+h*4));
  if(speaking(kk))c.rotateZ(0.02*Math.sin(t*5.5+h));
  const d=startleAt(t);if(d>=0){const k=1-d/0.7;c.position.x+=0.035*Math.sin(d*55)*k;c.scale.y*=1-0.03*k}}
 c.userData.o=c.userData.o0}
// ================= vòng vẽ =================
function rain(a){g2.save();g2.strokeStyle=`rgba(180,200,230,${0.35*a})`;g2.lineWidth=1.6;for(let i=0;i<140;i++){const x=(R(i)*RW*1.2+NOW*60)%(RW*1.2)-RW*0.1,y=(R(i+300)*RH+NOW*1800*(0.8+R(i+7)*0.4))%RH;g2.beginPath();g2.moveTo(x,y);g2.lineTo(x-6,y+38);g2.stroke()}g2.restore()}
window.draw=function(t){NOW=t;const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;CCTV=0;BLACK=0;TITLE=false;RED=0;RAIN=0;FLASH=0;blkA.scale.set(1.25,1,0.8);g2.clearRect(0,0,RW,RH);
 CC.inn.loi.castShadow=true;
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set(1.4+(R(i+5)-0.5)*7,0.3+((R(i+9)*2.5+t*0.05)%2.5),-2.4+p*4);m.material.opacity=0.3*Math.sin(p*Math.PI)});
 smoke.forEach((s,i)=>{const p=(t*0.15+i/12)%1;s.position.set(1.2+Math.sin(p*6+i)*0.06,2.3+p*0.9,-2.35);s.scale.setScalar(0.08+p*0.3);s.material.opacity=0.18*Math.sin(p*Math.PI)});
 riceWind(t);JAR_E.visible=false;JAR_I.visible=false;foundL.intensity=0;HANDS.forEach(h=>h.visible=false);eSun.intensity=0;eMist.forEach((m,i)=>{const z=4+i*0.7;const x=((R(i)*20+t*0.12)%20)-10;m.position.set(x,0.6+R(i+2)*0.5,z)});
 mist.forEach((m,i)=>{const z=6-i*0.6;const x=((R(i)*14+t*0.15)%14)-7;m.position.set(x,H(x,z)+0.5+R(i+2)*0.6,z)});
 if(!S[k])console.log('missing',k);const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 let JF=-1;for(const [jk,jf,jz,hard] of JUMPS.concat(SOFT)){const sc2=TLD.scenes.find(q=>q[0]===jk);if(!sc2)continue;const tj=sc2[1]+(sc2[2]-sc2[1])*jf,dt=t-tj;if(dt<0||dt>1.4)continue;const z=dt<0.1?dt/0.1*jz:jz*Math.max(0,1-(dt-0.1)/1.3);const tv=new THREE.Vector3(...CT);cam.position.lerp(tv,z);if(hard&&dt<0.5){const a2=0.05*(1-dt/0.5);cam.position.x+=(R(t*977)-0.5)*a2*2;cam.position.y+=(R(t*631)-0.5)*a2*2}cam.lookAt(tv);if(hard)JF=dt}
 for(const kk in CC[mode]){const c=CC[mode][kk];if(!c.visible){c.scale.set(1,1,1);continue}motionPre(kk,c,t);c.userData.paint(t);c.scale.set(1,1,1);c.lookAt(cam.position.x,c.position.y,cam.position.z);motionPost(kk,c,t)}
 renderer.render(SCN[mode],cam);renderer.domElement.style.filter=CCTV?"grayscale(1) contrast(1.35) brightness(1.2)":"";
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.55)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(RAIN)rain(RAIN);
 if(FLASH){g2.fillStyle=`rgba(220,230,255,${FLASH})`;g2.fillRect(0,0,RW,RH)}
 if(RED){g2.fillStyle=`rgba(140,0,0,${RED})`;g2.fillRect(0,0,RW,RH)}
 if(JF>=0&&JF<0.3){if(JF<0.06){g2.fillStyle='rgba(255,255,255,.55)';g2.fillRect(0,0,RW,RH)}else{g2.fillStyle=`rgba(160,0,0,${0.35*(1-JF/0.3)})`;g2.fillRect(0,0,RW,RH)}}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 grain(CCTV?0.14:0.06);if(CCTV)cctvOv(t);
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
