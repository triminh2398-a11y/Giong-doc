{"dur": 233.3, "scenes": [["hook", 0, 7.68, [0.3]], ["hook2", 7.68, 12.199, [0.2]], ["title", 12.199, 13.772, [0.2]], ["dig", 13.772, 22.08, [0.2]], ["dig2", 22.08, 30.475, [0.2]], ["man1", 30.475, 35.769, [0.2]], ["lanh1", 35.769, 40.62, [0.2]], ["hide", 40.62, 48.946, [0.2]], ["na1", 48.946, 55.084, [0.2]], ["na2", 55.084, 60.607, [0.2]], ["bell", 60.607, 67.394, [0.2]], ["odd", 67.394, 77.135, [0.2]], ["sick", 77.135, 83.81, [0.2]], ["tu", 83.81, 88.504, [0.2]], ["tu1", 88.504, 98.23, [0.2]], ["tu2", 98.23, 103.435, [0.2]], ["tu3", 103.435, 118.178, [0.2]], ["miss", 118.178, 122.052, [0.2]], ["earring", 122.052, 127.684, [0.2]], ["night", 127.684, 135.932, [0.2]], ["call", 135.932, 141.572, [0.2]], ["gm", 141.572, 149.55, [0.2]], ["nayes", 149.55, 154.326, [0.2]], ["bell2", 154.326, 162.927, [0.2]], ["boy", 162.927, 170.412, [0.2]], ["gb", 170.412, 178.41, [0.2]], ["pry", 178.41, 186.045, [0.2]], ["pull", 186.045, 194.679, [0.2]], ["let", 194.679, 200.678, [0.2]], ["end", 200.678, 208.285, [0.2]], ["end2", 208.285, 216.571, [0.2]], ["na3", 216.571, 223.351, [0.2]], ["cta", 223.351, 233.296, [0.2, 4.95]]], "subs": [[0.33, 1.44, "Ở miền Tây xưa,", "N"], [1.44, 3.73, "nhà giàu chôn của thường bắt một đứa", "N"], [3.73, 5.29, "nhỏ ngồi canh dưới hầm.", "N"], [5.29, 7.32, "Người ta gọi nó là thần giữ của.", "N"], [7.91, 9.71, "Ai đào trúng hũ của đó… thì đứa", "N"], [9.71, 11.49, "nhỏ sẽ đi theo người đó về nhà.", "N"], [12.43, 13.41, "Chuyện thần giữ của.", "N"], [14.0, 16.08, "Vợ chồng Lành nghèo rớt mồng tơi.", "N"], [16.08, 17.93, "Bữa dỡ cái nền nhà cũ của ông", "N"], [17.93, 18.97, "cố để cất lại,", "N"], [18.97, 21.72, "lưỡi cuốc của Lành chạm trúng một cái hũ sành.", "N"], [22.31, 23.72, "Miệng hũ bịt sáp ong,", "N"], [23.72, 25.57, "dán một lá bùa đỏ đã bạc màu.", "N"], [25.57, 26.99, "Bên trong là vàng lá,", "N"], [26.99, 27.97, "đôi bông tai,", "N"], [27.97, 30.12, "và một cái lục lạc nhỏ của con nít.", "N"], [30.75, 33.11, "“Anh ơi… của người ta chôn thì để”", "MA"], [33.11, 35.32, "“người ta. Em thấy ghê quá anh.”", "MA"], [36.02, 37.36, "“Của trời cho mà em.”", "LA"], [37.36, 38.26, "“Có cái này,”", "LA"], [38.26, 40.19, "“con Na khỏi phải nghỉ học nữa.”", "LA"], [40.85, 43.18, "Lành giấu cái hũ dưới gầm giường.", "N"], [43.18, 44.28, "Sáng hôm sau,", "N"], [44.28, 46.49, "anh lén đem đôi bông tai ra chợ", "N"], [46.49, 48.24, "bán, mua tập vở cho con.", "N"], [49.18, 51.27, "Đêm đó, bé Na ngồi trên giường,", "N"], [51.27, 52.72, "nói chuyện một mình.", "N"], [52.72, 54.72, "Mận hỏi con nói chuyện với ai.", "N"], [55.37, 56.74, "“Với anh Hai đó má.”", "NA"], [56.74, 58.54, "“Ảnh ngồi dưới gầm giường.”", "NA"], [58.54, 60.18, "“Ảnh cho con cái này nè.”", "NA"], [60.84, 62.75, "Trong tay con bé là cái lục lạc", "N"], [62.75, 64.81, "trong hũ. Nhà Lành chỉ có mình con", "N"], [64.81, 66.53, "Na. Không có ai tên Hai hết.", "N"], [67.62, 69.73, "Từ đó, đêm nào cũng nghe lục lạc", "N"], [69.73, 71.5, "leng keng dưới gầm giường.", "N"], [71.5, 73.33, "Chén cơm cúng trên bàn thờ,", "N"], [73.33, 74.64, "sáng ra sạch trơn,", "N"], [74.64, 76.77, "dính đầy dấu tay con nít lấm bùn.", "N"], [77.36, 78.54, "Rồi bé Na đổ bệnh.", "N"], [78.54, 79.61, "Người lạnh ngắt,", "N"], [79.61, 80.48, "môi tím tái.", "N"], [80.48, 82.31, "Nửa đêm nó bò xuống gầm giường,", "N"], [82.31, 83.1, "bốc đất ăn.", "N"], [84.04, 85.88, "Mận bồng con chạy lên chân núi,", "N"], [85.88, 86.69, "tìm ông Tư,", "N"], [86.69, 88.14, "thầy pháp già nhất vùng.", "N"], [88.75, 91.8, "“Thằng nhỏ trong hũ là thần giữ của.”", "TU"], [91.8, 93.4, "“Nó bị chôn sống,”", "TU"], [93.4, 95.39, "“canh của cả trăm năm.”", "TU"], [95.39, 96.61, "“Của đi đâu,”", "TU"], [96.61, 97.8, "“nó theo đó.”", "TU"], [98.48, 100.54, "“Nó đưa đồ của nó cho ai… là”", "TU"], [100.54, 103.01, "“nó chọn người đó ngồi canh thế nó.”", "TU"], [103.68, 105.99, "“Đêm nay, trước khi gà gáy,”", "TU"], [105.99, 108.29, "“đem hũ về chôn lại chỗ cũ,”", "TU"], [108.29, 109.56, "“đủ từng món,”", "TU"], [109.56, 111.27, "“kể cả cái lục lạc.”", "TU"], [111.27, 112.68, "“Thiếu một món,”", "TU"], [112.68, 114.02, "“nó bắt người.”", "TU"], [114.02, 115.81, "“Còn nữa: nó kêu gì,”", "TU"], [115.81, 117.71, "“cũng đừng ai trả lời.”", "TU"], [118.41, 119.46, "Mận chết điếng.", "N"], [119.46, 120.41, "Đôi bông tai,", "N"], [120.41, 121.69, "Lành đã bán mất rồi.", "N"], [122.28, 123.58, "Không kịp chuộc lại,", "N"], [123.58, 125.6, "Mận tháo đôi bông tai cưới má ruột", "N"], [125.6, 126.97, "cho, bỏ vô hũ thế vào.", "N"], [127.91, 130.0, "Nửa đêm, Lành ôm hũ ra nền nhà", "N"], [130.0, 131.97, "cũ. Mận bồng bé Na theo sau.", "N"], [131.97, 133.52, "Cái hố cũ vẫn còn đó,", "N"], [133.52, 135.22, "tối đen như miệng giếng.", "N"], [136.16, 137.71, "Lành vừa đặt cái hũ xuống,", "N"], [137.71, 139.5, "thì dưới hố vọng lên tiếng gọi.", "N"], [139.5, 141.21, "Giọng giống hệt giọng của Mận.", "N"], [141.86, 147.11, "“Na ơi… lại đây má bồng con nè…”", "GM"], [149.78, 151.09, "Bé Na ngóc đầu dậy,", "N"], [151.09, 152.3, "mở miệng định dạ.", "N"], [152.3, 153.97, "Mận vội bịt miệng con lại.", "N"], [154.56, 156.8, "Lành lấp đất được một nửa thì khựng", "N"], [156.8, 158.99, "lại. Cái lục lạc vẫn còn nằm trong", "N"], [158.99, 159.83, "tay bé Na.", "N"], [159.83, 161.01, "Con bé nắm chặt,", "N"], [161.01, 162.22, "không chịu buông.", "N"], [163.16, 164.06, "Dưới đáy hố,", "N"], [164.06, 165.71, "có một thằng nhỏ trọc đầu,", "N"], [165.71, 166.73, "chừa cái chỏm,", "N"], [166.73, 167.63, "ngồi bó gối.", "N"], [167.63, 168.59, "Nó ngước lên,", "N"], [168.59, 170.05, "chìa tay về phía bé Na.", "N"], [170.66, 175.85, "“Đưa đây cho anh… rồi xuống đây ngồi với anh…”", "GB"], [178.64, 180.34, "Mận cạy từng ngón tay con.", "N"], [180.34, 181.99, "Cái lục lạc rớt xuống hố.", "N"], [181.99, 184.07, "Một bàn tay lạnh ngắt chụp lấy cổ", "N"], [184.07, 185.68, "chân Mận, kéo tuột xuống.", "N"], [186.27, 187.46, "Lành ghì vợ lại,", "N"], [187.46, 189.04, "tay kia hất đất lấp hố.", "N"], [189.04, 190.22, "Đất lấp tới đâu,", "N"], [190.22, 191.63, "bàn tay siết tới đó.", "N"], [191.63, 192.48, "Rồi xa xa,", "N"], [192.48, 193.97, "gà gáy tiếng đầu tiên.", "N"], [194.91, 196.09, "Bàn tay buông ra,", "N"], [196.09, 197.16, "chìm xuống đất.", "N"], [197.16, 199.09, "Cổ chân Mận còn in năm dấu ngón", "N"], [199.09, 199.97, "tay đen bầm.", "N"], [200.91, 202.1, "Bé Na khỏi bệnh.", "N"], [202.1, 204.37, "Dấu tay trên chân Mận thì không bao", "N"], [204.37, 206.7, "giờ phai. Và nhà Lành không cất trên", "N"], [206.7, 207.58, "nền cũ nữa.", "N"], [208.52, 209.84, "Nhưng có một chuyện,", "N"], [209.84, 211.33, "Mận chưa dám kể với ai.", "N"], [211.33, 213.3, "Chiều nào bé Na cũng ra ngồi bên", "N"], [213.3, 214.15, "nền nhà cũ,", "N"], [214.15, 215.71, "cúi xuống đất mà nói nhỏ.", "N"], [216.82, 219.3, "“Anh Hai ráng chờ nghen… chừng nào em”", "NA"], [219.3, 221.21, "“lớn… em xuống ngồi với anh.”", "NA"], [223.58, 225.58, "Nếu đào được hũ vàng có dán bùa…", "N"], [225.58, 227.39, "bạn có dám mang về nhà không?", "N"], [228.33, 229.37, "Để lại bình luận,", "N"], [229.37, 231.44, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 7.879604166666667, 12.399145833333334, 13.9718125, 22.279666666666667, 30.675041666666665, 35.96904166666666, 40.819937499999995, 49.14585416666666, 55.28429166666666, 60.806999999999995, 67.59402083333333, 77.33477083333334, 84.009625, 88.704125, 98.43002083333334, 103.63485416666668, 118.37770833333335, 122.25183333333335, 127.88433333333334, 136.1319375, 141.77168749999998, 149.75025, 154.52625, 163.12695833333333, 170.6120625, 178.61047916666666, 186.2448125, 194.87897916666665, 200.87756249999998, 208.48502083333332, 216.77102083333332, 223.55129166666666, 228.29639583333332], "durs": [7.079604166666667, 3.6695416666666665, 1.0726666666666667, 7.807854166666667, 7.895375, 4.794, 4.350895833333333, 7.4759166666666665, 5.6384375, 5.022708333333333, 5.787020833333333, 9.24075, 5.824854166666666, 4.1945, 9.225895833333333, 4.7048