{"dur": 191.25, "scenes": [["hook", 0, 9.028, [0.3]], ["hook2", 9.028, 15.52, [0.2]], ["title", 15.52, 19.31, [0.2]], ["fall", 19.31, 28.2, [0.2]], ["cross", 28.2, 37.752, [0.2]], ["sick", 37.752, 46.952, [0.2]], ["me", 46.952, 54.246, [0.2]], ["tu1", 54.246, 64.496, [0.2]], ["tu2", 64.496, 72.562, [0.2]], ["night", 72.562, 81.971, [0.2]], ["call", 81.971, 86.98, [0.2]], ["ans", 86.98, 92.58, [0.2]], ["count", 92.58, 99.263, [0.2]], ["ninth", 99.263, 102.425, [0.2]], ["call9", 102.425, 107.123, [0.2]], ["two", 107.123, 113.998, [0.2]], ["ghost", 113.998, 120.781, [0.2]], ["run", 120.781, 130.729, [0.2]], ["door", 130.729, 138.093, [0.2]], ["gt2", 138.093, 148.927, [0.2]], ["dawn", 148.927, 156.895, [0.2]], ["end", 156.895, 167.05, [0.2]], ["end2", 167.05, 181.2, [0.2]], ["cta", 181.2, 191.254, [0.2, 4.84]]], "subs": [[0.33, 1.45, "Người xưa nói,", "N"], [1.45, 3.28, "đàn ông có ba hồn bảy vía,", "N"], [3.28, 5.1, "đàn bà có ba hồn chín vía.", "N"], [5.1, 6.99, "Hễ bị hù một cái thật mạnh,", "N"], [6.99, 8.67, "vía sẽ rơi lại ở chỗ đó.", "N"], [9.26, 11.12, "Và nếu đi gọi vía về… mà nghe", "N"], [11.12, 13.36, "tới hai giọng cùng dạ… thì một trong", "N"], [13.36, 14.81, "hai, không phải người.", "N"], [15.75, 18.6, "Câu chuyện hôm nay… Ba hồn chín vía.", "N"], [19.54, 21.01, "Thư hai mươi bốn tuổi,", "N"], [21.01, 22.86, "làm công nhân ngoài thị trấn.", "N"], [22.86, 24.39, "Một tối tăng ca về trễ,", "N"], [24.39, 26.35, "cô đạp xe ngang cây cầu ván bắc", "N"], [26.35, 27.84, "qua bãi tha ma đầu xóm.", "N"], [28.43, 30.51, "Giữa cầu, có ai đó níu mạnh đuôi", "N"], [30.51, 31.8, "xe. Thư ngoái lại.", "N"], [31.8, 32.87, "Dưới chân cầu,", "N"], [32.87, 35.01, "một người đàn bà tóc dài ướt sũng", "N"], [35.01, 36.89, "đang ngước lên nhìn cô, cười.", "N"], [37.98, 38.98, "Thư té nhào,", "N"], [38.98, 40.51, "chạy một mạch về nhà.", "N"], [40.51, 41.39, "Từ đêm đó,", "N"], [41.39, 43.15, "cô như cái xác không hồn.", "N"], [43.15, 44.62, "Không ăn, không ngủ,", "N"], [44.62, 46.59, "mắt cứ nhìn trân trân ra cửa.", "N"], [47.18, 48.65, "Má Thư là bà Sáu Mai.", "N"], [48.65, 50.46, "Bà biết con gái bị mất vía,", "N"], [50.46, 51.88, "liền đi rước ông Tư,", "N"], [51.88, 53.89, "người chuyên gọi vía trong xóm.", "N"], [54.5, 56.42, "“Con nhỏ rớt vía ở cây cầu.”", "TU"], [56.42, 57.47, "“Nửa đêm nay,”", "TU"], [57.47, 58.83, "“mang áo nó ra đó,”", "TU"], [58.83, 60.12, "“gọi đủ chín lần.”", "TU"], [60.12, 61.18, "“Mỗi lần gọi,”", "TU"], [61.18, 62.78, "“nó phải dạ một tiếng,”", "TU"], [62.78, 64.05, "“vía mới chịu về.”", "TU"], [64.75, 65.69, "“Nhớ cho kỹ.”", "TU"], [65.69, 67.58, "“Chỉ được một tiếng dạ thôi.”", "TU"], [67.58, 70.0, "“Nghe hai tiếng cùng dạ… thì đừng gọi”", "TU"], [70.0, 71.74, "“nữa, dắt nó chạy về liền.”", "TU"], [72.79, 74.78, "Nửa đêm, bà Sáu cầm cái áo của", "N"], [74.78, 76.08, "Thư, một chén gạo,", "N"], [76.08, 77.1, "ba cây nhang,", "N"], [77.1, 78.29, "ra đứng đầu cầu.", "N"], [78.29, 79.71, "Thư đứng sát bên má,", "N"], [79.71, 81.61, "ông Tư cầm đèn canh phía sau.", "N"], [82.22, 84.81, "“Ba hồn chín vía con Thư ơi… về”", "MA"], [84.81, 85.97, "“nhà với má…”", "MA"], [87.21, 88.75, "Thư khẽ dạ một tiếng.", "N"], [88.75, 91.12, "Ông Tư rắc một nhúm gạo xuống nước.", "N"], [91.12, 92.22, "Một vía đã về.", "N"], [92.81, 93.75, "Lần thứ hai,", "N"], [93.75, 95.14, "thứ ba, rồi thứ tám.", "N"], [95.14, 96.09, "Mỗi lần gọi,", "N"], [96.09, 96.97, "Thư lại dạ,", "N"], [96.97, 98.55, "mặt cô hồng hào dần lên.", "N"], [99.49, 100.74, "Tới lần thứ chín,", "N"], [100.74, 102.07, "bà Sáu gọi run run.", "N"], [102.72, 106.13, "“Vía thứ chín con Thư ơi… về với má…”", "MA"], [107.35, 109.18, "Thư dạ. Nhưng cùng lúc đó,", "N"], [109.18, 110.3, "dưới chân cầu,", "N"], [110.3, 111.84, "cũng có một tiếng dạ.", "N"], [111.84, 113.64, "Giọng y hệt giọng của Thư.", "N"], [114.31, 118.3, "“Dạ… con về đây má…”", "GT"], [121.01, 122.57, "Bà Sáu nhớ lời ông Tư,", "N"], [122.57, 124.7, "kéo tay con gái chạy một mạch về", "N"], [124.7, 126.42, "nhà, không dám ngoái lại.", "N"], [126.42, 128.9, "Sau lưng, tiếng bước chân ướt nhẹp lẽo", "N"], [128.9, 130.37, "đẽo theo tới tận cửa.", "N"], [130.96, 132.45, "Ông Tư đóng sầm cửa,", "N"], [132.45, 134.0, "dán bùa lên then cửa.", "N"], [134.0, 136.21, "Cả đêm, bên ngoài có tiếng ai gõ", "N"], [136.21, 137.73, "cửa, giọng y hệt Thư.", "N"], [138.4, 146.33, "“Má ơi… mở cửa cho con vô… con lạnh quá…”", "GT"], [149.16, 151.07, "Gà gáy, tiếng gõ cửa im bặt.", "N"], [151.07, 153.5, "Sáng ra, trước thềm có một vũng nước,", "N"], [153.5, 156.19, "và dấu chân ướt dẫn ngược về phía cây cầu.", "N"], [157.13, 158.19, "Thư khỏe lại,", "N"], [158.19, 159.55, "ăn được, ngủ được.", "N"], [159.55, 160.92, "Ông Tư dặn cả nhà:", "N"], [160.92, 162.04, "từ nay về sau,", "N"], [162.04, 164.18, "nửa đêm có ai gọi tên Thư ngoài", "N"], [164.18, 166.34, "cửa, tuyệt đối không ai được dạ.", "N"], [167.28, 169.47, "Gia đình bà Sáu dọn đi nơi khác.", "N"], [169.47, 171.19, "Còn cây cầu ván đầu xóm,", "N"], [171.19, 173.33, "người ta cắm nhang đầy hai bên.", "N"], [173.33, 174.51, "Vậy mà tới giờ,", "N"], [174.51, 175.81, "nửa đêm đi ngang,", "N"], [175.81, 178.18, "vẫn nghe dưới chân cầu có tiếng con", "N"], [178.18, 179.34, "gái khe khẽ dạ.", "N"], [181.43, 183.51, "Nếu nửa đêm có người gọi đúng tên", "N"], [183.51, 185.13, "bạn… bạn có dám dạ không?", "N"], [186.07, 187.19, "Để lại bình luận,", "N"], [187.19, 189.39, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 9.228208333333335, 15.719708333333335, 19.509708333333336, 28.399770833333335, 37.9519375, 47.151624999999996, 54.44602083333333, 64.69608333333333, 72.76185416666667, 82.1714375, 87.17952083333333, 92.78014583333332, 99.46337499999998, 102.62502083333332, 107.32318749999999, 114.19754166666665, 120.98099999999998, 130.92910416666666, 138.29264583333332, 149.1265, 157.09506249999998, 167.25020833333332, 181.39997916666664, 186.03616666666665], "durs": [8.428208333333334, 5.6415, 2.94, 8.3900625, 8.552