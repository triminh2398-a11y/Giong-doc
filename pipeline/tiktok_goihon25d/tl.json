{"dur": 34.56, "scenes": [["ext", 0, 7.244, [0.6]], ["field", 7.244, 12.158, [0.15]], ["roof", 12.158, 15.113, [0.2]], ["call", 15.113, 18.844, [0.25]], ["listen", 18.844, 25.585, [1.0, 5.28]], ["turn", 25.585, 28.598, []], ["room", 28.598, 34.559, [0.2]]], "subs": [[0.6, 7.29, "Ở quê tui, người vừa tắt thở, con cháu phải leo lên mái nhà, cầm cái áo của người mất mà gọi hồn.", "N"], [7.39, 11.91, "Gọi ba tiếng. Có tiếng dạ… thì phải coi nó dạ từ đâu.", "N"], [12.36, 15.21, "Đêm bà nội mất, thằng Út leo lên mái.", "N"], [15.42, 18.67, "“Bà nội ơi… về đi bà ơi!”", "U"], [19.86, 22.29, "“Ơi…”", "G"], [24.12, 28.55, "Tiếng dạ không vọng ra từ buồng có xác bà… mà từ ngoài ruộng tối.", "N"], [28.8, 31.61, "Còn trong buồng… cái xác đã mở mắt.", "N"]], "vox": [[15.42, 16.24, "U"], [17.52, 18.42, "U"], [19.86, 22.04, "G"]], "starts": [0.6, 7.394291666666666, 12.357937499999998, 15.363458333333332, 19.844354166666665, 24.124187499999998, 28.797624999999996], "durs": [6.4442916666666665, 4.263645833333333, 2.6055208333333333, 3.1808958333333335, 3.3798333333333335, 4.1734375, 2.5613125], "lines": ["n1", "n2", "n3", "u", "g", "n4", "n5"], "jumpF": 0.395, "openF": 0.3}