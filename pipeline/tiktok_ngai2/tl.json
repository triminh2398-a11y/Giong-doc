{"dur": 292.26, "scenes": [["hook", 0, 7.999, [0.3]], ["hook2", 7.999, 15.414, [0.2]], ["title", 15.414, 18.006, [0.2]], ["tham", 18.006, 25.536, [0.2]], ["rumor", 25.536, 34.34, [0.2]], ["mount", 34.34, 39.11, [0.2]], ["thay", 39.11, 44.705, [0.2]], ["thay2", 44.705, 55.983, [0.2]], ["thay3", 55.983, 63.049, [0.2]], ["thay4", 63.049, 72.459, [0.2]], ["feed", 72.459, 81.9, [0.2]], ["back", 81.9, 89.617, [0.2]], ["loi1", 89.617, 93.42, [0.2]], ["thamhug", 93.42, 99.717, [0.2]], ["rule2", 99.717, 105.846, [0.2]], ["odd1", 105.846, 113.959, [0.2]], ["odd2", 113.959, 119.985, [0.2]], ["odd3", 119.985, 127.343, [0.2]], ["thamask", 127.343, 130.646, [0.2]], ["loi2", 130.646, 134.193, [0.2]], ["shadow", 134.193, 141.359, [0.2]], ["call", 141.359, 147.854, [0.2]], ["tu", 147.854, 157.873, [0.2]], ["realize", 157.873, 163.774, [0.2]], ["realize2", 163.774, 169.591, [0.2]], ["loi3", 169.591, 177.027, [0.2]], ["callbay", 177.027, 182.18, [0.2]], ["tb5", 182.18, 191.77, [0.2]], ["tb6", 191.77, 198.514, [0.2]], ["run", 198.514, 205.499, [0.2]], ["follow", 205.499, 212.022, [0.2]], ["gl1", 212.022, 219.861, [0.2]], ["nturn", 219.861, 227.593, [0.2]], ["root", 227.593, 236.598, [0.2]], ["cut", 236.598, 243.716, [0.2]], ["fall", 243.716, 247.89, [0.2]], ["corpse", 247.89, 254.576, [0.2]], ["end", 254.576, 261.502, [0.2]], ["end2", 261.502, 266.846, [0.2]], ["final", 266.846, 273.449, [0.2]], ["gfinal", 273.449, 280.989, [0.2]], ["cta", 280.989, 292.262, [0.2, 6.26]]], "subs": [[0.33, 2.11, "Ở Thất Sơn có một loại ngải,", "N"], [2.11, 4.05, "người ta gọi là ngải kêu người.", "N"], [4.05, 6.27, "Trồng nó, thì người mình thương dù ở", "N"], [6.27, 7.64, "đâu cũng phải tìm về.", "N"], [8.23, 10.54, "Nhưng thầy ngải nào cũng dặn một câu:", "N"], [10.54, 11.76, "ngải kêu người...", "N"], [11.76, 13.8, "chứ không hỏi người đó còn sống,", "N"], [13.8, 14.7, "hay đã chết.", "N"], [15.64, 16.63, "Ngải Thất Sơn.", "N"], [16.63, 17.65, "Ngải kêu người.", "N"], [18.24, 20.07, "Thắm bán cơm ở chợ Tịnh Biên.", "N"], [20.07, 21.21, "Chồng cô là Lợi,", "N"], [21.21, 23.26, "qua bên kia biên giới làm phụ hồ,", "N"], [23.26, 25.18, "đã ba tháng không một cuộc gọi.", "N"], [25.77, 27.41, "Người trong xóm xì xầm,", "N"], [27.41, 29.12, "Lợi có vợ bé bên đó rồi.", "N"], [29.12, 30.3, "Thắm không tin.", "N"], [30.3, 32.54, "Nhưng đêm nào cô cũng ngồi ôm cái", "N"], [32.54, 33.98, "điện thoại tới sáng.", "N"], [34.57, 35.81, "Đêm rằm tháng bảy,", "N"], [35.81, 37.21, "Thắm lén leo núi Cấm,", "N"], [37.21, 38.75, "tìm tới am của thầy Bảy.", "N"], [39.34, 40.73, "Thầy nhìn cô rất lâu,", "N"], [40.73, 42.61, "rồi bưng ra một chậu ngải nhỏ.", "N"], [42.61, 44.35, "Lá dài, gân đỏ như mạch máu.", "N"], [44.96, 47.2, "“Ngải này kêu chồng mầy về.”", "TB"], [47.2, 48.86, "“Nhưng nhớ ba điều.”", "TB"], [48.86, 51.61, "“Một, đêm nào cũng nhỏ ba giọt máu”", "TB"], [51.61, 52.76, "“ngón áp út,”", "TB"], [52.76, 54.5, "“ngón đeo nhẫn cưới,”", "TB"], [54.5, 55.55, "“cho nó ăn.”", "TB"], [56.23, 58.7, "“Hai, nó về rồi thì hổng được hỏi”", "TB"], [58.7, 59.71, "“nó đi đâu,”", "TB"], [59.71, 60.98, "“gặp chuyện gì.”", "TB"], [60.98, 62.62, "“Hỏi... là nó nhớ ra.”", "TB"], [63.3, 65.36, "“Ba. Ngải kêu người,”", "TB"], [65.36, 68.71, "“chứ hổng hỏi người đó còn sống hay”", "TB"], [68.71, 70.69, "“đã chết. Mầy chịu,”", "TB"], [70.69, 72.03, "“thì đem về.”", "TB"], [72.69, 74.16, "Thắm đem chậu ngải về,", "N"], [74.16, 75.35, "đặt ở đầu giường.", "N"], [75.35, 77.42, "Đêm nào cô cũng chích ngón áp út,", "N"], [77.42, 78.56, "nhỏ ba giọt máu.", "N"], [78.56, 80.19, "Lá ngải rung lên khe khẽ,", "N"], [80.19, 81.19, "như đang nuốt.", "N"], [82.13, 83.09, "Đêm thứ bảy,", "N"], [83.09, 84.27, "trời mưa tầm tã,", "N"], [84.27, 85.45, "có tiếng gõ cửa.", "N"], [85.45, 86.36, "Thắm mở ra.", "N"], [86.36, 87.93, "Là Lợi. Người ướt sũng,", "N"], [87.93, 89.26, "đứng im ngoài hiên.", "N"], [89.89, 92.92, "“Thắm... anh về rồi nè.”", "L"], [93.71, 96.83, "“Anh Lợi! Anh đi đâu mà mất biệt”", "TM"], [96.83, 99.22, "“vậy? Em lo muốn chết...”", "TM"], [99.95, 101.19, "Lợi không trả lời.", "N"], [101.19, 103.08, "Thắm sực nhớ lời thầy Bảy dặn,", "N"], [103.08, 104.33, "vội nuốt nước mắt,", "N"], [104.33, 105.49, "kéo chồng vô nhà.", "N"], [106.08, 107.5, "Lợi về, nhưng khác lắm.", "N"], [107.5, 109.32, "Anh không đụng tới một hột cơm,", "N"], [109.32, 110.54, "chỉ uống nước lạnh.", "N"], [110.54, 112.26, "Người lúc nào cũng lạnh ngắt,", "N"], [112.26, 113.6, "phảng phất mùi đất ẩm.", "N"], [114.19, 116.06, "Ban ngày anh nằm im như khúc gỗ.", "N"], [116.06, 117.88, "Đêm xuống, anh ngồi đầu giường,", "N"], [117.88, 119.63, "nhìn chậu ngải không chớp mắt.", "N"], [120.22, 122.24, "Có đêm Thắm giật mình thức giấc,", "N"], [122.24, 124.11, "thấy chồng cúi sát chậu ngải,", "N"], [124.11, 125.2, "thì thầm gì đó.", "N"], [125.2, 126.98, "Lá ngải ngả hết về phía anh.", "N"], [127.61, 130.18, "“Anh... anh nói chuyện với ai vậy?”", "TM"], [131.32, 132.52, "“Không có ai hết.”", "L"], [132.52, 133.35, "“Em ngủ đi.”", "L"], [134.42, 136.0, "Rồi Thắm để ý một chuyện.", "N"], [136.0, 137.16, "Dưới ánh đèn dầu,", "N"], [137.16, 138.47, "bóng cô in lên vách.", "N"], [138.47, 139.73, "Còn bóng của Lợi...", "N"], [139.73, 140.65, "thì không có.", "N"], [141.59, 142.59, "Sáng hôm sau,", "N"], [142.59, 144.69, "có người gọi điện từ bên kia biên", "N"], [144.69, 145.86, "giới. Là anh Tư,", "N"], [145.86, 147.49, "người dẫn Lợi qua đó làm.", "N"], [148.16, 150.58, "“Thắm hả... anh xin lỗi giờ mới dám”", "TU"], [150.58, 152.88, "“báo. Thằng Lợi bị sập giàn giáo,”", "TU"], [152.88, 154.49, "“mất hơn ba tháng rồi.”", "TU"], [154.49, 157.07, "“Tụi anh đào hoài mà không thấy xác...”", "TU"], [158.1, 159.98, "Cái điện thoại rơi khỏi tay Thắm.", "N"], [159.98, 161.81, "Ba tháng. Đúng từ cái đêm cô bắt", "N"], [161.81, 162.81, "đầu gặp ác mộng.", "N"], [164.0, 165.24, "Cô từ từ quay lại.", "N"], [165.24, 166.95, "Lợi đứng sau tấm màn buồng,", "N"], [166.95, 168.03, "mặt trắng bệch,", "N"], [168.03, 169.23, "nhìn cô trân trân.", "N"], [169.84, 171.98, "“Em hỏi anh đi đâu...”", "L"], [171.98, 174.02, "“Giờ anh nhớ ra rồi.”", "L"], [174.02, 176.13, "“Dưới đó lạnh lắm em.”", "L"], [177.26, 178.71, "Thắm chạy ra đầu ngõ,", "N"], [178.71, 180.39, "run rẩy gọi cho thầy Bảy.", "N"], [180.39, 181.82, "Giọng thầy lạnh băng.", "N"], [182.77, 184.11, "“Đó là xác thằng Lợi,”", "TB"], [184.11, 185.03, "“ngải kêu về,”", "TB"], [185.03, 186.53, "“ngải nuôi bằng máu mầy.”", "TB"], [186.53, 188.57, "“Muốn cắt, trước giờ Tý đêm nay ôm”", "TB"], [188.57, 189.65, "“chậu ra ngã ba,”", "TB"], [189.65, 191.34, "“đập bể, nhổ cái rễ cái lên.”", "TB"], [192.02, 193.54, "“Nó sẽ đi theo kêu mầy.”", "TB"], [193.54, 194.61, "“Đừng quay lại.”", "TB"], [194.61, 196.41, "“Ngải ăn máu ngón tay nào...”", "TB"], [196.41, 197.73, "“thì nó giữ ngón đó.”", "TB"], [198.74, 199.69, "Gần nửa đêm,", "N"], [199.69, 201.82, "Thắm ôm chậu ngải chạy ra ngã ba.", "N"], [201.82, 202.88, "Chậu nặng dần,", "N"], [202.88, 205.14, "ấm dần, như đang ôm một đứa con nít.", "N"], [205.73, 206.67, "Sau lưng cô,", "N"], [206.67, 208.49, "có tiếng bước chân lép nhép,", "N"], [208.49, 209.98, "kéo lê. Rồi giọng Lợi,", "N"], [209.98, 211.66, "dịu dàng như hồi mới cưới.", "N"], [212.27, 215.02, "“Thắm ơi... anh lạnh quá...”", "GL"], [215.02, 218.0, "“cho anh ôm em một cái thôi...”", "GL"], [220.09, 221.87, "Thắm cắn môi tới bật máu.", "N"], [221.87, 223.06, "Không quay đầu.", "N"], [223.06, 224.01, "Tới ngã ba,", "N"], [224.01, 226.83, "cô dồn hết sức đập mạnh cái chậu xuống đất.", "N"], [227.82, 229.14, "Đất văng tung tóe.", "N"], [229.14, 231.3, "Cái rễ cái của ngải quấn chặt một", "N"], [231.3, 232.5, "chiếc nhẫn cưới,", "N"], [232.5, 233.36, "đã đen sì.", "N"], [233.36, 234.44, "Rễ con bò lên,", "N"], [234.44, 236.24, "siết lấy ngón áp út của cô.", "N"], [236.83, 238.06, "Thắm nghiến răng,", "N"], [238.06, 239.29, "giật mạnh tay ra.", "N"], [239.29, 240.18, "Rễ đứt lìa.", "N"], [240.18, 241.69, "Ngón tay cô rách toạc,", "N"], [241.69, 243.01, "máu chảy ròng ròng.", "N"], [243.95, 246.13, "Sau lưng cô vang lên một tiếng huỵch.", "N"], [246.13, 246.93, "Rồi im bặt.", "N"], [248.12, 249.16, "Thắm quay lại.", "N"], [249.16, 250.71, "Giữa ngã ba là xác Lợi,", "N"], [250.71, 252.47, "nằm sấp, người đầy bùn đất,", "N"], [252.47, 253.87, "như vừa được đào lên.", "N"], [254.81, 256.85, "Người ta đưa Lợi đi chôn cất đàng", "N"], [256.85, 258.14, "hoàng. Ai cũng nói,", "N"], [258.14, 260.79, "Thắm thương chồng tới mức kêu được cả xác về.", "N"], [261.73, 263.28, "Nhưng đêm rằm tháng sau,", "N"], [263.28, 264.56, "Thắm ngồi một mình,", "N"], [264.56, 266.14, "gỡ lớp băng ở ngón áp út.", "N"], [267.08, 268.45, "Ngay chỗ vết thương,", "N"], [268.45, 269.89, "có cái gì đó nhú lên.", "N"], [269.89, 271.04, "Một chồi lá nhỏ,", "N"], [271.04, 272.39, "gân đỏ như mạch máu.", "N"], [273.7, 277.01, "“Thắm ơi... anh về nè...”", "GL"], [281.22, 283.38, "Nếu được kêu người thương quay về,", "N"], [283.38, 284.54, "dù họ đã chết...", "N"], [284.54, 286.34, "bạn có dám trồng ngải không?", "N"], [287.28, 288.33, "Để lại bình luận,", "N"], [288.33, 290.4, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 8.198625, 15.614166666666666, 18.205895833333333, 25.7355625, 34.539500000000004, 39.309875000000005, 44.90522916666667, 56.18331250000001, 63.24858333333334, 72.65877083333334, 82.09995833333333, 89.81704166666667, 93.6199375, 99.91725000000001, 106.04579166666667, 114.15920833333334, 120.18520833333334, 127.54264583333334, 130.84577083333335, 134.3926875, 141.55854166666666, 148.05352083333332, 158.07310416666664, 163.9735833333333, 169.79072916666664, 177.2268958333333, 182.38006249999995, 191.97018749999995, 198.71406249999995, 205.6993333333333, 212.2217083333333, 220.06060416666665, 227.7928125, 236.79758333333334, 243.915875, 248.08952083333332, 254.77612499999998, 261.702, 267.0455416666667, 273.64925, 281.1889583333333, 287.248], "durs": [7.398625, 6.565541666666666, 2.09172916666