{"dur": 292.08, "scenes": [["hook", 0, 7.999, [0.3]], ["hook2", 7.999, 15.414, [0.2]], ["title", 15.414, 18.065, [0.2]], ["tham", 18.065, 25.595, [0.2]], ["rumor", 25.595, 34.398, [0.2]], ["mount", 34.398, 39.169, [0.2]], ["thay", 39.169, 44.764, [0.2]], ["thay2", 44.764, 56.042, [0.2]], ["thay3", 56.042, 63.108, [0.2]], ["thay4", 63.108, 72.518, [0.2]], ["feed", 72.518, 81.959, [0.2]], ["back", 81.959, 89.676, [0.2]], ["loi1", 89.676, 93.479, [0.2]], ["thamhug", 93.479, 99.776, [0.2]], ["rule2", 99.776, 105.905, [0.2]], ["odd1", 105.905, 114.018, [0.2]], ["odd2", 114.018, 120.044, [0.2]], ["odd3", 120.044, 127.402, [0.2]], ["thamask", 127.402, 130.705, [0.2]], ["loi2", 130.705, 134.252, [0.2]], ["shadow", 134.252, 141.417, [0.2]], ["call", 141.417, 147.912, [0.2]], ["tu", 147.912, 157.932, [0.2]], ["realize", 157.932, 163.833, [0.2]], ["realize2", 163.833, 169.65, [0.2]], ["loi3", 169.65, 177.086, [0.2]], ["callbay", 177.086, 182.239, [0.2]], ["tb5", 182.239, 191.829, [0.2]], ["tb6", 191.829, 198.573, [0.2]], ["run", 198.573, 205.558, [0.2]], ["follow", 205.558, 212.081, [0.2]], ["gl1", 212.081, 219.92, [0.2]], ["nturn", 219.92, 227.652, [0.2]], ["root", 227.652, 236.657, [0.2]], ["cut", 236.657, 243.534, [0.2]], ["fall", 243.534, 247.707, [0.2]], ["corpse", 247.707, 254.394, [0.2]], ["end", 254.394, 261.32, [0.2]], ["end2", 261.32, 266.663, [0.2]], ["final", 266.663, 273.267, [0.2]], ["gfinal", 273.267, 280.807, [0.2]], ["cta", 280.807, 292.08, [0.2, 6.26]]], "subs": [[0.33, 2.11, "Ở Thất Sơn có một loại ngải,", "N"], [2.11, 4.05, "người ta gọi là ngải kêu người.", "N"], [4.05, 6.27, "Trồng nó, thì người mình thương dù ở", "N"], [6.27, 7.64, "đâu cũng phải tìm về.", "N"], [8.23, 10.54, "Nhưng thầy ngải nào cũng dặn một câu:", "N"], [10.54, 11.76, "ngải kêu người...", "N"], [11.76, 13.8, "chứ không hỏi người đó còn sống,", "N"], [13.8, 14.7, "hay đã chết.", "N"], [15.64, 16.66, "Ngải Thất Sơn.", "N"], [16.66, 17.7, "Ngải kêu người.", "N"], [18.29, 20.13, "Thắm bán cơm ở chợ Tịnh Biên.", "N"], [20.13, 21.27, "Chồng cô là Lợi,", "N"], [21.27, 23.32, "qua bên kia biên giới làm phụ hồ,", "N"], [23.32, 25.23, "đã ba tháng không một cuộc gọi.", "N"], [25.82, 27.47, "Người trong xóm xì xầm,", "N"], [27.47, 29.18, "Lợi có vợ bé bên đó rồi.", "N"], [29.18, 30.36, "Thắm không tin.", "N"], [30.36, 32.6, "Nhưng đêm nào cô cũng ngồi ôm cái", "N"], [32.6, 34.04, "điện thoại tới sáng.", "N"], [34.63, 35.87, "Đêm rằm tháng bảy,", "N"], [35.87, 37.27, "Thắm lén leo núi Cấm,", "N"], [37.27, 38.81, "tìm tới am của thầy Bảy.", "N"], [39.4, 40.79, "Thầy nhìn cô rất lâu,", "N"], [40.79, 42.67, "rồi bưng ra một chậu ngải nhỏ.", "N"], [42.67, 44.4, "Lá dài, gân đỏ như mạch máu.", "N"], [45.01, 47.25, "“Ngải này kêu chồng mầy về.”", "TB"], [47.25, 48.91, "“Nhưng nhớ ba điều.”", "TB"], [48.91, 51.66, "“Một, đêm nào cũng nhỏ ba giọt máu”", "TB"], [51.66, 52.81, "“ngón áp út,”", "TB"], [52.81, 54.55, "“ngón đeo nhẫn cưới,”", "TB"], [54.55, 55.6, "“cho nó ăn.”", "TB"], [56.29, 58.76, "“Hai, nó về rồi thì hổng được hỏi”", "TB"], [58.76, 59.77, "“nó đi đâu,”", "TB"], [59.77, 61.04, "“gặp chuyện gì.”", "TB"], [61.04, 62.68, "“Hỏi... là nó nhớ ra.”", "TB"], [63.36, 65.42, "“Ba. Ngải kêu người,”", "TB"], [65.42, 68.77, "“chứ hổng hỏi người đó còn sống hay”", "TB"], [68.77, 70.75, "“đã chết. Mầy chịu,”", "TB"], [70.75, 72.09, "“thì đem về.”", "TB"], [72.75, 74.21, "Thắm đem chậu ngải về,", "N"], [74.21, 75.41, "đặt ở đầu giường.", "N"], [75.41, 77.48, "Đêm nào cô cũng chích ngón áp út,", "N"], [77.48, 78.62, "nhỏ ba giọt máu.", "N"], [78.62, 80.25, "Lá ngải rung lên khe khẽ,", "N"], [80.25, 81.25, "như đang nuốt.", "N"], [82.19, 83.15, "Đêm thứ bảy,", "N"], [83.15, 84.33, "trời mưa tầm tã,", "N"], [84.33, 85.51, "có tiếng gõ cửa.", "N"], [85.51, 86.42, "Thắm mở ra.", "N"], [86.42, 87.99, "Là Lợi. Người ướt sũng,", "N"], [87.99, 89.32, "đứng im ngoài hiên.", "N"], [89.95, 92.98, "“Thắm... anh về rồi nè.”", "L"], [93.77, 96.89, "“Anh Lợi! Anh đi đâu mà mất biệt”", "TM"], [96.89, 99.28, "“vậy? Em lo muốn chết...”", "TM"], [100.01, 101.25, "Lợi không trả lời.", "N"], [101.25, 103.14, "Thắm sực nhớ lời thầy Bảy dặn,", "N"], [103.14, 104.39, "vội nuốt nước mắt,", "N"], [104.39, 105.54, "kéo chồng vô nhà.", "N"], [106.13, 107.55, "Lợi về, nhưng khác lắm.", "N"], [107.55, 109.38, "Anh không đụng tới một hột cơm,", "N"], [109.38, 110.6, "chỉ uống nước lạnh.", "N"], [110.6, 112.32, "Người lúc nào cũng lạnh ngắt,", "N"], [112.32, 113.66, "phảng phất mùi đất ẩm.", "N"], [114.25, 116.12, "Ban ngày anh nằm im như khúc gỗ.", "N"], [116.12, 117.94, "Đêm xuống, anh ngồi đầu giường,", "N"], [117.94, 119.68, "nhìn chậu ngải không chớp mắt.", "N"], [120.27, 122.3, "Có đêm Thắm giật mình thức giấc,", "N"], [122.3, 124.17, "thấy chồng cúi sát chậu ngải,", "N"], [124.17, 125.26, "thì thầm gì đó.", "N"], [125.26, 127.04, "Lá ngải ngả hết về phía anh.", "N"], [127.67, 130.24, "“Anh... anh nói chuyện với ai vậy?”", "TM"], [131.37, 132.57, "“Không có ai hết.”", "L"], [132.57, 133.4, "“Em ngủ đi.”", "L"], [134.48, 136.06, "Rồi Thắm để ý một chuyện.", "N"], [136.06, 137.22, "Dưới ánh đèn dầu,", "N"], [137.22, 138.53, "bóng cô in lên vách.", "N"], [138.53, 139.79, "Còn bóng của Lợi...", "N"], [139.79, 140.71, "thì không có.", "N"], [141.65, 142.65, "Sáng hôm sau,", "N"], [142.65, 144.75, "có người gọi điện từ bên kia biên", "N"], [144.75, 145.92, "giới. Là anh Tư,", "N"], [145.92, 147.55, "người dẫn Lợi qua đó làm.", "N"], [148.22, 150.64, "“Thắm hả... anh xin lỗi giờ mới dám”", "TU"], [150.64, 152.94, "“báo. Thằng Lợi bị sập giàn giáo,”", "TU"], [152.94, 154.55, "“mất hơn ba tháng rồi.”", "TU"], [154.55, 157.13, "“Tụi anh đào hoài mà không thấy xác...”", "TU"], [158.16, 160.04, "Cái điện thoại rơi khỏi tay Thắm.", "N"], [160.04, 161.87, "Ba tháng. Đúng từ cái đêm cô bắt", "N"], [161.87, 162.87, "đầu gặp ác mộng.", "N"], [164.06, 165.3, "Cô từ từ quay lại.", "N"], [165.3, 167.01, "Lợi đứng sau tấm màn buồng,", "N"], [167.01, 168.09, "mặt trắng bệch,", "N"], [168.09, 169.29, "nhìn cô trân trân.", "N"], [169.9, 172.04, "“Em hỏi anh đi đâu...”", "L"], [172.04, 174.08, "“Giờ anh nhớ ra rồi.”", "L"], [174.08, 176.19, "“Dưới đó lạnh lắm em.”", "L"], [177.32, 178.77, "Thắm chạy ra đầu ngõ,", "N"], [178.77, 180.45, "run rẩy gọi cho thầy Bảy.", "N"], [180.45, 181.88, "Giọng thầy lạnh băng.", "N"], [182.83, 184.17, "“Đó là xác thằng Lợi,”", "TB"], [184.17, 185.09, "“ngải kêu về,”", "TB"], [185.09, 186.59, "“ngải nuôi bằng máu mầy.”", "TB"], [186.59, 188.63, "“Muốn cắt, trước giờ Tý đêm nay ôm”", "TB"], [188.63, 189.71, "“chậu ra ngã ba,”", "TB"], [189.71, 191.4, "“đập bể, nhổ cái rễ cái lên.”", "TB"], [192.08, 193.6, "“Nó sẽ đi theo kêu mầy.”", "TB"], [193.6, 194.67, "“Đừng quay lại.”", "TB"], [194.67, 196.47, "“Ngải ăn máu ngón tay nào...”", "TB"], [196.47, 197.79, "“thì nó giữ ngón đó.”", "TB"], [198.8, 199.75, "Gần nửa đêm,", "N"], [199.75, 201.88, "Thắm ôm chậu ngải chạy ra ngã ba.", "N"], [201.88, 202.94, "Chậu nặng dần,", "N"], [202.94, 205.2, "ấm dần, như đang ôm một đứa con nít.", "N"], [205.79, 206.73, "Sau lưng cô,", "N"], [206.73, 208.55, "có tiếng bước chân lép nhép,", "N"], [208.55, 210.04, "kéo lê. Rồi giọng Lợi,", "N"], [210.04, 211.72, "dịu dàng như hồi mới cưới.", "N"], [212.33, 215.08, "“Thắm ơi... anh lạnh quá...”", "GL"], [215.08, 218.06, "“cho anh ôm em một cái thôi...”", "GL"], [220.15, 221.93, "Thắm cắn môi tới bật máu.", "N"], [221.93, 223.12, "Không quay đầu.", "N"], [223.12, 224.07, "Tới ngã ba,", "N"], [224.07, 226.89, "cô dồn hết sức đập mạnh cái chậu xuống đất.", "N"], [227.88, 229.19, "Đất văng tung tóe.", "N"], [229.19, 231.36, "Cái rễ cái của ngải quấn chặt một", "N"], [231.36, 232.56, "chiếc nhẫn cưới,", "N"], [232.56, 233.42, "đã đen sì.", "N"], [233.42, 234.5, "Rễ con bò lên,", "N"], [234.5, 236.3, "siết lấy ngón áp út của cô.", "N"], [236.89, 238.06, "Thắm nghiến răng,", "N"], [238.06, 239.23, "giật mạnh tay ra.", "N"], [239.23, 240.14, "Rễ đứt phựt.", "N"], [240.14, 241.57, "Ngón tay cô rách toạc,", "N"], [241.57, 242.82, "máu chảy ròng ròng.", "N"], [243.76, 245.95, "Sau lưng cô vang lên một tiếng huỵch.", "N"], [245.95, 246.75, "Rồi im bặt.", "N"], [247.94, 248.98, "Thắm quay lại.", "N"], [248.98, 250.52, "Giữa ngã ba là xác Lợi,", "N"], [250.52, 252.28, "nằm sấp, người đầy bùn đất,", "N"], [252.28, 253.68, "như vừa được đào lên.", "N"], [254.62, 256.66, "Người ta đưa Lợi đi chôn cất đàng", "N"], [256.66, 257.95, "hoàng. Ai cũng nói,", "N"], [257.95, 260.61, "Thắm thương chồng tới mức kêu được cả xác về.", "N"], [261.55, 263.1, "Nhưng đêm rằm tháng sau,", "N"], [263.1, 264.38, "Thắm ngồi một mình,", "N"], [264.38, 265.95, "gỡ lớp băng ở ngón áp út.", "N"], [266.89, 268.27, "Ngay chỗ vết thương,", "N"], [268.27, 269.7, "có cái gì đó nhú lên.", "N"], [269.7, 270.86, "Một chồi lá nhỏ,", "N"], [270.86, 272.21, "gân đỏ như mạch máu.", "N"], [273.52, 276.83, "“Thắm ơi... anh về nè...”", "GL"], [281.04, 283.2, "Nếu được kêu người thương quay về,", "N"], [283.2, 284.36, "dù họ đã chết...", "N"], [284.36, 286.16, "bạn có dám trồng ngải không?", "N"], [287.1, 288.15, "Để lại bình luận,", "N"], [288.15, 290.22, "và theo dõi Chuyện Đông Tây Kim Cổ nhé.", "N"]], "starts": [0.3, 8.198625, 15.614166666666666, 18.264833333333332, 25.7945, 34.5984375, 39.368812500000004, 44.96416666666667, 56.242250000000006, 63.30752083333334, 72.71770833333335, 82.15889583333335, 89.87597916666668, 93.67887500000002, 99.97618750000002, 106.10472916666669, 114.21814583333335, 120.24414583333335, 127.60158333333335, 130.90470833333336, 134.451625, 141.61747916666667, 148.11245833333334, 158.13204166666665, 164.0325208333333, 169.84966666666665, 177.2858333333333, 182.43899999999996, 192.02912499999996, 198.77299999999997, 205.7582708333333, 212.28064583333332, 220.11954166666666, 227.85175, 236.85652083333335, 243.73360416666668, 247.90725, 254.59385416666666, 261.5197291666667, 266.8632708333334, 273.4669791666667, 281.0066875, 287.0657291666667], "durs": [7.398625, 6.5655416