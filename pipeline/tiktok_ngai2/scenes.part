// ================= cảnh: NGẢI KÊU NGƯỜI =================
const S={};let ctaFlag=false,BLACK=0,TITLE=false,RED=0,RAIN=0,FLASH=0,NOW=0;
// chỉ 1 jumpscare mạnh ở mở đầu (câu 2); giữa phim chỉ "nhào" nhẹ trong cảnh, không chớp trắng
const JUMPS=[['hook2',0.02,0.5,1]];
const SOFT=[['odd3',0.72,0.18],['realize2',0.55,0.22],['loi3',0.72,0.2],['nturn',0.8,0.16]];
// khẩu hình: chỉ mở khi chính câu thoại của nhân vật đó đang phát (TLD.vox) -> hết câu là ngậm miệng
const TK=sp=>{for(const [a,b,s] of TLD.vox){if(s===sp&&NOW>=a&&NOW<b)return Math.sin(NOW*14)>-0.2?'o':undefined}return undefined};
const flick=T=>0.85+0.15*Math.sin(T*11)*Math.sin(T*3.7);
const BX=-0.85,BZ=-2.25,BY=0.45;// chậu ngải đầu giường (trên ghế đẩu)
const bedPot=(T,o)=>{POT2.visible=true;POT2.position.set(BX,BY,BZ);potAnim(POT2,T,o)};
const potClose=(p,d0=0.9,d1=0.6,fov=40)=>cm([BX+0.12,0.95,BZ+lerp(d0,d1,p)],[BX,0.72,BZ],fov);
const leanPot=(q)=>{POT2.userData.L.forEach((l,k)=>{const ry=k*2.39;l.rotation.x=l.userData.b+q*0.5*Math.cos(ry-Math.PI*0.25)})};
const nightIn=(lamp=0.5)=>{night();lampL.intensity=lamp;moonSpot.intensity=4};
// ---- mở đầu ----
S.hook=(lt,D,T)=>{CUR='inn';nightIn(0.0);LAMP1.visible=false;moonSpot.intensity=2;const p=sm(lt/D);bedPot(T,{glow:1.8*flick(T),pulse:1,amp:1.3});altarL.intensity=0;
 put(C.loi,-0.35,-2.42,{wet:true,pale:true,eyes:1.15,pupil:2.2,look:-1,T});CC.inn.loi.material.emissiveIntensity=0.03;KG[4].visible=false;fillL.color.set(0xff3a2a);fillL.intensity=1.0*flick(T);fillL.position.set(-0.7,0.62,-1.95);moonSpot.intensity=4;
 cm([lerp(0.7,0.05,p),lerp(1.05,1.15,p),lerp(0.6,-0.85,p)],[-0.55,lerp(0.85,1.15,p),-2.35],lerp(46,40,p));return 'inn'};
S.hook2=(lt,D,T)=>{CUR='inn';nightIn(0.1);KG[4].visible=false;LAMP1.visible=false;bedPot(T,{glow:1.2,pulse:1,shake:lt<1.2,amp:1.5});fillL.color.set(0xff4a3a);fillL.intensity=1.3*flick(T);fillL.position.set(-0.6,0.8,-1.5);
 if(lt<D*0.55){put(C.ml,-0.35,-2.42,{a:0.97,mouth:'o'});const sh=lt<0.4?Math.sin(lt*80)*0.03*(1-lt/0.4):0;close(C.ml,lerp(0.55,0.75,sm(lt/(D*0.55))),36,0.05+sh);RED=0.12*(1-sm(lt/(D*0.55)));return 'inn'}
 potClose(sm(seg(lt,D*0.55,D)),1.0,0.65,40);return 'inn'};
S.title=(lt,D,T)=>{CUR='mtn';const p=sm(lt/D);TITLE=true;POT_TOP.visible=true;potAnim(POT_TOP,T,{glow:1.0,pulse:1});cm([0.6,H(0,3)+lerp(1.4,1.8,p),lerp(3.5,3.0,p)],[0.2,H(0,-6)+1.6,-6],50);return 'mtn'};
// ---- chợ Tịnh Biên ----
S.tham=(lt,D,T)=>{CUR='mkt';const p=sm(lt/D);put(C.tham,0,-0.8,{eyes:0.8,look:0,T});put(C.k1,-1.5,1.0,{look:1});put(C.k2,1.4,1.2,{look:-1,phase:T*2});cm([lerp(1.4,0.5,p),1.7,4.4],[0,1.25,-0.3],42);return 'mkt'};
S.rumor=(lt,D,T,ls)=>{if(lt<(ls[0]+D*0.5)){CUR='mkt';const p=sm(lt/(D*0.5));put(C.k2,-0.6,1.4,{look:1,eyes:0.9,smile:false});put(C.k3,0.2,1.5,{look:-1,eyes:0.9,smile:false});put(C.tham,1.6,-0.6,{eyes:0.7,look:-1});cm([lerp(-1.4,-0.9,p),1.55,3.6],[0.2,1.25,0.8],40);return 'mkt'}
 CUR='inn';nightIn(0.2);LAMP1.visible=false;moonSpot.intensity=7;const p=sm(seg(lt,D*0.5,D));put(C.tham,-1.0,-1.0,{sit:true,phoneLap:true,eyes:0.65,look:0,T});cm([lerp(0.6,0.2,p),1.45,lerp(1.8,1.3,p)],[-1.0,0.85,-1.0],40);return 'inn'};
// ---- núi Cấm: am thầy Bảy (đêm rằm) ----
const AMX=-4.2,AMZ=-3;
S.mount=(lt,D,T)=>{CUR='mtn';mtnMode('night');amL.intensity=2.2*flick(T);const p=sm(lt/D);const z=lerp(3,0.4,p);putM(C.tham,pathX(z),z,{eyes:0.95,look:-1,walk:T*6,T});C.tham.position.y+=Math.abs(Math.sin(T*6))*0.03;cm([2.6,H(2,4)+1.8,5.6],[pathX(z)-0.8,H(0,z)+1.2,z-1],44);return 'mtn'};
S.thay=(lt,D,T)=>{CUR='mtn';mtnMode('night');amL.intensity=2.6*flick(T);POT_AM.visible=true;const y=AM.position.y;
 if(lt<D*0.5){put(C.bay,AMX-0.3,AMZ+0.4,{eyes:0.85,look:1,T},y+0.15);put(C.tham,AMX+1.3,AMZ+1.5,{look:-1,eyes:0.9},H(AMX+1.3,AMZ+1.5));cm([AMX+0.8,y+1.6,AMZ+5.6],[AMX+0.5,y+1.0,AMZ+0.8],44)}
 else{potAnim(POT_AM,T,{glow:0.9,pulse:1});cm([AMX+0.55,y+1.15,AMZ+1.35],[AMX+0.45,y+0.95,AMZ+0.3],38)}return 'mtn'};
const bayClose=(lt,D,T,o,dist=1.4,side=0.25)=>{CUR='mtn';mtnMode('night');amL.intensity=2.6*flick(T);POT_AM.visible=true;potAnim(POT_AM,T,{glow:0.5});const y=AM.position.y;put(C.bay,AMX-0.3,AMZ+0.4,Object.assign({mouth:TK('TB'),eyes:0.85,T},o),y+0.15);close(C.bay,dist,36,side);return 'mtn'};
S.thay2=(lt,D,T)=>bayClose(lt,D,T,{armA:[undefined,-2.4]},lerp(1.6,1.3,sm(lt/D)));
S.thay3=(lt,D,T)=>{if(lt<D*0.62)return bayClose(lt,D,T,{},1.5,-0.3);return bayClose(lt,D,T,{eyes:1.25,pupil:2},lerp(1.3,0.95,sm(seg(lt,D*0.62,D))),0.1)};
S.thay4=(lt,D,T)=>{if(lt<D*0.62)return bayClose(lt,D,T,{look:1},lerp(1.4,1.1,sm(lt/D)),0.35);CUR='mtn';mtnMode('night');amL.intensity=2.6*flick(T);const y=AM.position.y;const x=AMX+1.3,z=AMZ+1.6;put(C.tham,x,z,{pot:true,glow:0.6,eyes:1.05,look:-1,T},H(x,z));put(C.bay,AMX-0.3,AMZ+0.4,{T},y+0.15);carryL.intensity=1.0;carryL.position.set(x,H(x,z)+0.6,z+0.4);close(C.tham,lerp(1.6,1.3,sm(seg(lt,D*0.62,D))),36,-0.3);return 'mtn'};
// ---- nuôi ngải bằng máu ----
S.feed=(lt,D,T)=>{CUR='inn';nightIn(0.35);LAMP1.visible=false;moonSpot.intensity=5;const fed=lt>D*0.42;bedPot(T,{glow:0.4+0.8*sm(seg(lt,D*0.5,D)),shake:lt>D*0.6,amp:0.7,pulse:1});
 if(!fed){put(C.tham,-0.4,-1.7,{sit:true,eyes:0.9,look:-1,reachDown:0.55,T},-0.12);cm([0.9,1.35,0.3],[-0.6,0.8,-1.9],42);return 'inn'}
 const q=seg(lt,D*0.45,D);DROPS.forEach((d,k)=>{const ph=(q*3-k*0.8);if(ph<0||ph>1)return;d.visible=true;d.position.set(BX+0.02,lerp(1.0,0.66,ph*ph),BZ+0.02)});RED=0.05*Math.sin(T*4)**2;potClose(sm(q),0.85,0.6,38);return 'inn'};
// ---- đêm mưa Lợi về ----
S.back=(lt,D,T)=>{CUR='inn';nightIn(0.9);RAIN=1;const p=sm(lt/D);const open=lt>D*0.35;put(C.tham,0.75,1.5,{back:true,T});if(open){put(C.loi,1.35,3.1,{wet:true,pale:true,eyes:1.1,T});fillL.color.set(0x9ab8e8);fillL.intensity=2.6;fillL.position.set(1.4,2.0,2.3)}
 const lf=lt-D*0.55;if(lf>0&&lf<0.35)FLASH=0.6*(1-lf/0.35);cm([lerp(1.7,1.55,p),1.5,lerp(0.3,0.9,p)],[1.25,1.25,3.0],44);return 'inn'};
const porch=()=>{nightIn(0.9);RAIN=0.7;fillL.color.set(0x9ab8e8);fillL.intensity=2.4;fillL.position.set(1.3,2.0,2.3)};
S.loi1=(lt,D,T)=>{CUR='inn';porch();put(C.loi,1.35,3.1,{wet:true,pale:true,eyes:1.05,mouth:TK('L'),T});cm([1.45,HY+0.02,lerp(1.15,1.35,sm(lt/D))],[1.35,HY-0.12,3.1],36);return 'inn'};
S.thamhug=(lt,D,T)=>{CUR='inn';porch();put(C.tham,1.2,1.55,{tears:true,eyes:1.1,mouth:TK('TM'),T});cm([1.0,HY+0.05,lerp(3.5,3.3,sm(lt/D))],[1.2,HY-0.12,1.55],36);return 'inn'};
S.rule2=(lt,D,T)=>{CUR='inn';porch();RAIN=0.5;const p=sm(lt/D);put(C.tham,lerp(1.2,1.0,p),lerp(1.55,0.9,p),{arm:[undefined,-0.9],eyes:1.0,tears:true,T});put(C.loi,lerp(1.7,1.6,p),lerp(2.4,1.4,p),{wet:true,pale:true,eyes:1.0,T});cm([lerp(-0.6,-0.4,p),1.55,lerp(1.2,0.9,p)],[1.3,1.1,1.5],44);return 'inn'};
// ---- những ngày lạ lùng ----
S.odd1=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.45;sunL.intensity=0.6;const p=sm(lt/D);BOWL.visible=true;put(C.loi,1.3,1.05,{sit:true,pale:true,eyes:0.9,look:0,T},-0.2);cm([lerp(-0.4,0.0,p),1.5,2.7],[1.6,0.9,0.4],44);return 'inn'};
S.odd2=(lt,D,T)=>{CUR='inn';nightIn(0.15);LAMP1.visible=false;moonSpot.intensity=6;const p=sm(lt/D);bedPot(T,{glow:0.7,pulse:1});fillL.color.set(0xff5a4a);fillL.intensity=0.8;fillL.position.set(-0.7,0.9,-1.9);inBed(C.tham,-1,{back:true});put(C.loi,-0.4,-1.75,{sit:true,pale:true,eyes:1.3,pupil:1.6,look:-1,T},-0.18);
 cm([lerp(1.2,0.4,p),lerp(1.4,1.3,p),lerp(0.9,-0.15,p)],[-0.45,1.0,-1.75],lerp(44,38,p));return 'inn'};
S.odd3=(lt,D,T)=>{CUR='inn';nightIn(0.1);LAMP1.visible=false;moonSpot.intensity=5;const two=lt>D*0.38;const q=sm(seg(lt,D*0.38,D*0.9));bedPot(T,{glow:0.9*flick(T),pulse:1});leanPot(q);fillL.color.set(0xff4a3a);fillL.intensity=1.0;fillL.position.set(-0.7,0.8,-1.8);
 if(!two){inBed(C.tham,-1,{eyes:1.25,look:1,T});const c=C.tham;cm([c.position.x+0.6,1.5,c.position.z+1.4],[c.position.x,1.0,c.position.z],38);return 'inn'}
 put(C.loi,-0.4,-1.95,{sit:true,pale:true,eyes:0.5,tilt:0.25,mouth:Math.sin(T*9)>0.3?'o':undefined,look:-1,T},-0.35);cm([0.55,1.15,-0.25],[-0.6,0.75,-2.05],44);return 'inn'};
S.thamask=(lt,D,T)=>{CUR='inn';nightIn(0.1);LAMP1.visible=false;moonSpot.intensity=5;bedPot(T,{glow:0.6});inBed(C.tham,-1,{eyes:1.2,look:1,mouth:TK('TM'),T});const c=C.tham;cm([c.position.x+0.6,1.5,c.position.z+1.3],[c.position.x,1.0,c.position.z],36);return 'inn'};
S.loi2=(lt,D,T)=>{CUR='inn';nightIn(0.05);LAMP1.visible=false;moonSpot.intensity=3;bedPot(T,{glow:0.8,pulse:1});fillL.color.set(0xff3a2a);fillL.intensity=1.4;fillL.position.set(-0.9,0.7,-1.3);put(C.loi,-0.4,-1.75,{sit:true,pale:true,eyes:1.2,look:0,mouth:TK('L'),T},-0.18);close(C.loi,lerp(1.1,0.85,sm(lt/D)),36,-0.15,-0.18);return 'inn'};
// bóng trên vách: Thắm có bóng, Lợi thì không (thẻ Lợi không đổ bóng)
S.shadow=(lt,D,T)=>{CUR='inn';night();lampL.intensity=0.4;moonSpot.intensity=0;KG.forEach(k=>k.visible=false);LAMP1.visible=false;shadL.intensity=26*flick(T);shadL.position.set(0.15,1.05,-0.5);shadL.target.position.set(2.3,1.3,-2.6);const p=sm(lt/D);put(C.tham,1.35,-1.85,{eyes:1.0,look:1,T});put(C.loi,2.45,-1.85,{pale:true,eyes:1.0,look:-1,T});CC.inn.loi.castShadow=false;
 if(lt<D*0.55)cm([2.2,1.4,lerp(1.4,1.1,p)],[2.1,1.4,-2.5],52);else cm([lerp(2.6,2.8,p),1.5,lerp(0.3,-0.1,p)],[2.7,1.45,-2.55],46);return 'inn'};
// ---- cuộc gọi ----
S.call=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.7;const p=sm(lt/D);put(C.tham,0.1,-0.7,{phone:true,eyes:0.9,look:0,T});cm([lerp(-0.6,-0.2,p),1.55,1.5],[0.1,1.15,-0.7],42);return 'inn'};
S.tu=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.6;const q=sm(lt/D);put(C.tham,0.1,-0.7,{phone:true,eyes:1.0+0.4*q,pupil:4.5-2*q,tears:lt>D*0.6,T});close(C.tham,lerp(1.4,1.0,q),36,-0.35);return 'inn'};
S.realize=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.45;sunL.intensity=0.5;const q=sm(seg(lt,0,0.7));put(C.tham,0.1,-0.7,{dropPhone:q,eyes:1.45,pupil:2,tears:true,T});close(C.tham,lerp(1.1,0.85,sm(lt/D)),36,-0.2);return 'inn'};
S.realize2=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.35;sunL.intensity=0.3;buongDoor(1);const p=sm(lt/D);
 if(lt<D*0.35){put(C.tham,0.1,-0.7,{back:true,T});cm([-0.5,1.5,1.0],[2.4,1.2,-1.1],44);return 'inn'}
 put(C.loi,3.05,-1.1,{pale:true,mud:true,eyes:1.35,pupil:2,look:0,T});fillL.color.set(0xa0b0a8);fillL.intensity=1.2;fillL.position.set(2.4,1.6,-0.5);cm([lerp(1.6,2.0,p),1.45,lerp(0.4,0.0,p)],[3.05,1.25,-1.1],40);return 'inn'};
S.loi3=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.25;sunL.intensity=0.2;buongDoor(1);fillL.color.set(0xa0b0a8);fillL.intensity=1.1;fillL.position.set(2.4,1.6,-0.5);const q=sm(seg(lt,D*0.5,D));RED=0.12*q;
 if(lt<D*0.72){put(C.loi,3.05,-1.1,{pale:true,mud:true,eyes:1.3,pupil:1.6,mouth:TK('L'),T});cm([lerp(2.0,2.3,sm(lt/D)),HY+0.02,lerp(0.4,0.1,sm(lt/D))],[3.05,HY-0.12,-1.1],36);return 'inn'}
 put(C.ml,3.05,-1.1,{a:0.95,mouth:TK('L')});cm([2.4,HY+0.0,-0.05],[3.05,HY-0.12,-1.1],36);return 'inn'};
// ---- gọi thầy Bảy ----
S.callbay=(lt,D,T)=>{CUR='mkt';mktMode(true);const p=sm(lt/D);put(C.tham,0.2,1.8,{phone:true,eyes:1.2,tears:true,T});cm([lerp(-0.8,-0.4,p),1.4,5.0],[0.2,1.2,1.8],42);return 'mkt'};
const bayNight=(lt,D,T,o,dist)=>{CUR='mtn';mtnMode('night');amL.intensity=2.4*flick(T);const y=AM.position.y;put(C.bay,AMX-0.3,AMZ+0.4,Object.assign({phone:1,mouth:TK('TB'),eyes:0.85,T},o),y+0.15);close(C.bay,dist,36,0.3);return 'mtn'};
S.tb5=(lt,D,T)=>bayNight(lt,D,T,{},lerp(1.7,1.3,sm(lt/D)));
S.tb6=(lt,D,T)=>bayNight(lt,D,T,{eyes:1.1},lerp(1.3,1.0,sm(lt/D)));
// ---- ôm chậu ra ngã ba (đường làng, thốt nốt) ----
const runAt=(z,o)=>{putM(C.tham,pathX(z),z,Object.assign({pot:true,glow:0.7,pulse:1,walk:NOW*9},o));C.tham.position.y+=Math.abs(Math.sin(NOW*7))*0.03;carryL.intensity=1.3;carryL.position.set(pathX(z),H(0,z)+0.9,z+0.4);mfill.intensity=0.7;mfill.position.set(pathX(z)+0.8,H(0,z)+1.8,z+1.6)};
S.run=(lt,D,T)=>{CUR='mtn';const p=sm(lt/D);const z=lerp(3.5,0.5,p);runAt(z,{eyes:1.1,T});cm([pathX(z)+1.8,H(0,z+3)+1.6,z+3.6],[pathX(z),H(0,z)+1.1,z],44);return 'mtn'};
S.follow=(lt,D,T)=>{CUR='mtn';const p=sm(lt/D);const z=lerp(0.2,-2.5,p);runAt(z,{eyes:1.25,pupil:2.5,T});const q=sm(seg(lt,D*0.3,D));if(q>0){const zg=z+lerp(5.5,3.6,q);putM(C.ml,pathX(zg)+1.7,zg,{a:0.8})}
 cm([pathX(z)-0.6,H(0,z)+1.55,z-2.4],[pathX(z),H(0,z)+1.1,z+1.5],46);return 'mtn'};
S.gl1=(lt,D,T)=>{CUR='mtn';const z=-3.2;runAt(z,{eyes:1.35,pupil:2,tears:true,T});const zg=z+lerp(2.6,1.8,sm(lt/D));putM(C.ml,pathX(zg)+1.15,zg,{a:0.85,mouth:TK('GL')});const c=C.tham;
 cm([c.position.x-0.55,c.position.y+0.32,z-lerp(1.8,1.5,sm(lt/D))],[c.position.x+0.45,c.position.y+0.2,z+1.0],48);return 'mtn'};
S.nturn=(lt,D,T)=>{CUR='mtn';const smash=lt>D*0.8;if(lt<D*0.45){const z=-3.6;runAt(z,{bite:true,eyes:1.3,pupil:2,T});close(C.tham,1.2,36,0.25);return 'mtn'}
 const p=sm(seg(lt,D*0.45,D*0.8));const z=lerp(-5,NZ+1.2,p);if(!smash){runAt(z,{bite:true,T});cm([pathX(z)+2.4,H(0,z+5)+2.0,z+5.5],[pathX(z),H(0,z)+1.0,z],44);return 'mtn'}
 SHARDS.visible=true;putM(C.tham,NX+0.1,NZ+1.1,{bite:true,eyes:1.3,T});const ty=H(NX,NZ);cm([NX+1.2,ty+1.3,NZ+2.6],[NX-0.1,ty+0.4,NZ+0.6],44);return 'mtn'};
const kneel=(o)=>{const x=NX+0.15,z=NZ+0.75;putM(C.tham,x,z,Object.assign({sit:true},o));C.tham.position.y-=0.25;const g=H(x,z);carryL.intensity=1.3;carryL.position.set(NX,g+0.45,NZ+1.0);mfill.intensity=0.9;mfill.position.set(NX+0.8,g+1.5,NZ+2.0);return [x,g,z]};
S.root=(lt,D,T)=>{CUR='mtn';SHARDS.visible=true;const q=sm(seg(lt,0,D*0.7));const [x,g,z]=kneel({reachDown:-0.45,roots:q,eyes:1.35,pupil:2,T});
 if(lt<D*0.4){cm([x+0.6,g+0.9,z+1.6],[x-0.1,g+0.35,z+0.1],42);return 'mtn'}cm([x+0.2,g+0.7,z+lerp(1.4,1.15,sm(seg(lt,D*0.4,D)))],[x-0.1,g+0.42,z],40);return 'mtn'};
S.cut=(lt,D,T)=>{CUR='mtn';SHARDS.visible=true;const pull=sm(seg(lt,D*0.3,D*0.45));const [x,g,z]=kneel({reachDown:lerp(-0.45,0.6,pull),roots:pull<0.5?1:0.25,blood:true,bite:true,eyes:lerp(1.3,1.5,pull),pupil:2,T});
 if(lt>D*0.42&&lt<D*0.6)RED=0.35*(1-seg(lt,D*0.42,D*0.6));cm([x+0.3,g+0.85,z+lerp(1.6,1.35,sm(lt/D))],[x-0.05,g+0.55,z],40);return 'mtn'};
S.fall=(lt,D,T)=>{CUR='mtn';SHARDS.visible=true;const [x,g,z]=kneel({reachDown:0.3,blood:true,roots:0,eyes:1.45,pupil:1.8,look:1,T});BLACK=0.2;cm([x+0.1,g+0.95,z+1.9],[x,g+0.82,z],36);return 'mtn'};
S.corpse=(lt,D,T)=>{CUR='mtn';SHARDS.visible=true;CORPSE.visible=true;const [x,g,z]=kneel({back:true,T});const cz=NZ+2.0,cg=H(NX,cz);const p=sm(lt/D);mfill.intensity=2.2;mfill.position.set(NX+0.6,cg+1.3,cz+0.5);carryL.intensity=0;
 cm([NX+lerp(0.7,0.5,p),cg+lerp(1.7,1.4,p),cz+lerp(1.6,1.2,p)],[NX,cg+0.1,cz-0.3],lerp(46,42,p));return 'mtn'};
// ---- kết: không jumpscare, chỉ không khí ----
S.end=(lt,D,T)=>{CUR='inn';day();dayL.intensity=0.7;const p=sm(lt/D);put(C.tham,1.5,-1.6,{tang:true,tears:true,bandage:true,eyes:0.6,T});cm([lerp(1.9,1.6,p),1.75,lerp(0.9,0.6,p)],[1.5,1.6,-2.3],44);return 'inn'};
S.end2=(lt,D,T)=>{CUR='inn';nightIn(0.15);LAMP1.visible=false;moonSpot.intensity=8;const p=sm(lt/D);put(C.tham,-1.0,-1.0,{sit:true,bandage:true,reachDown:0.15,eyes:0.8,look:-1,T});cm([lerp(0.6,0.2,p),1.45,lerp(1.6,1.2,p)],[-1.0,0.85,-1.0],40);return 'inn'};
S.final=(lt,D,T)=>{CUR='inn';nightIn(0.1);LAMP1.visible=false;moonSpot.intensity=7;const q=sm(seg(lt,D*0.25,D));put(C.tham,-1.0,-1.0,{sit:true,reachDown:0.15,sprout:0.15+0.85*q,eyes:1.2,look:-1,T});fillL.color.set(0xff6a5a);fillL.intensity=0.9;fillL.position.set(-1.0,0.9,-0.3);const hx=-1.23,hy=0.55;
 {const k=sm(lt/D);cm([lerp(-0.55,-1.05,k),lerp(1.2,0.75,k),lerp(1.0,-0.2,k)],[lerp(-1.0,-1.22,k),lerp(0.95,0.6,k),-1.0],40)};return 'inn'};
S.gfinal=(lt,D,T)=>{CUR='inn';nightIn(0.05);LAMP1.visible=false;moonSpot.intensity=6*flick(T);fillL.color.set(0xff6a5a);fillL.intensity=0.5;fillL.position.set(-1.0,0.9,-0.3);put(C.tham,-1.0,-1.0,{sit:true,reachDown:0.15,sprout:1,eyes:1.3,pupil:2,T});put(C.ml,-0.15,-2.45,{a:0.75,mouth:TK('GL')});
 cm([lerp(-0.2,-0.35,sm(lt/D)),1.4,lerp(1.5,1.2,sm(lt/D))],[-0.75,1.1,-1.5],46);return 'inn'};
S.cta=(lt,D,T)=>{CUR='mtn';ctaFlag=true;POT_TOP.visible=true;potAnim(POT_TOP,T,{glow:1.2,pulse:1,shoot:1});const ty=H(NX,NZ);cm([NX+0.2,ty+lerp(1.4,1.2,sm(lt/D)),NZ+lerp(2.4,1.8,sm(lt/D))],[NX,ty+0.5,NZ],42);return 'mtn'};

// ===== LỚP CHUYỂN ĐỘNG CHUNG (áp cho mọi cảnh) =====
const HSH=s=>{let h=0;for(const ch of s)h=(h*31+ch.charCodeAt(0))%9973;return h/9973};
const SPK={loi:'L',tham:'TM',bay:'TB',ml:'L'};
const speaking=(kk)=>{const sp=SPK[kk];if(!sp)return false;for(const [a,b,s] of TLD.vox){if((s===sp||(kk==='ml'&&s==='GL'))&&NOW>=a-0.05&&NOW<b+0.15)return true}return false};
const GHOST={ma:1,ml:1};
function startleAt(t){let best=-1;for(const [jk,jf] of JUMPS.concat(SOFT)){const q=TLD.scenes.find(x=>x[0]===jk);if(!q)continue;const d=t-(q[1]+(q[2]-q[1])*jf);if(d>=0&&d<0.7)best=d}return best}
function motionPre(kk,c,t){const o=Object.assign({},c.userData.o);const h=HSH(kk);
 if(!GHOST[kk]&&!o.back){const per=3.2+h*1.6,u=(t+h*7)%per;if(u<0.13&&(o.eyes===undefined||o.eyes>0.3))o.eyes=0.05}
 if(speaking(kk)&&!o.pot&&!o.phone&&!o.phoneLap&&!o.point&&!o.sit&&!o.back){const g=-0.18-0.22*Math.max(0,Math.sin(t*2.6+h*5));
  if(kk==='tham'){const a=(o.arm||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.arm=a}}else{const a=(o.armA||[undefined,undefined]).slice();if(a[1]===undefined){a[1]=g;o.armA=a}}}
 if(o.walk!==undefined&&kk==='tham'&&!o.pot){const a=(o.arm||[undefined,undefined]).slice();if(a[0]===undefined)a[0]=-0.12+0.32*Math.sin(o.walk);if(a[1]===undefined)a[1]=0.12+0.32*Math.sin(o.walk);o.arm=a}
 c.userData.o0=c.userData.o;c.userData.o=o}
function motionPost(kk,c,t){const h=HSH(kk);
 if(GHOST[kk]){c.position.y+=0.03*Math.sin(t*1.2+h*6);c.rotateZ(0.03*Math.sin(t*0.6+h*3));}
 else{const br=0.012*Math.sin(t*2.2+h*9);c.scale.set(1,1+br,1);c.position.y+=0.98*br;c.rotateZ(0.012*Math.sin(t*0.9+h*4));
  if(speaking(kk))c.rotateZ(0.02*Math.sin(t*5.5+h));
  const d=startleAt(t);if(d>=0){const k=1-d/0.7;c.position.x+=0.035*Math.sin(d*55)*k;c.scale.y*=1-0.03*k}}
 c.userData.o=c.userData.o0}
// ================= vòng vẽ =================
function rain(a){g2.save();g2.strokeStyle=`rgba(180,200,230,${0.35*a})`;g2.lineWidth=1.6;for(let i=0;i<140;i++){const x=(R(i)*RW*1.2+NOW*60)%(RW*1.2)-RW*0.1,y=(R(i+300)*RH+NOW*1800*(0.8+R(i+7)*0.4))%RH;g2.beginPath();g2.moveTo(x,y);g2.lineTo(x-6,y+38);g2.stroke()}g2.restore()}
window.draw=function(t){NOW=t;const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;BLACK=0;TITLE=false;RED=0;RAIN=0;FLASH=0;blkA.scale.set(1.25,1,0.8);g2.clearRect(0,0,RW,RH);
 CC.inn.loi.castShadow=true;CC.inn.loi.material.emissiveIntensity=0.12;shadL.intensity=0;KG.forEach(k=>k.visible=true);SHARDS.visible=false;CORPSE.visible=false;DROPS.forEach(d=>d.visible=false);BOWL.visible=false;POT2.position.set(BX,BY,BZ);leanPot(0);
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set(1.4+(R(i+5)-0.5)*7,0.3+((R(i+9)*2.5+t*0.05)%2.5),-2.4+p*4);m.material.opacity=0.3*Math.sin(p*Math.PI)});
 smoke.forEach((s,i)=>{const p=(t*0.15+i/12)%1;s.position.set(1.2+Math.sin(p*6+i)*0.06,2.3+p*0.9,-2.35);s.scale.setScalar(0.08+p*0.3);s.material.opacity=0.18*Math.sin(p*Math.PI)});
 mist.forEach((m,i)=>{const z=6-i*0.6;const x=((R(i)*14+t*0.15)%14)-7;m.position.set(x,H(x,z)+0.5+R(i+2)*0.6,z)});
 if(!S[k])console.log('missing',k);const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 let JF=-1;for(const [jk,jf,jz,hard] of JUMPS.concat(SOFT)){const sc2=TLD.scenes.find(q=>q[0]===jk);if(!sc2)continue;const tj=sc2[1]+(sc2[2]-sc2[1])*jf,dt=t-tj;if(dt<0||dt>1.4)continue;const z=dt<0.1?dt/0.1*jz:jz*Math.max(0,1-(dt-0.1)/1.3);const tv=new THREE.Vector3(...CT);cam.position.lerp(tv,z);if(hard&&dt<0.5){const a2=0.05*(1-dt/0.5);cam.position.x+=(R(t*977)-0.5)*a2*2;cam.position.y+=(R(t*631)-0.5)*a2*2}cam.lookAt(tv);if(hard)JF=dt}
 for(const kk in CC[mode]){const c=CC[mode][kk];if(!c.visible){c.scale.set(1,1,1);continue}motionPre(kk,c,t);c.userData.paint(t);c.scale.set(1,1,1);c.lookAt(cam.position.x,c.position.y,cam.position.z);motionPost(kk,c,t)}
 renderer.render(SCN[mode],cam);
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.55)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(RAIN)rain(RAIN);
 if(FLASH){g2.fillStyle=`rgba(220,230,255,${FLASH})`;g2.fillRect(0,0,RW,RH)}
 if(RED){g2.fillStyle=`rgba(140,0,0,${RED})`;g2.fillRect(0,0,RW,RH)}
 if(JF>=0&&JF<0.3){if(JF<0.06){g2.fillStyle='rgba(255,255,255,.55)';g2.fillRect(0,0,RW,RH)}else{g2.fillStyle=`rgba(160,0,0,${0.35*(1-JF/0.3)})`;g2.fillRect(0,0,RW,RH)}}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 grain(0.06);
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
