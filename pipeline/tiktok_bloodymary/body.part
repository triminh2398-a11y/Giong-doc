 const rim2=new THREE.Mesh(new THREE.TorusGeometry(0.47,0.012,8,48),M({color:0xb08a4a,metalness:0.7,roughness:0.3}));rim2.scale.set(1,1.33,1);rim2.position.z=0.01;MIR.add(rim2);
