 for(let k=0;k<500;k++){g.fillStyle=`rgba(${R(k)>0.5?60:20},${R(k)>0.5?50:30},${30},${0.05+R(k+2)*0.1})`;g.beginPath();g.arc(R(k*3)*w,R(k*7)*h,3+R(k)*16,0,7);g.fill()}
