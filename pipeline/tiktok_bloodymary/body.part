const PUMP=[];function pumpkin(par,x,y,z,s=1){const g=new THREE.Group();g.position.set(x,y,z);g.scale.setScalar(s);par.add(g);const b=new THREE.Mesh(new THREE.SphereGeometry(0.2,18,14),new THREE.MeshStandardMaterial({map:pumpT,emissive:0xff7010,emissiveMap:pumpT,emissiveIntensity:0.8}));b.scale.set(1.2,0.85,1.2);b.rotation.y=-Math.PI/2;g.add(b);const st=new THREE.Mesh(new THREE.CylinderGeometry(0.025,0.035,0.1,6),M({color:0x3a5a20}));st.position.y=0.19;g.add(st);const L=new THREE.PointLight(0xff8a30,1.2,3,2);L.position.y=0.05;g.add(L);g.userData.L=L;PUMP.push(g);return g}
