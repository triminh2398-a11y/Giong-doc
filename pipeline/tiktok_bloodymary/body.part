const CI={},C={};const HY={vy:1.27,th:1.27,ma:1.27,og:1.27};
for(const k in defs){const [h,f]=defs[k];CI[k]=card(h,f,true);CI[k].visible=false;inn.add(CI[k]);C[k]=card(h,f,true);C[k].visible=false;ext.add(C[k])}
CI.ma.material.emissive=new THREE.Color(0x3a5a6a);CI.ma.material.emissiveMap=CI.ma.material.map;CI.ma.material.emissiveIntensity=0.35;
function put(c,x,z,o,y){c.visible=true;c.position.set(x,(y||0)+(c.geometry.parameters.height/2)-0.02,z);c.userData.o=o||{}}
const onStep=(c,n,o,x=0)=>put(c,x,zst(n),o,yst(n));
function hideAll(){for(const k in CI)CI[k].visible=false;for(const k in C)C[k].visible=false;MIR.visible=false;power(false);candleL.intensity=0;blueL.intensity=0;fillL.intensity=0;phone(false);bunGlow.intensity=0;hallL.intensity=0;roomDoor(0);gap.visible=false;fing.visible=false;BUN.position.x=0.1}
function cm(P,L,fov){cam.fov=fov||45;cam.position.set(...P);cam.lookAt(...L)}
function close(c,dist,fov=36,side=0.3,dy=0){const k=Object.keys(CI).find(q=>CI[q]===c);const hy=HY[k]+(c.position.y-(c.geometry.parameters.height/2-0.02));const x=c.position.x,z=c.position.z;dist+=0.8;cm([x+side,hy+0.05+dy,z+dist],[x,hy-0.12+dy,z],fov)}
// nến trong tay Vy (tay trái, trước ngực)
function vyCandle(c,on,fl=1){if(!on)return;candleL.intensity=2.6*fl;candleL.position.set(c.position.x,c.position.y-0.25,c.position.z+0.35)}
const talk=(lt,on=true)=>on&&Math.sin(lt*13)>0?'o':undefined;
const ST=TLD.starts,DU=TLD.durs;
