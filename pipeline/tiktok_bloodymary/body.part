// đặt gương trước camera: mx,my lệch khung; dist khoảng cách; tilt nghiêng
function mirShot(mode,q,T,mx=0,my=0,dist=1.3,tilt=0){MIR.visible=true;cam.updateMatrixWorld();const f=new THREE.Vector3();cam.getWorldDirection(f);const up=cam.up.clone(),rt=new THREE.Vector3().crossVectors(f,up).normalize();const u=new THREE.Vector3().crossVectors(rt,f).normalize();
 MIR.scale.setScalar(0.3);MIR.position.copy(cam.position).addScaledVector(f,dist).addScaledVector(rt,mx).addScaledVector(u,my);MIR.quaternion.copy(cam.quaternion);MIR.rotateZ(tilt);
 const g=mirC.getContext('2d');mirrorView(g,512,680,mode,T,q);mirTx.needsUpdate=true}

