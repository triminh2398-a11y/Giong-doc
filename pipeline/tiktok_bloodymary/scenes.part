S.choice2=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,out:true,mirror:true,mglow:1,eyes:1.3,tears:true,mouth:'o'});blueL.intensity=1.6;blueL.position.set(CI.vy.position.x+0.3,CI.vy.position.y+0.6,CI.vy.position.z+1.0);
