const STILL=new THREE.Group();inn.add(STILL);{const c=new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,0.2,10),M({color:0xece4cc}));c.position.y=0.1;STILL.add(c);const f=new THREE.Mesh(new THREE.SphereGeometry(0.022,10,8),new THREE.MeshBasicMaterial({color:0xffd27a}));f.scale.y=1.8;f.position.y=0.24;STILL.add(f);
 const m=new THREE.Mesh(new THREE.CircleGeometry(0.14,32),M({color:0x9ab0c8,metalness:0.9,roughness:0.15}));m.scale.y=1.33;m.rotation.x=-Math.PI/2+0.2;m.position.set(0.3,0.02,0.02);STILL.add(m);const r=new THREE.Mesh(new THREE.TorusGeometry(0.15,0.015,8,32),M({color:0x3a2416}));r.scale.y=1.33;r.rotation.x=-Math.PI/2+0.2;r.position.set(0.3,0.02,0.02);STILL.add(r)}
STILL.position.set(-0.2,yst(3),zst(3));
// ---------- video trên điện thoại (overlay) ----------
function phoneVideo(a,lt,T){g2.save();g2.globalAlpha=a;g2.fillStyle='rgba(0,0,0,.75)';g2.fillRect(0,0,RW,RH);const pw=440,ph=820,px=(RW-pw)/2,py=150;g2.fillStyle='#0c0d10';g2.beginPath();g2.roundRect(px-14,py-14,pw+28,ph+28,40);g2.fill();g2.save();g2.beginPath();g2.roundRect(px,py,pw,ph,26);g2.clip();
 g2.fillStyle='#08090c';g2.fillRect(px,py,pw,ph);const old=ctx;ctx=g2;ctx.save();ctx.translate(px,py);
 ctx.strokeStyle='rgba(150,130,110,.35)';ctx.lineWidth=5;for(let k=0;k<12;k++){const y=ph*0.95-k*52;ctx.beginPath();ctx.moveTo(pw*0.15+k*6,y);ctx.lineTo(pw*0.85-k*6,y);ctx.stroke()}
 halo(pw*0.5,ph*0.4,260,'255,190,110',0.25);const p=sm(lt/2.6);vy(pw*0.5,ph*0.78-p*120,0.95-p*0.15,{candle:true,mirror:true,T,back:false,eyes:1.1});
 const late=lt>2.4;if(late){const [hx,hy]=HP(1,-2.67);const s=0.95-p*0.15;const mx=pw*0.5+(hx+6)*s,my=ph*0.78-p*120+(hy-46)*s;halo(mx,my,160,'80,150,255',0.6);for(const sd of [-1,1]){ctx.save();ctx.translate(mx+sd*14,my-20);ctx.scale(0.9,0.9);paleHand(0,0,sd*0.5-0.2,T);ctx.restore()}}
 ctx.restore();ctx=old;g2.globalAlpha=a*0.25;grain(0.2);g2.globalAlpha=a;
 g2.fillStyle='#ff3030';g2.beginPath();g2.arc(px+34,py+40,9,0,7);g2.fill();g2.fillStyle='#fff';g2.font='bold 24px "DejaVu Sans"';g2.fillText('REC  00:0'+Math.min(9,Math.floor(lt+3)),px+52,py+48);
 g2.restore();g2.restore()}
window.draw=function(t){const sc=TLD.scenes.find(s=>t>=s[1]&&t<s[2])||TLD.scenes[TLD.scenes.length-1];const [k,a,b,ls]=sc;const lt=t-a,D=b-a;
 hideAll();ctaFlag=false;SEPIA=false;BLACK=0;TITLE=false;VIDEO=0;moonSpot.intensity=10;rmMoon.intensity=10;g2.clearRect(0,0,RW,RH);
 PUMP.forEach((g,i)=>{g.userData.L.intensity=1.2*(0.85+0.15*Math.sin(t*11+i))});STILL.visible=(k==='title'||k==='cta');PUMP.forEach(g=>g.visible=true);
 motes.forEach((m,i)=>{const p=(t*0.04+R(i))%1;m.position.set((R(i+5)-0.5)*1.8,0.3+((R(i+9)*3+t*0.05)%3),-3+p*5);m.material.opacity=0.35*Math.sin(p*Math.PI)});
 const mode=S[k](lt,D,t,ls);cam.aspect=RW/RH;cam.updateProjectionMatrix();
 if(MIR.visible){const f=new THREE.Vector3();cam.getWorldDirection(f)}
 const face=c=>{if(!c.visible)return;c.userData.paint(t);c.lookAt(cam.position.x,c.position.y,cam.position.z)};
 if(mode.startsWith('ext')){for(const kk in C)face(C[kk]);renderer.render(ext,cam)}else{for(const kk in CI)face(CI[kk]);renderer.render(inn,cam)}
 const vg=g2.createRadialGradient(RW/2,RH/2,RH*0.25,RW/2,RH/2,RH*0.75);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.55)');g2.fillStyle=vg;g2.fillRect(0,0,RW,RH);
 if(SEPIA){tint('rgba(150,110,50,.25)');grain(0.12)}
 if(BLACK){g2.fillStyle=`rgba(0,0,0,${BLACK})`;g2.fillRect(0,0,RW,RH)}
 if(VIDEO)phoneVideo(VIDEO,lt,t);
 if(TITLE)titleTxt(lt,sm(seg(lt,0.1,0.6)));
 if(ctaFlag)ctaTxt(sm(seg(lt,0.1,0.6)));
 const d=Math.min(t-a,b-t);if(d<0.08&&a>0){g2.fillStyle=`rgba(0,0,0,${1-d/0.08})`;g2.fillRect(0,0,RW,RH)}
 watermark(t);if(k!=='title')subs(t)};
Promise.all(IMGS).then(()=>{window.READY=true});
</script></body></html>
