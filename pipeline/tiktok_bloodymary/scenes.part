// ================= cảnh =================
const S={};let ctaFlag=false,SEPIA=false,BLACK=0,TITLE=false,VIDEO=0;
// góc dưới chân cầu thang nhìn lên
const lowCam=(p,fov=44)=>cm([lerp(0.35,0.1,p),1.1,lerp(3.4,2.6,p)],[0,1.6,-2.5],fov);
const fill=(x,y,z,i=1.2)=>{fillL.intensity=i;fillL.position.set(x,y,z)};
S.hook=(lt,D,T)=>{const p=sm(lt/D);onStep(CI.vy,6,{candle:true,mirror:true,eyes:1.15,look:0});vyCandle(CI.vy,true,0.9+0.1*Math.sin(T*11));put(CI.ma,0.15,zst(13)-0.6,{a:0.8},yst(13));moonSpot.intensity=14;fill(0,1.2,1.5,0.8);cm([0.2,lerp(1.0,1.15,p),lerp(3.0,2.2,p)],[0,1.75,-2.2],42);return 'inn'};
S.hook2=(lt,D,T)=>{onStep(CI.vy,6,{candle:true,mirror:true,eyes:1.2});vyCandle(CI.vy,true);const p=sm(lt/D);cm([0.35,yst(6)+1.35,zst(6)+1.3],[0.1,yst(6)+1.35,zst(6)],40);mirShot('change',lerp(0.15,0.5,p),T,0,0.02,lerp(1.15,0.95,p),-0.08);return 'inn'};
S.title=(lt,D,T)=>{const p=sm(lt/D);candleL.intensity=2.4*(0.9+0.1*Math.sin(T*12));candleL.position.set(0,yst(3)+0.3,zst(3));moonSpot.intensity=8;TITLE=true;cm([0,lerp(1.0,1.3,p),lerp(3.2,2.4,p)],[0,1.6,-2],46);return 'inn'};
S.origin=(lt,D,T)=>{SEPIA=true;const p=sm(lt/D);onStep(CI.og,lerp(2,6,p)|0,{eyes:0.9,look:0});vyCandle(CI.og,true);moonSpot.intensity=6;fill(0,1.4,2,0.7);lowCam(p,46);return 'inn'};
S.origin2=(lt,D,T)=>{SEPIA=true;onStep(CI.og,7,{eyes:1});vyCandle(CI.og,true);const p=sm(lt/D);cm([0.35,yst(7)+1.35,zst(7)+1.3],[0.1,yst(7)+1.35,zst(7)],40);mirShot('groom',1,T,0,0,lerp(1.2,1.0,p),-0.05);return 'inn'};
S.skull=(lt,D,T)=>{SEPIA=true;onStep(CI.og,7,{eyes:1.3,mouth:'o'});vyCandle(CI.og,true,0.8);const p=sm(lt/D);cm([0.35,yst(7)+1.35,zst(7)+1.3],[0.1,yst(7)+1.35,zst(7)],40);mirShot('skull',1,T,0,0,lerp(1.15,0.9,p),-0.05);return 'inn'};
S.dorm=(lt,D,T)=>{const p=sm(lt/D);cm([lerp(-4,-2,p),1.6,lerp(16,13,p)],[0,4.5,-12],46);return 'ext'};
S.thao=(lt,D,T)=>{power(true);put(CI.th,0.55,1.4,{phone:true,laugh:true,mouth:talk(lt),look:-1});put(CI.vy,-0.55,1.5,{look:1,eyes:1.05});cm([lerp(0.6,0.3,sm(lt/D)),1.4,4.4],[0,1.15,1.2],40);return 'inn'};
S.vy=(lt,D,T)=>{power(true);put(CI.vy,-0.55,1.5,{look:1,eyes:1.2,mouth:talk(lt)});close(CI.vy,1.3,36,0.3);return 'inn'};
S.rules=(lt,D,T)=>{power(true);put(CI.th,0.55,1.4,{phone:true,mouth:talk(lt),look:0,eyes:1.05});put(CI.vy,-0.55,1.5,{look:1,eyes:1.1});const p=sm(lt/D);close(CI.th,lerp(1.9,1.5,p),38,-0.5);return 'inn'};
S.rules2=(lt,D,T)=>{power(true);put(CI.th,0.55,1.4,{phone:true,mouth:talk(lt),look:-1,eyes:1.1});put(CI.vy,-0.55,1.5,{look:1,eyes:1.2});if(lt<D*0.55)cm([-1.4,1.45,3.6],[0.3,1.2,1.3],40);else close(CI.vy,1.3,36,-0.2);return 'inn'};
S.rules3=(lt,D,T)=>{power(true);put(CI.th,0.55,1.4,{laugh:true,mouth:talk(lt),look:-1});close(CI.th,1.3,36,0.3);return 'inn'};
S.stairs=(lt,D,T)=>{const off=lt>D*0.22;power(!off);if(off){moonSpot.intensity=6}const p=sm(lt/D);put(CI.th,1.3,1.6,{phone:true,look:-1});onStep(CI.vy,lt>D*0.7?1:0,{candle:off,mirror:off,eyes:1.1},0);if(lt<D*0.7)CI.vy.position.z=0.5;vyCandle(CI.vy,off);if(off&&lt<D*0.3)BLACK=0.8;cm([lerp(-0.8,-0.4,p),1.5,4.6],[0,1.2,0],42);return 'inn'};
S.step=(lt,D,T,ls)=>{const s2=lt>(ls[1]||D*0.4);onStep(CI.vy,s2?2:1,{candle:true,mirror:true,eyes:1.1});vyCandle(CI.vy,true);moonSpot.intensity=6;
 if(lt<D*0.6){fill(0,1.2,2,0.6);lowCam(sm(lt/D),44)}else{cm([0.35,yst(2)+1.35,zst(2)+1.3],[0.1,yst(2)+1.35,zst(2)],40);mirShot('vy',0,T,0,0,1.1,-0.06)}return 'inn'};
S.man=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,mirror:true,eyes:1.1});vyCandle(CI.vy,true);moonSpot.intensity=6;if(lt<D*0.3){fill(0,1.6,1,0.6);lowCam(0.8,40)}else{const p=sm(seg(lt,D*0.3,D));cm([0.35,yst(7)+1.35,zst(7)+1.3],[0.1,yst(7)+1.35,zst(7)],40);mirShot('man',p,T,0,0,lerp(1.15,1.0,p),-0.06)}return 'inn'};
S.vy2=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,mirror:true,eyes:1.35,pupil:2.5,mouth:talk(lt),tears:true});vyCandle(CI.vy,true,0.9+0.1*Math.sin(T*17));fill(0,yst(7)+1.3,zst(7)+1.4,0.5);close(CI.vy,1.2,36,0.25);return 'inn'};
S.thaolaugh=(lt,D,T)=>{put(CI.th,0.3,1.0,{phone:true,flash:true,laugh:true,look:0,eyes:0.8});fillL.intensity=3;fillL.position.set(0.5,1.7,0.8);const p=sm(lt/D);cm([lerp(-0.3,0,p),yst(9)+1.2,zst(9)],[0.3,1.0,1.0],lerp(44,38,p));return 'inn'};
S.change=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,mirror:true});vyCandle(CI.vy,true,0.8+0.2*Math.sin(T*19));const p=sm(lt/D);cm([0.35,yst(7)+1.35,zst(7)+1.3],[0.1,yst(7)+1.35,zst(7)],40);mirShot('change',sm(seg(lt,0,D*0.85)),T,0,0,lerp(1.15,0.85,p),-0.06);return 'inn'};
S.change2=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,mirror:true,eyes:1.4,pupil:2,tears:true});vyCandle(CI.vy,true,0.8+0.2*Math.sin(T*19));if(lt<D*0.5){cm([0.35,yst(7)+1.35,zst(7)+1.3],[0.1,yst(7)+1.35,zst(7)],40);mirShot('mary',0.1,T,0,0,0.9,-0.06)}else{fill(0,yst(7)+1.3,zst(7)+1.4,0.5);close(CI.vy,1.2,36,0.25)}return 'inn'};
S.prank=(lt,D,T,ls)=>{const sh=lt>ls[1]-0.2;put(CI.th,0.3,1.0,{phone:!sh,shout:sh,mouth:sh?(Math.sin(lt*9)>-0.3?'o':undefined):undefined,laugh:!sh,eyes:1.1});onStep(CI.vy,7,{candle:true,mirror:true});vyCandle(CI.vy,true);fill(0.3,1.6,2.0,1.4);
 if(!sh)cm([-0.6,1.5,3.6],[0.3,1.2,1.0],40);else{const p=sm(seg(lt,ls[1],D));close(CI.th,lerp(1.5,1.1,p),36,0.2)}return 'inn'};
S.candle=(lt,D,T)=>{const out=lt>D*0.3;onStep(CI.vy,7,{candle:true,out,mirror:true,mglow:out?1:0,eyes:1.3});vyCandle(CI.vy,!out,1.4);if(out){blueL.intensity=1.6;blueL.position.set(CI.vy.position.x+0.3,CI.vy.position.y+0.6,CI.vy.position.z+1.0);moonSpot.intensity=2}else moonSpot.intensity=6;
 if(lt>D*0.3&&lt<D*0.38)BLACK=0.95;lowCam(0.6,40);return 'inn'};
S.closer=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,out:true,mirror:true,mglow:1,eyes:1.4,pupil:2,hand:lt>D*0.55,hairOver:lt>D*0.55});blueL.intensity=1.6;blueL.position.set(CI.vy.position.x+0.3,CI.vy.position.y+0.6,CI.vy.position.z+1.0);
 if(lt<D*0.5){cm([0.35,yst(7)+1.35,zst(7)+1.3],[0.1,yst(7)+1.35,zst(7)],40);mirShot('mary2',sm(seg(lt,0,D*0.5)),T,0,0,0.95,-0.06)}else close(CI.vy,lerp(1.4,1.2,sm(seg(lt,D*0.5,D))),36,0.2);return 'inn'};
S.whisper=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,out:true,mirror:true,mglow:1,eyes:0.05,closed:true,tears:true,hand:true,hairOver:true});blueL.intensity=1.6;blueL.position.set(CI.vy.position.x+0.3,CI.vy.position.y+0.6,CI.vy.position.z+1.0);const p=sm(lt/D);close(CI.vy,lerp(1.15,0.95,p),34,lerp(0.2,0.05,p));return 'inn'};
S.rule1=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,out:true,mirror:true,mglow:1,eyes:0.05,closed:true,tears:true,hand:true});blueL.intensity=1.6;blueL.position.set(CI.vy.position.x+0.3,CI.vy.position.y+0.6,CI.vy.position.z+1.0);close(CI.vy,1.35,36,-0.3);return 'inn'};
S.scream=(lt,D,T)=>{const gone=lt>D*0.5;if(!gone)put(CI.th,0.3,1.0,{phone:true,flash:true,eyes:1.4,pupil:2,mouth:'o',shout:true});const fx=gone?sm(seg(lt,D*0.5,D*0.7)):0;phone(true,lerp(0.45,0.7,fx),lerp(1.0,1.5,fx),lerp(0,2.5,fx),gone?20:0);
 if(!gone){fillL.intensity=3;fillL.position.set(0.5,1.7,0.8)}if(gone&&lt<D*0.56)BLACK=0.7;cm([0.1,yst(7)+1.3,zst(7)],[0.4,0.6,1.3],42);return 'inn'};
S.phone=(lt,D,T)=>{phone(true,0.7,1.5,2.5+Math.sin(lt*2)*0.05*(1-sm(lt/D)),20);const p=sm(lt/D);cm([lerp(1.3,1.0,p),0.25,lerp(2.3,2.0,p)],[0.7,0.02,1.5],40);return 'inn'};
S.plan=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,out:true,mirror:true,mglow:1,eyes:1.2,tears:true,hand:true});blueL.intensity=1.6;blueL.position.set(CI.vy.position.x+0.3,CI.vy.position.y+0.6,CI.vy.position.z+1.0);close(CI.vy,1.2,36,0.2);return 'inn'};
S.flip=(lt,D,T)=>{onStep(CI.vy,7,{candle:true,out:true,mirror:true,mglow:1});blueL.intensity=3;blueL.position.set(0.3,yst(7)+0.6,zst(7)+0.4);const p=sm(lt/D);cm([0.2,yst(7)+1.1,zst(7)+1.3],[0.1,yst(7)+1.1,zst(7)],40);const r=sm(seg(lt,0,D*0.4));mirShot(lt<D*0.3?'blue':'thao',1,T,0.0,lerp(-0.5,0,r),lerp(1.3,1.0,p),lerp(Math.PI*0.5,0,r));return 'inn'};
S.thaoin=(lt,D,T)=>{cm([0.2,yst(7)+1.1,zst(7)+1.3],[0.1,yst(7)+1.1,zst(7)],40);blueL.intensity=3;blueL.position.set(0.3,yst(7)+0.9,zst(7)+0.6);const sh=Math.sin(T*31)*0.006;mirShot('thao',1,T,sh,sh,0.95,-0.03);return 'inn'};
