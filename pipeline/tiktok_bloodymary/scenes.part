S.name=(lt,D,T,ls)=>{const fade=lt>ls[1]?1-sm(seg(lt,ls[1],D)):1;onStep(CI.vy,7,{hug:true,mglow:fade,eyes:0.05,closed:true,tears:true,mouth:lt>ls[1]?talk(lt):undefined});blueL.intensity=3*fade;blueL.position.set(CI.vy.position.x,CI.vy.position.y+0.5,CI.vy.position.z+0.5);fill(0,yst(7)+1.3,zst(7)+1.5,0.4);const p=sm(lt/D);close(CI.vy,lerp(1.5,1.1,p),36,lerp(0.3,0.1,p));return 'inn'};
