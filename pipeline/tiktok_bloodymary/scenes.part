S.realize=(lt,D,T)=>{rmMoon.intensity=10;if(lt<D*0.45){power(false);moonSpot.intensity=4;blueL.intensity=1.6;blueL.position.set(0.3,yst(7)+0.9,zst(7)+1.2);cm([0.2,yst(7)+1.1,zst(7)+1.3],[0.1,yst(7)+1.1,zst(7)],40);mirShot('crawl',lerp(0.9,1,sm(lt/D)),T,0,0,0.9,-0.03);SEPIA=false;BLACK=0.15}else{put(CI.vy,20.6,0.5,{eyes:1.35,pupil:2,look:0,tears:true});fill(20.8,1.5,1.6,2.2);close(CI.vy,lerp(1.4,1.1,sm(seg(lt,D*0.45,D))),36,0.2)}return 'inn'};
