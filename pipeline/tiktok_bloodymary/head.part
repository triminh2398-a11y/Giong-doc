<!doctype html><html><head><meta charset="utf-8">
<style>html,body{margin:0;background:#000;overflow:hidden}canvas{position:absolute;left:0;top:0}</style>
<script>const W=1080,H=1920;const cv=document.createElement('canvas');cv.width=512;cv.height=1024;let ctx=cv.getContext('2d');const TL={scenes:[],subs:[],dur:20};</script>
<script src="helpers.js"></script><script src="shots.js"></script><script src="shots_tr.js"></script><script src="tx_chars.js"></script><script src="bm_chars.js"></script>
<script type="importmap">{"imports":{"three":"./lib/three.module.js"}}</script></head><body>
<script type="module">
import * as THREE from 'three';
const TLD=/*TLD*/null;
const RW=720,RH=1280;
const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});renderer.setPixelRatio(1);renderer.setSize(RW,RH);
renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;renderer.outputColorSpace=THREE.SRGBColorSpace;
document.body.appendChild(renderer.domElement);
const ov=document.createElement('canvas');ov.width=RW;ov.height=RH;document.body.appendChild(ov);const g2=ov.getContext('2d');
const cam=new THREE.PerspectiveCamera(45,RW/RH,0.05,400);
const R=i=>{const x=Math.sin(i*127.1+311.7)*43758.5453;return x-Math.floor(x)};
function ctex(w,h,fn,rep){const c=document.createElement('canvas');c.width=w;c.height=h;fn(c.getContext('2d'),w,h);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;if(rep){t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(rep[0],rep[1])}t.anisotropy=8;return t}
const plank=(base,rep)=>ctex(512,512,(g,w,h)=>{g.fillStyle=base;g.fillRect(0,0,w,h);const n=8;for(let i=0;i<n;i++){const y=i*h/n;const k=R(i+3);g.fillStyle=`rgba(${k>0.5?255:0},${k>0.5?220:0},${k>0.5?180:0},${0.04+R(i)*0.06})`;g.fillRect(0,y,w,h/n);g.fillStyle='rgba(0,0,0,.45)';g.fillRect(0,y,w,3);
 for(let j=0;j<40;j++){g.strokeStyle=`rgba(0,0,0,${0.06+R(i*50+j)*0.08})`;g.lineWidth=1+R(j)*2;g.beginPath();const yy=y+R(i*7+j)*h/n;g.moveTo(0,yy);g.bezierCurveTo(w*0.3,yy+(R(j)-0.5)*8,w*0.7,yy+(R(j+1)-0.5)*8,w,yy+(R(j+2)-0.5)*6);g.stroke()}}},rep);
const floorT=plank('#5e4228',[3,3]),wallT=plank('#4e3420',[2,2]);wallT.rotation=Math.PI/2;
const tileT=ctex(512,512,(g,w,h)=>{g.fillStyle='#22262a';g.fillRect(0,0,w,h);for(let y=0;y<h;y+=32)for(let x=0;x<w;x+=40){g.fillStyle=`rgba(${R(x+y)>0.5?90:10},${R(x+y)>0.5?95:12},${R(x+y)>0.5?100:14},.35)`;g.beginPath();g.arc(x+20+((y/32)%2)*20,y+30,20,Math.PI,0);g.fill();g.strokeStyle='rgba(0,0,0,.6)';g.stroke()}},[4,2]);
const stoneT=ctex(512,512,(g,w,h)=>{g.fillStyle='#4a4840';g.fillRect(0,0,w,h);for(let k=0;k<140;k++){g.fillStyle=`rgba(${R(k)>0.5?120:20},${R(k)>0.5?116:20},${R(k)>0.5?106:18},.45)`;g.beginPath();g.ellipse(R(k*3)*w,R(k*7)*h,20+R(k)*30,14+R(k+1)*16,R(k)*3,0,7);g.fill();g.strokeStyle='rgba(0,0,0,.4)';g.stroke()}},[1,10]);
const dustTex=ctex(64,64,(g)=>{const gr=g.createRadialGradient(32,32,0,32,32,32);gr.addColorStop(0,'rgba(255,255,255,1)');gr.addColorStop(1,'rgba(255,255,255,0)');g.fillStyle=gr;g.fillRect(0,0,64,64)});
const M=o=>new THREE.MeshStandardMaterial(Object.assign({roughness:0.9,metalness:0},o));
function box(w,h,d,m,x,y,z,par,cast=true){const b=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);b.position.set(x,y,z);b.castShadow=cast;b.receiveShadow=true;par.add(b);return b}
function card(h,draw,wide){const c=document.createElement('canvas');c.width=wide?1024:512;c.height=1024;const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;
 const mat=new THREE.MeshStandardMaterial({map:t,transparent:true,alphaTest:0.4,side:THREE.DoubleSide,roughness:1});const m=new THREE.Mesh(new THREE.PlaneGeometry(wide?h:h*0.5,h),mat);m.castShadow=true;
 m.customDepthMaterial=new THREE.MeshDepthMaterial({depthPacking:THREE.RGBADepthPacking,map:t,alphaTest:0.4});
 m.userData.paint=(T)=>{const old=ctx;ctx=c.getContext('2d');ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,c.width,1024);if(wide)ctx.translate(256,0);draw(T,m.userData.o);ctx=old;t.needsUpdate=true};m.userData.o={};return m}
function imgTex(u){const im=new Image();im.src=u;const t=new THREE.Texture(im);t.colorSpace=THREE.SRGBColorSpace;im.onload=()=>{t.needsUpdate=true};IMGS.push(im.decode());return t}
const IMGS=[];
function cardTex(w,h,fn){const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');const old=ctx;ctx=g;fn(g);ctx=old;const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t}
function flatCard(tex,w,h,x,y,z,par,ry){const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshStandardMaterial({map:tex,transparent:true,alphaTest:0.3,side:THREE.DoubleSide}));m.position.set(x,y,z);m.rotation.y=ry||0;m.castShadow=true;m.customDepthMaterial=new THREE.MeshDepthMaterial({depthPacking:THREE.RGBADepthPacking,map:tex,alphaTest:0.3});par.add(m);return m}
function lantern(par,x,y,z,col=0xd8201c){const g=new THREE.Group();g.position.set(x,y,z);par.add(g);const b=new THREE.Mesh(new THREE.SphereGeometry(0.26,18,14),new THREE.MeshStandardMaterial({color:col,emissive:col,emissiveIntensity:1.6,roughness:0.6}));b.scale.y=1.2;g.add(b);
 for(const yy of [0.3,-0.3]){const r=new THREE.Mesh(new THREE.CylinderGeometry(0.12,0.12,0.06,12),M({color:0x2a1a0a}));r.position.y=yy;g.add(r)}const tas=new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.04,0.3,6),M({color:0xc9a227}));tas.position.y=-0.48;g.add(tas);
 const L=new THREE.PointLight(0xff5a30,5,7,1.6);g.add(L);g.userData.L=L;return g}
